<!--
    Шкала отступов темы «Arxis».

    Отступы контролов заводились порознь — 12×6 у кнопки, 9 у поля, 6×2 у
    списка, — и отсюда разброс: один и тот же смысловой зазор был написан
    шестёркой в дереве, семёркой в поле ввода и восьмёркой в списке. Шкала
    здесь — решение, и объявляется она решением.

    Шаг 4, и две половины, которые уже в ходу: 2 на волосяной зазор и 6 на
    расстояние от иконки до её подписи. Выше двенадцати половин нет: выбор
    между 16 и 20 — это уже не зазор, а вёрстка, и делать его должен тот, кто
    видит экран целиком.

    Отступ внутрь контрола — не отсюда. Кнопка, поле и выпадающий список
    отступают внутрь себя своими числами: AxButtonPadding,
    AxTextFieldPadding, AxComboBoxPadding объявлены в Metrics.axaml и на шкалу
    не садятся — 9 и 14 это числа компонента, а не системы. Шкала мерит
    расстояние между вещами, а не воздух внутри одной. Тем же разделением
    объясняется, почему десятки в шкале нет, хотя в разметке она вторая по
    частоте: все её вхождения — отступы внутрь контрола.

    Две формы, как у контура фокуса: x:Double для Spacing= и Thickness для
    Margin= и Padding=. Thickness здесь всегда равносторонний. Направленный
    зазор — 0,0,8,0 у иконки перед текстом — равносторонним не выражается, а
    заводить восемь ступеней в четырёх направлениях значит получить тридцать
    два ключа, из которых нужны шесть. Сторона решается там, где зазор стоит.

    Псевдонимы в конце — только Double: они называют величину зазора, а не его
    стороны, и ссылаются на ступень, а не повторяют её число.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Волосяной зазор: подпись под полем, иконка в строке, точки списка. -->
  <x:Double x:Key="AxSpaceHair">2</x:Double>
  <Thickness x:Key="AxSpaceHairThickness">2</Thickness>

  <!-- Ступень шкалы. -->
  <x:Double x:Key="AxSpaceTight">4</x:Double>
  <Thickness x:Key="AxSpaceTightThickness">4</Thickness>

  <!-- Половина ступени: иконка и её подпись стоят ближе, чем два контрола. -->
  <x:Double x:Key="AxSpaceSnug">6</x:Double>
  <Thickness x:Key="AxSpaceSnugThickness">6</Thickness>

  <!-- Основная ступень: зазор между соседями по строке. -->
  <x:Double x:Key="AxSpace">8</x:Double>
  <Thickness x:Key="AxSpaceThickness">8</Thickness>

  <!-- Ступень шкалы: строки формы, поля карточки. -->
  <x:Double x:Key="AxSpaceWide">12</x:Double>
  <Thickness x:Key="AxSpaceWideThickness">12</Thickness>

  <!-- Ступень шкалы: группы внутри одной панели. -->
  <x:Double x:Key="AxSpaceLoose">16</x:Double>
  <Thickness x:Key="AxSpaceLooseThickness">16</Thickness>

  <!-- Раздел от раздела. -->
  <x:Double x:Key="AxSpaceSection">24</x:Double>
  <Thickness x:Key="AxSpaceSectionThickness">24</Thickness>

  <!-- Поля экрана: Welcome, настройки, диалог во всю высоту. -->
  <x:Double x:Key="AxSpaceScreen">40</x:Double>
  <Thickness x:Key="AxSpaceScreenThickness">40</Thickness>

  <!--
      Направленные зазоры: сторона в имени, ступень в значении. Заводятся по
      требованию точки вызова, а не заранее: восемь ступеней в четырёх
      направлениях дали бы тридцать два ключа, из которых нужны единицы.
      Нужны они там, где промежуток некому держать, — DockPanel и Grid его не
      знают, и зазор приходится вешать полем на соседа.
  -->
  <Thickness x:Key="AxSpaceSnugTrailingThickness">0,0,6,0</Thickness>
  <Thickness x:Key="AxSpaceLeadingThickness">8,0,0,0</Thickness>
  <Thickness x:Key="AxSpaceTightAboveThickness">0,4,0,0</Thickness>
  <Thickness x:Key="AxSpaceWideLeadingThickness">12,0,0,0</Thickness>
  <Thickness x:Key="AxSpaceWideTrailingThickness">0,0,12,0</Thickness>
  <Thickness x:Key="AxSpaceTightSidesThickness">4,0</Thickness>
  <Thickness x:Key="AxSpaceWideSidesThickness">12,0</Thickness>
  <Thickness x:Key="AxSpaceHairSidesThickness">2,0</Thickness>
  <Thickness x:Key="AxSpaceSnugLeadingThickness">6,0,0,0</Thickness>
  <Thickness x:Key="AxSpaceTrailingThickness">0,0,8,0</Thickness>
  <Thickness x:Key="AxSpaceSidesThickness">8,0</Thickness>
  <Thickness x:Key="AxSpaceLooseSidesThickness">16,0</Thickness>
  <!--
      Sides — по горизонтали, Ends — по вертикали. Пара всегда симметрична:
      несимметричное — это отступ поверхности, и ему полагается имя в
      Metrics.axaml, а не ступень здесь.
  -->
  <Thickness x:Key="AxSpaceEndsThickness">0,8</Thickness>
  <Thickness x:Key="AxSpaceHairAboveThickness">0,2,0,0</Thickness>
  <Thickness x:Key="AxSpaceLooseAboveThickness">0,16,0,0</Thickness>
  <Thickness x:Key="AxSpaceSectionAboveThickness">0,24,0,0</Thickness>
  <Thickness x:Key="AxSpaceWideBelowThickness">0,0,0,12</Thickness>
  <Thickness x:Key="AxSpaceAboveThickness">0,8,0,0</Thickness>
  <Thickness x:Key="AxSpaceWideAboveThickness">0,12,0,0</Thickness>

  <!--
      Смысловые имена ступеней. Они и есть то, ради чего заведена шкала:
      число выбирают заново каждый раз, а названный зазор берут готовым — и
      шестёрка в дереве, семёрка в поле и восьмёрка в списке перестают быть
      тремя мнениями об одном расстоянии.
  -->
  <StaticResource x:Key="AxGapIconText" ResourceKey="AxSpaceSnug"/>
  <StaticResource x:Key="AxGapControls" ResourceKey="AxSpace"/>
  <StaticResource x:Key="AxGapFormRow" ResourceKey="AxSpaceWide"/>
  <StaticResource x:Key="AxGapGroup" ResourceKey="AxSpaceLoose"/>
  <StaticResource x:Key="AxGapIconTextThickness" ResourceKey="AxSpaceSnugTrailingThickness"/>

</ResourceDictionary>
