<!--
    Тема «Arxis». В M0 подключается поверх FluentTheme — базового слоя для
    не-Ax примитивов (окно, попапы, тултипы):

        <Application.Styles>
            <FluentTheme/>
            <themes:ArxisTheme/>
        </Application.Styles>
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ax="https://github.com/Arxis-Team/ArxisStudio"
        x:Class="ArxisStudio.Themes.Arxis.ArxisTheme">

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://ArxisStudio.Themes.Arxis/Palette.axaml"/>
        <ResourceInclude Source="avares://ArxisStudio.Themes.Arxis/Typography.axaml"/>
        <ResourceInclude Source="avares://ArxisStudio.Themes.Arxis/Metrics.axaml"/>
        <ResourceInclude Source="avares://ArxisStudio.Themes.Arxis/Spacing.axaml"/>
        <ResourceInclude Source="avares://ArxisStudio.Themes.Arxis/Strings.axaml"/>
        <ResourceInclude Source="avares://ArxisStudio.Themes.Arxis/ControlThemes/AxButton.axaml"/>
        <ResourceInclude Source="avares://ArxisStudio.Themes.Arxis/ControlThemes/AxTextBox.axaml"/>
        <ResourceInclude Source="avares://ArxisStudio.Themes.Arxis/ControlThemes/AxCheckBox.axaml"/>
        <ResourceInclude Source="avares://ArxisStudio.Themes.Arxis/ControlThemes/AxToggleSwitch.axaml"/>
        <ResourceInclude Source="avares://ArxisStudio.Themes.Arxis/ControlThemes/AxComboBox.axaml"/>
        <ResourceInclude Source="avares://ArxisStudio.Themes.Arxis/ControlThemes/AxListBox.axaml"/>
        <ResourceInclude Source="avares://ArxisStudio.Themes.Arxis/ControlThemes/AxSegmentedControl.axaml"/>
        <ResourceInclude Source="avares://ArxisStudio.Themes.Arxis/ControlThemes/AxAvatar.axaml"/>
        <ResourceInclude Source="avares://ArxisStudio.Themes.Arxis/ControlThemes/AxPrimitives.axaml"/>
        <ResourceInclude Source="avares://ArxisStudio.Themes.Arxis/ControlThemes/AxLink.axaml"/>
        <ResourceInclude Source="avares://ArxisStudio.Themes.Arxis/ControlThemes/AxSelection.axaml"/>
        <ResourceInclude Source="avares://ArxisStudio.Themes.Arxis/ControlThemes/AxBanner.axaml"/>
        <ResourceInclude Source="avares://ArxisStudio.Themes.Arxis/ControlThemes/AxTabStrip.axaml"/>
        <ResourceInclude Source="avares://ArxisStudio.Themes.Arxis/ControlThemes/AxToolWindow.axaml"/>
        <ResourceInclude Source="avares://ArxisStudio.Themes.Arxis/ControlThemes/AxTitleBar.axaml"/>
        <ResourceInclude Source="avares://ArxisStudio.Themes.Arxis/ControlThemes/AxTreeView.axaml"/>
        <ResourceInclude Source="avares://ArxisStudio.Themes.Arxis/ControlThemes/AxSplitButton.axaml"/>
        <ResourceInclude Source="avares://ArxisStudio.Themes.Arxis/ControlThemes/AxDropDownButton.axaml"/>
        <ResourceInclude Source="avares://ArxisStudio.Themes.Arxis/ControlThemes/AxMenu.axaml"/>
        <ResourceInclude Source="avares://ArxisStudio.Themes.Arxis/ControlThemes/AxOverlays.axaml"/>
        <ResourceInclude Source="avares://ArxisStudio.Themes.Arxis/ControlThemes/AxDialog.axaml"/>
        <ResourceInclude Source="avares://ArxisStudio.Themes.Arxis/ControlThemes/AxToolbox.axaml"/>
        <ResourceInclude Source="avares://ArxisStudio.Themes.Arxis/ControlThemes/ScrollBar.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- База окна: фон, цвет текста и типографика студии наследуются всем содержимым. -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource AxSurfaceBaseBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AxTextPrimaryBrush}"/>
    <Setter Property="FontFamily" Value="{DynamicResource AxFontFamily}"/>
    <Setter Property="FontSize" Value="{DynamicResource AxFontSize}"/>
  </Style>

  <!-- Тултип не выскакивает под руку: задержка показа 600 мс. -->
  <Style Selector=":is(Control)">
    <Setter Property="(ToolTip.ShowDelay)" Value="600"/>
  </Style>

  <!--
      Ссылка на залитой плашке берёт AxLinkOnPlate, и это правило: AxLink на
      AxSelectionActive даёт 4,32:1 в тёмной теме, и порог на плашке держит только
      шаг, заведённый для плашек. Баннер — плашка, поэтому действие в нём светится
      этим токеном, а не обычным цветом ссылки.
  -->
  <!--
      Выделение в списке и дереве говорит и о фокусе: AxSelectionActive, пока фокус внутри,
      AxSelectionInactive, когда он ушёл, — строка остаётся отмеченной, но не спорит
      за внимание с тем полем, куда человек перешёл. Погашенный цвет объявлен
      в темах строк, полный — здесь.

      Стиль стоит в общих стилях, а не в теме строки: предок в селекторе теме
      контрола не виден, и строка, однажды загоревшись, уже не гасла.

      Строка названа своим типом, а не «всякий наследник ListBoxItem». Так
      было, и правило доставало до всего, что построено на списке: у
      сегментного переключателя выбранный сегмент под фокусом терял акцентную
      заливку и красился цветом выделения строки — ровно после щелчка по нему,
      хотя выбранный сегмент залит акцентом, и в покое так и было.
      Вкладку спасало только то, что часть в её шаблоне названа иначе.
  -->
  <Style Selector=":is(ListBox):focus-within ax|AxListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AxSelectionActiveBrush}"/>
  </Style>
  <Style Selector=":is(TreeView):focus-within :is(TreeViewItem):selected /template/ Border#PART_Root">
    <Setter Property="Background" Value="{DynamicResource AxSelectionActiveBrush}"/>
  </Style>

  <Style Selector="ax|AxBanner ax|AxLink">
    <Setter Property="Foreground" Value="{DynamicResource AxLinkOnPlateBrush}"/>
  </Style>

  <!--
      Отбивка ячейки таблицы. Стоит на ячейке, а не на строке: у строки она
      отодвинула бы только первую колонку, а остальные начинались бы вплотную
      к своей границе.
  -->
  <!--
      Глиф иконочной кнопки идёт за её состоянием.

      Своим цветом AxIcon задаётся в собственной теме, а тема сильнее
      наследования, — поэтому Foreground кнопки до глифа не доходил, и в
      тулбаре он оставался серым во всех пяти состояниях. Стиль сильнее темы
      контрола, и эти правила ставят цвет глифа: наведение и нажатие —
      основной текст, включённость — акцент, выключенность — цвет выключенного.

      Свой цвет, проставленный на месте, сильнее стиля и переживает всё это:
      зелёный треугольник запуска остаётся зелёным.
  -->
  <Style Selector="ax|AxButton:toolbar:pointerover ax|AxIcon, ax|AxToggleButton:toolbar:pointerover ax|AxIcon">
    <Setter Property="Foreground" Value="{DynamicResource AxTextPrimaryBrush}"/>
  </Style>
  <Style Selector="ax|AxButton:toolbar:pressed ax|AxIcon, ax|AxToggleButton:toolbar:pressed ax|AxIcon">
    <Setter Property="Foreground" Value="{DynamicResource AxTextPrimaryBrush}"/>
  </Style>
  <Style Selector="ax|AxToggleButton:toolbar:checked ax|AxIcon">
    <Setter Property="Foreground" Value="{DynamicResource AxAccentBrush}"/>
  </Style>
  <Style Selector="ax|AxButton:toolbar:disabled ax|AxIcon, ax|AxToggleButton:toolbar:disabled ax|AxIcon">
    <Setter Property="Foreground" Value="{DynamicResource AxTextDisabledBrush}"/>
  </Style>

  <Style Selector="ax|AxDataGrid TextBlock">
    <Setter Property="Padding" Value="{DynamicResource AxDataGridCellPadding}"/>
  </Style>

  <!--
      Роли текста — AxText.Role. Кегль — такое же значение темы, как цвет, и в
      панели ему не место числом: панель говорит, что это мелкий текст или
      подпись, а сколько это в пунктах — решает типографика. Code — код, пути и
      значения моноширинным шрифтом.
  -->
  <Style Selector="TextBlock:role-small">
    <Setter Property="FontSize" Value="{DynamicResource AxFontSizeSmall}"/>
  </Style>
  <Style Selector="TextBlock:role-caption">
    <Setter Property="FontSize" Value="{DynamicResource AxFontSizeCaption}"/>
  </Style>
  <Style Selector="TextBlock:role-title">
    <Setter Property="FontSize" Value="{DynamicResource AxFontSizeTitle}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="TextBlock:role-code">
    <Setter Property="FontFamily" Value="{DynamicResource AxFontFamilyMono}"/>
  </Style>
  <!--
      Заголовок секции: мелкий кегль с разрядкой, как «Недавние» на экране
      Welcome, и второстепенным цветом — пока тон не назван явно.
  -->
  <Style Selector="TextBlock:role-section">
    <Setter Property="FontSize" Value="{DynamicResource AxFontSizeSmall}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource AxTextSecondaryBrush}"/>
    <Setter Property="LetterSpacing" Value="0.6"/>
  </Style>

  <!--
      Тоны текста — AxText.Tone. Стоят после ролей: названный тон сильнее цвета,
      который принесла роль.

      Смысловой ТЕКСТ идёт цветами *Text: AxSuccess/AxError/AxWarning рассчитаны на
      заливки и иконки, и в светлой теме на панели не добирают 4,5:1 (AxWarning —
      3,45:1). Акцентный текст — цветом ссылки: он подобран под текст, а AxAccent —
      под графику.
  -->
  <Style Selector="TextBlock:tone-secondary">
    <Setter Property="Foreground" Value="{DynamicResource AxTextSecondaryBrush}"/>
  </Style>
  <Style Selector="TextBlock:tone-tertiary">
    <Setter Property="Foreground" Value="{DynamicResource AxTextTertiaryBrush}"/>
  </Style>
  <Style Selector="TextBlock:tone-disabled">
    <Setter Property="Foreground" Value="{DynamicResource AxTextDisabledBrush}"/>
  </Style>
  <Style Selector="TextBlock:tone-accent">
    <Setter Property="Foreground" Value="{DynamicResource AxLinkBrush}"/>
  </Style>
  <Style Selector="TextBlock:tone-success">
    <Setter Property="Foreground" Value="{DynamicResource AxSuccessTextBrush}"/>
  </Style>
  <Style Selector="TextBlock:tone-warning">
    <Setter Property="Foreground" Value="{DynamicResource AxWarningTextBrush}"/>
  </Style>
  <Style Selector="TextBlock:tone-error">
    <Setter Property="Foreground" Value="{DynamicResource AxErrorTextBrush}"/>
  </Style>

  <!--
      Межстрочный интервал получает тот текст, который переносится: у абзаца есть
      вторая строка, и расстояние между ними — часть набора. Однострочной подписи
      интервал не нужен и вреден: второй строки у неё нет, а высота строки поднимет
      её ряд.

      Отбор по самому свойству, а не по роли: многострочным текст делает перенос, а
      не кегль, и роль у абзаца та же, что у подписи рядом.
  -->
  <Style Selector=":is(TextBlock)[TextWrapping=Wrap], :is(TextBlock)[TextWrapping=WrapWithOverflow]">
    <Setter Property="ax:AxText.LineHeightRatio" Value="{DynamicResource AxLineHeightRatio}"/>
  </Style>

</Styles>
