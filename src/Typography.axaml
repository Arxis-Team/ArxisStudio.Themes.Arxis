<!--
    Типографика темы: Inter для UI (регистрируется приложением через WithInterFont),
    Cascadia Code для кода, путей и значений — шрифт едет отдельной библиотекой
    ArxisStudio.Fonts.Cascadia (SIL OFL 1.1), поэтому первым в стеке стоит вложенный,
    а системные — запасными.
    База — 13px.

    Один файл вместо четырёх: Cascadia Code переменный, ось веса 200…700. Теме
    хватает: жирного моноширинного текста в ней нет, единственное отступление от
    обычного веса — чип шортката на Medium, и он внутри оси.

    Выбор Cascadia Code принят владельцем: OFL 1.1, кириллица, программные
    лигатуры. Вторым в стеке остаётся Cascadia Mono — та же метрика без лигатур.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <FontFamily x:Key="AxFontFamily">fonts:Inter#Inter</FontFamily>
  <FontFamily x:Key="AxFontFamilyMono">fonts:Cascadia#Cascadia Code,Cascadia Mono,Consolas,Courier New</FontFamily>

  <!--
      Кегли целые: база 13, мелкий 12, подпись 11, заголовок 15, крупный 20.
      Половинок больше нет — 11.5 и 10.5 давали полпикселя при 125 % и 175 % и
      отличались друг от друга на глаз меньше, чем на замер. Заголовок стоит на
      экране (Settings, Learn, Plugins) и в шапке диалога; крупный — там, где
      текст сам себе экран: пустое место документа.

      Заведены здесь, чтобы их не писали числом на месте.
  -->
  <x:Double x:Key="AxFontSize">13</x:Double>
  <x:Double x:Key="AxFontSizeSmall">12</x:Double>
  <x:Double x:Key="AxFontSizeCaption">11</x:Double>
  <x:Double x:Key="AxFontSizeTitle">15</x:Double>
  <x:Double x:Key="AxFontSizeLarge">20</x:Double>
  <!--
      Кегль вордмарка на заставке — единственное место, где текст крупнее
      заголовка экрана. Двадцать шесть стояли числом в разметке заставки и были
      единственным литеральным кеглем во всём репозитории; теперь её кегль
      объявлен рядом с остальными.
  -->
  <x:Double x:Key="AxFontSizeDisplay">26</x:Double>

  <!--
      Высота строки абзаца — доля кегля, как у блока кода. Полтора интервала
      слишком просторны для короткого абзаца в панели, метрики самого шрифта
      (около 1,21) — слишком тесны для двух строк подряд; 1,4 читается и не рвёт
      строку от строки.

      Долей, а не числом: пиксельная высота строки не выросла бы вместе с
      настройкой размера текста — буквы стали бы больше, а строки остались бы
      прежними и наехали друг на друга.
  -->
  <x:Double x:Key="AxLineHeightRatio">1.4</x:Double>

</ResourceDictionary>
