<!--
    Типографика темы: Inter для UI (регистрируется приложением через WithInterFont),
    JetBrains Mono с системными fallback для кода, путей и значений. База — 13px.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <FontFamily x:Key="AxFontFamily">fonts:Inter#Inter</FontFamily>
  <FontFamily x:Key="AxFontFamilyMono">JetBrains Mono,Cascadia Mono,Consolas,Courier New</FontFamily>

  <x:Double x:Key="AxFontSize">13</x:Double>
  <x:Double x:Key="AxFontSizeSmall">11.5</x:Double>
  <x:Double x:Key="AxFontSizeCaption">10.5</x:Double>

</ResourceDictionary>
