  </ResourceDictionary.ThemeDictionaries>

  <!-- Кисти поверх токенов: DynamicResource переключает их вместе с вариантом темы. -->
  <SolidColorBrush x:Key="AxBg1Brush" Color="{DynamicResource AxBg1Color}"/>
  <SolidColorBrush x:Key="AxBg2Brush" Color="{DynamicResource AxBg2Color}"/>
  <SolidColorBrush x:Key="AxBg3Brush" Color="{DynamicResource AxBg3Color}"/>
  <SolidColorBrush x:Key="AxBg4Brush" Color="{DynamicResource AxBg4Color}"/>
  <SolidColorBrush x:Key="AxBrdBrush" Color="{DynamicResource AxBrdColor}"/>
  <SolidColorBrush x:Key="AxBrd2Brush" Color="{DynamicResource AxBrd2Color}"/>
  <SolidColorBrush x:Key="AxFgBrush" Color="{DynamicResource AxFgColor}"/>
  <SolidColorBrush x:Key="AxFg2Brush" Color="{DynamicResource AxFg2Color}"/>
  <SolidColorBrush x:Key="AxFg3Brush" Color="{DynamicResource AxFg3Color}"/>
  <SolidColorBrush x:Key="AxFgDisabledBrush" Color="{DynamicResource AxFgDisabledColor}"/>
  <SolidColorBrush x:Key="AxAccBrush" Color="{DynamicResource AxAccColor}"/>
  <SolidColorBrush x:Key="AxAccHoverBrush" Color="{DynamicResource AxAccHoverColor}"/>
  <SolidColorBrush x:Key="AxAccPressedBrush" Color="{DynamicResource AxAccPressedColor}"/>
  <SolidColorBrush x:Key="AxOnAccBrush" Color="{DynamicResource AxOnAccColor}"/>
  <SolidColorBrush x:Key="AxSelBrush" Color="{DynamicResource AxSelColor}"/>
  <SolidColorBrush x:Key="AxSelInactiveBrush" Color="{DynamicResource AxSelInactiveColor}"/>
  <SolidColorBrush x:Key="AxCanvasBrush" Color="{DynamicResource AxCanvasColor}"/>
  <SolidColorBrush x:Key="AxDotBrush" Color="{DynamicResource AxDotColor}"/>
  <SolidColorBrush x:Key="AxInpBrush" Color="{DynamicResource AxInpColor}"/>
  <SolidColorBrush x:Key="AxInpDisabledBrush" Color="{DynamicResource AxInpDisabledColor}"/>
  <SolidColorBrush x:Key="AxGrnBrush" Color="{DynamicResource AxGrnColor}"/>
  <SolidColorBrush x:Key="AxRedBrush" Color="{DynamicResource AxRedColor}"/>
  <SolidColorBrush x:Key="AxYelBrush" Color="{DynamicResource AxYelColor}"/>
  <SolidColorBrush x:Key="AxOrgBrush" Color="{DynamicResource AxOrgColor}"/>
  <SolidColorBrush x:Key="AxPurBrush" Color="{DynamicResource AxPurColor}"/>
  <SolidColorBrush x:Key="AxLinkBrush" Color="{DynamicResource AxLinkColor}"/>
  <SolidColorBrush x:Key="AxLinkHoverBrush" Color="{DynamicResource AxLinkHoverColor}"/>
  <SolidColorBrush x:Key="AxLinkVisitedBrush" Color="{DynamicResource AxLinkVisitedColor}"/>
  <SolidColorBrush x:Key="AxOutlineFocusedBrush" Color="{DynamicResource AxOutlineFocusedColor}"/>
  <SolidColorBrush x:Key="AxOutlineErrorBrush" Color="{DynamicResource AxOutlineErrorColor}"/>
  <SolidColorBrush x:Key="AxOutlineWarningBrush" Color="{DynamicResource AxOutlineWarningColor}"/>
  <SolidColorBrush x:Key="AxInfoBackgroundBrush" Color="{DynamicResource AxInfoBackgroundColor}"/>
  <SolidColorBrush x:Key="AxSuccessBackgroundBrush" Color="{DynamicResource AxSuccessBackgroundColor}"/>
  <SolidColorBrush x:Key="AxWarningBackgroundBrush" Color="{DynamicResource AxWarningBackgroundColor}"/>
  <SolidColorBrush x:Key="AxErrorBackgroundBrush" Color="{DynamicResource AxErrorBackgroundColor}"/>
  <SolidColorBrush x:Key="AxShadowBrush" Color="{DynamicResource AxShadowColor}"/>
  <SolidColorBrush x:Key="AxAbShadowBrush" Color="{DynamicResource AxAbShadowColor}"/>

</ResourceDictionary>
