<!--
    Палитра темы «Arxis»: роли, а не ступени шкал. Роль — пара Color и Brush в
    словаре каждого варианта; что за роль и какие пороги контраста она держит,
    записано в docs/design-system.md студии, а пороги проверяют тесты темы.

    Цвет роли записан числом, а не ссылкой на ступень: анализатор SDK читает
    ровно такие пары и по ним называет расширению кисть вместо числа.

    Кисти объявлены внутри словаря варианта, а не общим списком: общая кисть
    разрешала бы свой Color на уровне приложения, и ThemeVariantScope (светлая
    и тёмная половины галереи, предпросмотр плагина) не мог бы её переокрасить.
    Шаблоны берут кисти через DynamicResource, поэтому вариант меняется и у
    живого окна.

    Тени: BoxShadows не собирается из кисти ресурсом, поэтому цвет тени записан
    прямо в ней.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Dark">
      <!-- Поверхности: утопленная, основная (документ и поле), панель, приподнятая и всплывающая. -->
      <Color x:Key="AxSurfaceSunkenColor">#1E1F22</Color>
      <Color x:Key="AxSurfaceBaseColor">#1E1F22</Color>
      <Color x:Key="AxSurfacePanelColor">#2B2D30</Color>
      <Color x:Key="AxSurfaceRaisedColor">#393B40</Color>
      <Color x:Key="AxSurfaceOverlayColor">#2B2D30</Color>

      <!-- Взаимодействие: наведение, нажатие, дорожка и заливка выключенного. -->
      <Color x:Key="AxHoverColor">#393B40</Color>
      <Color x:Key="AxPressedColor">#43454A</Color>
      <Color x:Key="AxTrackColor">#43454A</Color>
      <Color x:Key="AxFillDisabledColor">#2B2D30</Color>

      <!-- Линии: разделитель, граница контрола и разделитель, который читается сильнее обычного. -->
      <Color x:Key="AxStrokeSubtleColor">#393B40</Color>
      <Color x:Key="AxStrokeControlColor">#4E5157</Color>
      <Color x:Key="AxStrokeStrongColor">#43454A</Color>

      <!-- Текст: четыре уровня и текст на акцентной заливке. -->
      <Color x:Key="AxTextPrimaryColor">#DFE1E5</Color>
      <Color x:Key="AxTextSecondaryColor">#B4B8BF</Color>
      <Color x:Key="AxTextTertiaryColor">#9DA0A8</Color>
      <Color x:Key="AxTextDisabledColor">#6F737A</Color>
      <Color x:Key="AxTextOnAccentColor">#FFFFFF</Color>

      <!-- Акцент: графика, заливка основного действия и кольцо фокуса. -->
      <Color x:Key="AxAccentColor">#3574F0</Color>
      <Color x:Key="AxAccentHoverColor">#467FF2</Color>
      <Color x:Key="AxAccentFillColor">#3369D6</Color>
      <Color x:Key="AxAccentFillHoverColor">#315FBD</Color>
      <Color x:Key="AxAccentFillPressedColor">#366ACE</Color>
      <Color x:Key="AxFocusRingColor">#3574F0</Color>

      <!-- Выделение: пока клавиатура внутри области и когда она ушла. -->
      <Color x:Key="AxSelectionActiveColor">#2E436E</Color>
      <Color x:Key="AxSelectionInactiveColor">#393B40</Color>

      <!-- Ссылки; на залитой плашке ссылка берёт свой шаг. -->
      <Color x:Key="AxLinkColor">#548AF7</Color>
      <Color x:Key="AxLinkHoverColor">#6B9BFA</Color>
      <Color x:Key="AxLinkPressedColor">#366ACE</Color>
      <Color x:Key="AxLinkVisitedColor">#B589EC</Color>
      <Color x:Key="AxLinkOnPlateColor">#6B9BFA</Color>

      <!-- Состояния: графика, текст, контур поля, заливка и рамка сообщения. -->
      <Color x:Key="AxErrorColor">#DB5C5C</Color>
      <Color x:Key="AxWarningColor">#D6AE58</Color>
      <Color x:Key="AxSuccessColor">#5FAD65</Color>
      <Color x:Key="AxErrorTextColor">#EB938D</Color>
      <Color x:Key="AxWarningTextColor">#D6AE58</Color>
      <Color x:Key="AxSuccessTextColor">#5FAD65</Color>
      <Color x:Key="AxErrorOutlineColor">#DB5C5C</Color>
      <Color x:Key="AxWarningOutlineColor">#D6AE58</Color>
      <Color x:Key="AxInfoFillColor">#25324D</Color>
      <Color x:Key="AxSuccessFillColor">#253627</Color>
      <Color x:Key="AxWarningFillColor">#3D3223</Color>
      <Color x:Key="AxErrorFillColor">#402929</Color>
      <Color x:Key="AxInfoStrokeColor">#35538F</Color>
      <Color x:Key="AxSuccessStrokeColor">#436946</Color>
      <Color x:Key="AxWarningStrokeColor">#9E814A</Color>
      <Color x:Key="AxErrorStrokeColor">#7A4343</Color>

      <!-- Оттенки значков типов и плитки монограмм: белые инициалы держат на них 5,9:1 и выше. -->
      <Color x:Key="AxTintOrangeColor">#E08855</Color>
      <Color x:Key="AxTintPurpleColor">#A571E6</Color>
      <Color x:Key="AxMonogramOrangeColor">#A14916</Color>
      <Color x:Key="AxMonogramGreenColor">#1E6B33</Color>
      <Color x:Key="AxMonogramPurpleColor">#55339C</Color>
      <Color x:Key="AxMonogramRedColor">#AD2B38</Color>

      <!-- Подсказка и ползунок прокрутки: полупрозрачная накладка поверх содержимого. -->
      <Color x:Key="AxToolTipFillColor">#393B40</Color>
      <Color x:Key="AxToolTipStrokeColor">#4E5157</Color>
      <Color x:Key="AxScrollThumbColor">#33FFFFFF</Color>
      <Color x:Key="AxScrollThumbHoverColor">#59FFFFFF</Color>

      <!-- Подсветка кода. -->
      <Color x:Key="AxCodeTextColor">#BCBEC4</Color>
      <Color x:Key="AxCodeTagColor">#E8BF6A</Color>
      <Color x:Key="AxCodeAttributeColor">#BCBEC4</Color>
      <Color x:Key="AxCodeStringColor">#6AAB73</Color>
      <Color x:Key="AxCodeCommentColor">#7A7E85</Color>

      <!-- Тени всплывающего окна и модального диалога. -->
      <BoxShadows x:Key="AxShadowPopup">0 4 16 0 #73000000</BoxShadows>
      <BoxShadows x:Key="AxShadowModal">0 8 40 0 #8C000000</BoxShadows>

      <!-- Кисти ролей. -->
      <SolidColorBrush x:Key="AxSurfaceSunkenBrush" Color="{StaticResource AxSurfaceSunkenColor}"/>
      <SolidColorBrush x:Key="AxSurfaceBaseBrush" Color="{StaticResource AxSurfaceBaseColor}"/>
      <SolidColorBrush x:Key="AxSurfacePanelBrush" Color="{StaticResource AxSurfacePanelColor}"/>
      <SolidColorBrush x:Key="AxSurfaceRaisedBrush" Color="{StaticResource AxSurfaceRaisedColor}"/>
      <SolidColorBrush x:Key="AxSurfaceOverlayBrush" Color="{StaticResource AxSurfaceOverlayColor}"/>
      <SolidColorBrush x:Key="AxHoverBrush" Color="{StaticResource AxHoverColor}"/>
      <SolidColorBrush x:Key="AxPressedBrush" Color="{StaticResource AxPressedColor}"/>
      <SolidColorBrush x:Key="AxTrackBrush" Color="{StaticResource AxTrackColor}"/>
      <SolidColorBrush x:Key="AxFillDisabledBrush" Color="{StaticResource AxFillDisabledColor}"/>
      <SolidColorBrush x:Key="AxStrokeSubtleBrush" Color="{StaticResource AxStrokeSubtleColor}"/>
      <SolidColorBrush x:Key="AxStrokeControlBrush" Color="{StaticResource AxStrokeControlColor}"/>
      <SolidColorBrush x:Key="AxStrokeStrongBrush" Color="{StaticResource AxStrokeStrongColor}"/>
      <SolidColorBrush x:Key="AxTextPrimaryBrush" Color="{StaticResource AxTextPrimaryColor}"/>
      <SolidColorBrush x:Key="AxTextSecondaryBrush" Color="{StaticResource AxTextSecondaryColor}"/>
      <SolidColorBrush x:Key="AxTextTertiaryBrush" Color="{StaticResource AxTextTertiaryColor}"/>
      <SolidColorBrush x:Key="AxTextDisabledBrush" Color="{StaticResource AxTextDisabledColor}"/>
      <SolidColorBrush x:Key="AxTextOnAccentBrush" Color="{StaticResource AxTextOnAccentColor}"/>
      <SolidColorBrush x:Key="AxAccentBrush" Color="{StaticResource AxAccentColor}"/>
      <SolidColorBrush x:Key="AxAccentHoverBrush" Color="{StaticResource AxAccentHoverColor}"/>
      <SolidColorBrush x:Key="AxAccentFillBrush" Color="{StaticResource AxAccentFillColor}"/>
      <SolidColorBrush x:Key="AxAccentFillHoverBrush" Color="{StaticResource AxAccentFillHoverColor}"/>
      <SolidColorBrush x:Key="AxAccentFillPressedBrush" Color="{StaticResource AxAccentFillPressedColor}"/>
      <SolidColorBrush x:Key="AxFocusRingBrush" Color="{StaticResource AxFocusRingColor}"/>
      <SolidColorBrush x:Key="AxSelectionActiveBrush" Color="{StaticResource AxSelectionActiveColor}"/>
      <SolidColorBrush x:Key="AxSelectionInactiveBrush" Color="{StaticResource AxSelectionInactiveColor}"/>
      <SolidColorBrush x:Key="AxLinkBrush" Color="{StaticResource AxLinkColor}"/>
      <SolidColorBrush x:Key="AxLinkHoverBrush" Color="{StaticResource AxLinkHoverColor}"/>
      <SolidColorBrush x:Key="AxLinkPressedBrush" Color="{StaticResource AxLinkPressedColor}"/>
      <SolidColorBrush x:Key="AxLinkVisitedBrush" Color="{StaticResource AxLinkVisitedColor}"/>
      <SolidColorBrush x:Key="AxLinkOnPlateBrush" Color="{StaticResource AxLinkOnPlateColor}"/>
      <SolidColorBrush x:Key="AxErrorBrush" Color="{StaticResource AxErrorColor}"/>
      <SolidColorBrush x:Key="AxWarningBrush" Color="{StaticResource AxWarningColor}"/>
      <SolidColorBrush x:Key="AxSuccessBrush" Color="{StaticResource AxSuccessColor}"/>
      <SolidColorBrush x:Key="AxErrorTextBrush" Color="{StaticResource AxErrorTextColor}"/>
      <SolidColorBrush x:Key="AxWarningTextBrush" Color="{StaticResource AxWarningTextColor}"/>
      <SolidColorBrush x:Key="AxSuccessTextBrush" Color="{StaticResource AxSuccessTextColor}"/>
      <SolidColorBrush x:Key="AxErrorOutlineBrush" Color="{StaticResource AxErrorOutlineColor}"/>
      <SolidColorBrush x:Key="AxWarningOutlineBrush" Color="{StaticResource AxWarningOutlineColor}"/>
      <SolidColorBrush x:Key="AxInfoFillBrush" Color="{StaticResource AxInfoFillColor}"/>
      <SolidColorBrush x:Key="AxSuccessFillBrush" Color="{StaticResource AxSuccessFillColor}"/>
      <SolidColorBrush x:Key="AxWarningFillBrush" Color="{StaticResource AxWarningFillColor}"/>
      <SolidColorBrush x:Key="AxErrorFillBrush" Color="{StaticResource AxErrorFillColor}"/>
      <SolidColorBrush x:Key="AxInfoStrokeBrush" Color="{StaticResource AxInfoStrokeColor}"/>
      <SolidColorBrush x:Key="AxSuccessStrokeBrush" Color="{StaticResource AxSuccessStrokeColor}"/>
      <SolidColorBrush x:Key="AxWarningStrokeBrush" Color="{StaticResource AxWarningStrokeColor}"/>
      <SolidColorBrush x:Key="AxErrorStrokeBrush" Color="{StaticResource AxErrorStrokeColor}"/>
      <SolidColorBrush x:Key="AxTintOrangeBrush" Color="{StaticResource AxTintOrangeColor}"/>
      <SolidColorBrush x:Key="AxTintPurpleBrush" Color="{StaticResource AxTintPurpleColor}"/>
      <SolidColorBrush x:Key="AxMonogramOrangeBrush" Color="{StaticResource AxMonogramOrangeColor}"/>
      <SolidColorBrush x:Key="AxMonogramGreenBrush" Color="{StaticResource AxMonogramGreenColor}"/>
      <SolidColorBrush x:Key="AxMonogramPurpleBrush" Color="{StaticResource AxMonogramPurpleColor}"/>
      <SolidColorBrush x:Key="AxMonogramRedBrush" Color="{StaticResource AxMonogramRedColor}"/>
      <SolidColorBrush x:Key="AxToolTipFillBrush" Color="{StaticResource AxToolTipFillColor}"/>
      <SolidColorBrush x:Key="AxToolTipStrokeBrush" Color="{StaticResource AxToolTipStrokeColor}"/>
      <SolidColorBrush x:Key="AxScrollThumbBrush" Color="{StaticResource AxScrollThumbColor}"/>
      <SolidColorBrush x:Key="AxScrollThumbHoverBrush" Color="{StaticResource AxScrollThumbHoverColor}"/>
      <SolidColorBrush x:Key="AxCodeTextBrush" Color="{StaticResource AxCodeTextColor}"/>
      <SolidColorBrush x:Key="AxCodeTagBrush" Color="{StaticResource AxCodeTagColor}"/>
      <SolidColorBrush x:Key="AxCodeAttributeBrush" Color="{StaticResource AxCodeAttributeColor}"/>
      <SolidColorBrush x:Key="AxCodeStringBrush" Color="{StaticResource AxCodeStringColor}"/>
      <SolidColorBrush x:Key="AxCodeCommentBrush" Color="{StaticResource AxCodeCommentColor}"/>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Light">
      <!-- Поверхности: утопленная, основная (документ и поле), панель, приподнятая и всплывающая. -->
      <Color x:Key="AxSurfaceSunkenColor">#F7F8FA</Color>
      <Color x:Key="AxSurfaceBaseColor">#FFFFFF</Color>
      <Color x:Key="AxSurfacePanelColor">#F7F8FA</Color>
      <Color x:Key="AxSurfaceRaisedColor">#EBECF0</Color>
      <Color x:Key="AxSurfaceOverlayColor">#F7F8FA</Color>

      <!-- Взаимодействие: наведение, нажатие, дорожка и заливка выключенного. -->
      <Color x:Key="AxHoverColor">#EBECF0</Color>
      <Color x:Key="AxPressedColor">#DFE1E5</Color>
      <Color x:Key="AxTrackColor">#DFE1E5</Color>
      <Color x:Key="AxFillDisabledColor">#F7F8FA</Color>

      <!-- Линии: разделитель, граница контрола и разделитель, который читается сильнее обычного. -->
      <Color x:Key="AxStrokeSubtleColor">#EBECF0</Color>
      <Color x:Key="AxStrokeControlColor">#C9CCD6</Color>
      <Color x:Key="AxStrokeStrongColor">#DFE1E5</Color>

      <!-- Текст: четыре уровня и текст на акцентной заливке. -->
      <Color x:Key="AxTextPrimaryColor">#27282E</Color>
      <Color x:Key="AxTextSecondaryColor">#5A5D6B</Color>
      <Color x:Key="AxTextTertiaryColor">#6C707E</Color>
      <Color x:Key="AxTextDisabledColor">#A8ADBD</Color>
      <Color x:Key="AxTextOnAccentColor">#FFFFFF</Color>

      <!-- Акцент: графика, заливка основного действия и кольцо фокуса. -->
      <Color x:Key="AxAccentColor">#3574F0</Color>
      <Color x:Key="AxAccentHoverColor">#3369D6</Color>
      <Color x:Key="AxAccentFillColor">#3369D6</Color>
      <Color x:Key="AxAccentFillHoverColor">#315FBD</Color>
      <Color x:Key="AxAccentFillPressedColor">#315FBD</Color>
      <Color x:Key="AxFocusRingColor">#3574F0</Color>

      <!-- Выделение: пока клавиатура внутри области и когда она ушла. -->
      <Color x:Key="AxSelectionActiveColor">#D4E2FF</Color>
      <Color x:Key="AxSelectionInactiveColor">#EBECF0</Color>

      <!-- Ссылки; на залитой плашке ссылка берёт свой шаг. -->
      <Color x:Key="AxLinkColor">#3369D6</Color>
      <Color x:Key="AxLinkHoverColor">#3369D6</Color>
      <Color x:Key="AxLinkPressedColor">#315FBD</Color>
      <Color x:Key="AxLinkVisitedColor">#55339C</Color>
      <Color x:Key="AxLinkOnPlateColor">#315FBD</Color>

      <!-- Состояния: графика, текст, контур поля, заливка и рамка сообщения. -->
      <Color x:Key="AxErrorColor">#DB3B4B</Color>
      <Color x:Key="AxWarningColor">#A46704</Color>
      <Color x:Key="AxSuccessColor">#208A3C</Color>
      <Color x:Key="AxErrorTextColor">#AD2B38</Color>
      <Color x:Key="AxWarningTextColor">#A14916</Color>
      <Color x:Key="AxSuccessTextColor">#1E6B33</Color>
      <Color x:Key="AxErrorOutlineColor">#DB3B4B</Color>
      <Color x:Key="AxWarningOutlineColor">#FFAF0F</Color>
      <Color x:Key="AxInfoFillColor">#EDF3FF</Color>
      <Color x:Key="AxSuccessFillColor">#F2FCF3</Color>
      <Color x:Key="AxWarningFillColor">#FFF5DB</Color>
      <Color x:Key="AxErrorFillColor">#FFF7F7</Color>
      <Color x:Key="AxInfoStrokeColor">#C2D6FC</Color>
      <Color x:Key="AxSuccessStrokeColor">#C5E5CC</Color>
      <Color x:Key="AxWarningStrokeColor">#FED277</Color>
      <Color x:Key="AxErrorStrokeColor">#FAD4D8</Color>

      <!-- Оттенки значков типов и плитки монограмм: белые инициалы держат на них 5,9:1 и выше. -->
      <Color x:Key="AxTintOrangeColor">#A14916</Color>
      <Color x:Key="AxTintPurpleColor">#55339C</Color>
      <Color x:Key="AxMonogramOrangeColor">#A14916</Color>
      <Color x:Key="AxMonogramGreenColor">#1E6B33</Color>
      <Color x:Key="AxMonogramPurpleColor">#55339C</Color>
      <Color x:Key="AxMonogramRedColor">#AD2B38</Color>

      <!-- Подсказка и ползунок прокрутки: полупрозрачная накладка поверх содержимого. -->
      <Color x:Key="AxToolTipFillColor">#F7F8FA</Color>
      <Color x:Key="AxToolTipStrokeColor">#DFE1E5</Color>
      <Color x:Key="AxScrollThumbColor">#33000000</Color>
      <Color x:Key="AxScrollThumbHoverColor">#59000000</Color>

      <!-- Подсветка кода. -->
      <Color x:Key="AxCodeTextColor">#080808</Color>
      <Color x:Key="AxCodeTagColor">#0033B3</Color>
      <Color x:Key="AxCodeAttributeColor">#174AD4</Color>
      <Color x:Key="AxCodeStringColor">#067D17</Color>
      <Color x:Key="AxCodeCommentColor">#8C8C8C</Color>

      <!-- Тени всплывающего окна и модального диалога. -->
      <BoxShadows x:Key="AxShadowPopup">0 4 16 0 #24000000</BoxShadows>
      <BoxShadows x:Key="AxShadowModal">0 8 40 0 #2E1E283C</BoxShadows>

      <!-- Кисти ролей. -->
      <SolidColorBrush x:Key="AxSurfaceSunkenBrush" Color="{StaticResource AxSurfaceSunkenColor}"/>
      <SolidColorBrush x:Key="AxSurfaceBaseBrush" Color="{StaticResource AxSurfaceBaseColor}"/>
      <SolidColorBrush x:Key="AxSurfacePanelBrush" Color="{StaticResource AxSurfacePanelColor}"/>
      <SolidColorBrush x:Key="AxSurfaceRaisedBrush" Color="{StaticResource AxSurfaceRaisedColor}"/>
      <SolidColorBrush x:Key="AxSurfaceOverlayBrush" Color="{StaticResource AxSurfaceOverlayColor}"/>
      <SolidColorBrush x:Key="AxHoverBrush" Color="{StaticResource AxHoverColor}"/>
      <SolidColorBrush x:Key="AxPressedBrush" Color="{StaticResource AxPressedColor}"/>
      <SolidColorBrush x:Key="AxTrackBrush" Color="{StaticResource AxTrackColor}"/>
      <SolidColorBrush x:Key="AxFillDisabledBrush" Color="{StaticResource AxFillDisabledColor}"/>
      <SolidColorBrush x:Key="AxStrokeSubtleBrush" Color="{StaticResource AxStrokeSubtleColor}"/>
      <SolidColorBrush x:Key="AxStrokeControlBrush" Color="{StaticResource AxStrokeControlColor}"/>
      <SolidColorBrush x:Key="AxStrokeStrongBrush" Color="{StaticResource AxStrokeStrongColor}"/>
      <SolidColorBrush x:Key="AxTextPrimaryBrush" Color="{StaticResource AxTextPrimaryColor}"/>
      <SolidColorBrush x:Key="AxTextSecondaryBrush" Color="{StaticResource AxTextSecondaryColor}"/>
      <SolidColorBrush x:Key="AxTextTertiaryBrush" Color="{StaticResource AxTextTertiaryColor}"/>
      <SolidColorBrush x:Key="AxTextDisabledBrush" Color="{StaticResource AxTextDisabledColor}"/>
      <SolidColorBrush x:Key="AxTextOnAccentBrush" Color="{StaticResource AxTextOnAccentColor}"/>
      <SolidColorBrush x:Key="AxAccentBrush" Color="{StaticResource AxAccentColor}"/>
      <SolidColorBrush x:Key="AxAccentHoverBrush" Color="{StaticResource AxAccentHoverColor}"/>
      <SolidColorBrush x:Key="AxAccentFillBrush" Color="{StaticResource AxAccentFillColor}"/>
      <SolidColorBrush x:Key="AxAccentFillHoverBrush" Color="{StaticResource AxAccentFillHoverColor}"/>
      <SolidColorBrush x:Key="AxAccentFillPressedBrush" Color="{StaticResource AxAccentFillPressedColor}"/>
      <SolidColorBrush x:Key="AxFocusRingBrush" Color="{StaticResource AxFocusRingColor}"/>
      <SolidColorBrush x:Key="AxSelectionActiveBrush" Color="{StaticResource AxSelectionActiveColor}"/>
      <SolidColorBrush x:Key="AxSelectionInactiveBrush" Color="{StaticResource AxSelectionInactiveColor}"/>
      <SolidColorBrush x:Key="AxLinkBrush" Color="{StaticResource AxLinkColor}"/>
      <SolidColorBrush x:Key="AxLinkHoverBrush" Color="{StaticResource AxLinkHoverColor}"/>
      <SolidColorBrush x:Key="AxLinkPressedBrush" Color="{StaticResource AxLinkPressedColor}"/>
      <SolidColorBrush x:Key="AxLinkVisitedBrush" Color="{StaticResource AxLinkVisitedColor}"/>
      <SolidColorBrush x:Key="AxLinkOnPlateBrush" Color="{StaticResource AxLinkOnPlateColor}"/>
      <SolidColorBrush x:Key="AxErrorBrush" Color="{StaticResource AxErrorColor}"/>
      <SolidColorBrush x:Key="AxWarningBrush" Color="{StaticResource AxWarningColor}"/>
      <SolidColorBrush x:Key="AxSuccessBrush" Color="{StaticResource AxSuccessColor}"/>
      <SolidColorBrush x:Key="AxErrorTextBrush" Color="{StaticResource AxErrorTextColor}"/>
      <SolidColorBrush x:Key="AxWarningTextBrush" Color="{StaticResource AxWarningTextColor}"/>
      <SolidColorBrush x:Key="AxSuccessTextBrush" Color="{StaticResource AxSuccessTextColor}"/>
      <SolidColorBrush x:Key="AxErrorOutlineBrush" Color="{StaticResource AxErrorOutlineColor}"/>
      <SolidColorBrush x:Key="AxWarningOutlineBrush" Color="{StaticResource AxWarningOutlineColor}"/>
      <SolidColorBrush x:Key="AxInfoFillBrush" Color="{StaticResource AxInfoFillColor}"/>
      <SolidColorBrush x:Key="AxSuccessFillBrush" Color="{StaticResource AxSuccessFillColor}"/>
      <SolidColorBrush x:Key="AxWarningFillBrush" Color="{StaticResource AxWarningFillColor}"/>
      <SolidColorBrush x:Key="AxErrorFillBrush" Color="{StaticResource AxErrorFillColor}"/>
      <SolidColorBrush x:Key="AxInfoStrokeBrush" Color="{StaticResource AxInfoStrokeColor}"/>
      <SolidColorBrush x:Key="AxSuccessStrokeBrush" Color="{StaticResource AxSuccessStrokeColor}"/>
      <SolidColorBrush x:Key="AxWarningStrokeBrush" Color="{StaticResource AxWarningStrokeColor}"/>
      <SolidColorBrush x:Key="AxErrorStrokeBrush" Color="{StaticResource AxErrorStrokeColor}"/>
      <SolidColorBrush x:Key="AxTintOrangeBrush" Color="{StaticResource AxTintOrangeColor}"/>
      <SolidColorBrush x:Key="AxTintPurpleBrush" Color="{StaticResource AxTintPurpleColor}"/>
      <SolidColorBrush x:Key="AxMonogramOrangeBrush" Color="{StaticResource AxMonogramOrangeColor}"/>
      <SolidColorBrush x:Key="AxMonogramGreenBrush" Color="{StaticResource AxMonogramGreenColor}"/>
      <SolidColorBrush x:Key="AxMonogramPurpleBrush" Color="{StaticResource AxMonogramPurpleColor}"/>
      <SolidColorBrush x:Key="AxMonogramRedBrush" Color="{StaticResource AxMonogramRedColor}"/>
      <SolidColorBrush x:Key="AxToolTipFillBrush" Color="{StaticResource AxToolTipFillColor}"/>
      <SolidColorBrush x:Key="AxToolTipStrokeBrush" Color="{StaticResource AxToolTipStrokeColor}"/>
      <SolidColorBrush x:Key="AxScrollThumbBrush" Color="{StaticResource AxScrollThumbColor}"/>
      <SolidColorBrush x:Key="AxScrollThumbHoverBrush" Color="{StaticResource AxScrollThumbHoverColor}"/>
      <SolidColorBrush x:Key="AxCodeTextBrush" Color="{StaticResource AxCodeTextColor}"/>
      <SolidColorBrush x:Key="AxCodeTagBrush" Color="{StaticResource AxCodeTagColor}"/>
      <SolidColorBrush x:Key="AxCodeAttributeBrush" Color="{StaticResource AxCodeAttributeColor}"/>
      <SolidColorBrush x:Key="AxCodeStringBrush" Color="{StaticResource AxCodeStringColor}"/>
      <SolidColorBrush x:Key="AxCodeCommentBrush" Color="{StaticResource AxCodeCommentColor}"/>
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
