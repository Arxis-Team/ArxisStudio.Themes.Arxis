      <Color x:Key="AxBlue10">#C2D6FC</Color>
      <Color x:Key="AxBlue11">#D4E2FF</Color>
      <Color x:Key="AxBlue12">#EDF3FF</Color>
      <Color x:Key="AxBlue13">#F5F8FE</Color>

      <Color x:Key="AxGreen1">#1E6B33</Color>
      <Color x:Key="AxGreen4">#208A3C</Color>
      <Color x:Key="AxGreen6">#55A76A</Color>
      <Color x:Key="AxGreen7">#89C398</Color>
      <Color x:Key="AxGreen9">#C5E5CC</Color>

      <Color x:Key="AxRed1">#AD2B38</Color>
      <Color x:Key="AxRed4">#DB3B4B</Color>
      <Color x:Key="AxRed6">#E46A76</Color>
      <Color x:Key="AxRed7">#ED99A1</Color>
      <Color x:Key="AxRed9">#FAD4D8</Color>

      <Color x:Key="AxYellow1">#A46704</Color>
      <Color x:Key="AxYellow4">#FFAF0F</Color>
      <Color x:Key="AxYellow6">#FED277</Color>
      <Color x:Key="AxYellow7">#FEE6B1</Color>

      <Color x:Key="AxOrange1">#A14916</Color>
