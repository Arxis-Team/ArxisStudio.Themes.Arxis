<!--
    Метрики темы «Arxis»: строка списка 24, контур фокуса 2, скругление
    контролов 4.
    Держим их ресурсами, чтобы шаблоны не расходились в цифрах.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Высота строки списка, дерева, пункта меню. -->
  <x:Double x:Key="AxRowHeight">24</x:Double>

  <!--
      Контур фокуса: 2px. Нужны обе формы — Thickness для рамок
      (BorderThickness) и Double для обводки фигур (StrokeThickness).
  -->
  <x:Double x:Key="AxFocusOutlineWidth">2</x:Double>
  <Thickness x:Key="AxFocusOutlineThickness">2</Thickness>
  <!--
      Контур фокуса всегда 2 пикселя акцента, но складывается он по-разному.
      У контрола без своей рамки — флажок, тумблер, ползунок — все 2 лежат
      снаружи. У контрола с рамкой она сама на фокусе перекрашивается в
      AxFocusRing и становится первым пикселем контура, а снаружи
      добавляется второй: 1 + 1.

      Кольцо в 2 поверх перекрашенной рамки давало 3 — контур толще, чем
      задумано, и поле в фокусе занимало на пиксель больше места с каждой
      стороны.
  -->
  <Thickness x:Key="AxFocusOutlineOuter">1</Thickness>
  <!--
      Кольцо, которому наружу нельзя. Строка списка, дерева и вкладка занимают
      всю ширину своего хозяина, и вынесенное наружу кольцо срезает сам хозяин:
      от него остаются две вертикальные чёрточки по бокам. Внутри же два
      пикселя на строке высотой 24 читаются заливкой рамки, а не контуром, —
      поэтому здесь один, и это отступление названо, а не сделано молча.
  -->
  <Thickness x:Key="AxFocusOutlineInset">1</Thickness>
  <CornerRadius x:Key="AxCornerRadiusFocusOuter">5</CornerRadius>
  <!-- Кольцо ложится наружу, поэтому отступ отрицательный на свою толщину. -->
  <Thickness x:Key="AxFocusOutlineOuterMargin">-1</Thickness>
  <!--
      Кольцо, обнимающее строку с подписью: флажок, тумблер, ссылка, элемент
      списка выбора. Оно стоит от строки на просвет в пиксель — у отмеченного
      флажка коробка залита тем же акцентом, и вплотную кольцо сливалось с ней
      в одно пятно. Три пикселя поля — это два кольца плюс просвет, и потому
      число здесь, а не в шести шаблонах порознь.
  -->
  <Thickness x:Key="AxFocusOutlineRowMargin">-3</Thickness>
  <!--
      Скругление того же кольца. Концентрично коробке флажка: её три
      (AxCornerRadiusSmall) плюс три пикселя поля выше — внешний край кольца
      стоит на три пикселя дальше коробки, и дуга у него на три шире. Шесть
      стояли числом в пяти шаблонах порознь, и разойдись одно из них — кольца
      флажка и тумблера в одной форме скруглялись бы по-разному.
  -->
  <CornerRadius x:Key="AxCornerRadiusFocusRow">6</CornerRadius>

  <!-- Скругления: контролы, сегменты, всплывающие панели. -->
  <CornerRadius x:Key="AxCornerRadius">4</CornerRadius>
  <CornerRadius x:Key="AxCornerRadiusSmall">3</CornerRadius>
  <!--
      Шесть — своя ступень, а не выдумка разметки: строки навигации
      Welcome, строки-ссылки и полоса вкладок документа
      скруглены сильнее контрола, но слабее панели. Полосе скругляется только
      верх — низом она примыкает к содержимому.
  -->
  <CornerRadius x:Key="AxCornerRadiusMedium">6</CornerRadius>
  <CornerRadius x:Key="AxCornerRadiusMediumTop">6,6,0,0</CornerRadius>
  <CornerRadius x:Key="AxCornerRadiusLarge">8</CornerRadius>
  <!--
      Пилюля: полукруглые торцы при любой высоте. Не половина высоты числом —
      бейдж и чип растут вместе с кеглем темы, и прибитые восемь у бейджа в
      шестнадцать при выросшем кегле дали бы прямоугольник со скруглёнными
      углами. Радиус больше половины стороны отрисовка урезает сама, и торец
      остаётся полукругом.
  -->
  <CornerRadius x:Key="AxCornerRadiusPill">1000</CornerRadius>
  <!--
      Карточка уведомления — единственное, что скруглено сильнее диалога:
      она всплывает над всем и не примыкает ни к чему, поэтому у неё свой
      радиус 12.
  -->
  <CornerRadius x:Key="AxCornerRadiusCard">12</CornerRadius>
  <!--
      Плавающее окно — диалог и попап поиска: они не примыкают ни к чему и
      скруглены сильнее попапов, но слабее карточки уведомления.
  -->
  <CornerRadius x:Key="AxCornerRadiusFloating">10</CornerRadius>

  <!-- Размеры интерактивных контролов. -->
  <x:Double x:Key="AxControlHeight">28</x:Double>
  <x:Double x:Key="AxControlHeightCompact">24</x:Double>
  <!--
      Третья высота осталась ключом, но своего числа больше не несёт: сетка
      хрома кратна четырём, и двадцать шесть между 24 и 28 в неё не ложатся.
      Значение — компактная высота; ключ снимется в 7.0, а до тех пор разметка,
      назвавшая его, получает то же, что и раньше по виду.
  -->
  <x:Double x:Key="AxControlHeightSmall">24</x:Double>
  <x:Double x:Key="AxButtonMinWidth">72</x:Double>
  <x:Double x:Key="AxButtonMinWidthCompact">64</x:Double>
  <!--
      Кнопка подвала диалога шире обычной: «Отмена» и «Сохранить» стоят парой,
      и семидесяти двух хватает каждой порознь, но пара из них выходит разной
      ширины на разных языках. Девяносто шесть ровняет их восемью экранами
      студии — столько мест писало это число руками.
  -->
  <x:Double x:Key="AxDialogButtonMinWidth">96</x:Double>
  <Thickness x:Key="AxButtonPadding">12,0</Thickness>
  <Thickness x:Key="AxTextFieldPadding">10,0</Thickness>
  <!--
      Слева 10 — как у текста в поле ввода, справа 6 — воздух шеврона.
  -->
  <Thickness x:Key="AxComboBoxPadding">10,0,6,0</Thickness>
  <Thickness x:Key="AxDropDownButtonPadding">10,0,8,0</Thickness>
  <!--
      Кнопка-призрак отступает меньше залитой: рамки у неё нет, и лишний
      воздух по бокам отрывал бы подпись от того, что рядом.
  -->
  <Thickness x:Key="AxButtonPaddingGhost">10,0</Thickness>
  <!--
      Многострочное поле: девять по горизонтали, как у однострочного, и шесть
      по вертикали — высота там не фиксирована, и текст по центру не встанет.
  -->
  <Thickness x:Key="AxTextAreaPadding">10,6</Thickness>

  <!--
      Отступы внутрь остальных поверхностей. Тултип; карточка — подсказка,
      уведомление и блок кода отступают внутрь одинаково, и это одно решение,
      а не три совпавших; две полосы окна поиска — поле сверху и подсказки
      снизу; строка списка, вкладка, дерево и его строка, полоса хлебных
      крошек и звено в ней. Числа эти, как и у кнопки, на шкалу
      расстояний не садятся: она мерит промежуток между вещами, а не воздух
      внутри одной.
  -->
  <Thickness x:Key="AxTooltipPadding">10,6</Thickness>
  <Thickness x:Key="AxSurfacePadding">14,12</Thickness>
  <!--
      Справа у строки списка не 8, а ширина полосы прокрутки, 12. Полоса,
      отнимающая ширину, строку до себя не пускает; у темы полоса
      лежит поверх строк, и подпись у правого края — сочетание в палитре, счётчик
      повторов в журнале — уходила под ползунок. Подсветка строки по-прежнему идёт
      во всю ширину, отступает только содержимое, и отступает всегда, а не только
      когда список прокручивается: иначе подпись прыгала бы.
  -->
  <Thickness x:Key="AxListItemPadding">8,2,12,2</Thickness>
  <Thickness x:Key="AxTreeViewPadding">2,4</Thickness>
  <Thickness x:Key="AxTreeViewItemPadding">0,0,8,0</Thickness>
  <Thickness x:Key="AxBreadcrumbPadding">4,0</Thickness>
  <Thickness x:Key="AxBreadcrumbItemPadding">6,2</Thickness>
  <Thickness x:Key="AxBannerPadding">12,8</Thickness>
  <Thickness x:Key="AxBadgePadding">4,0</Thickness>
  <Thickness x:Key="AxChipPadding">8,2</Thickness>
  <Thickness x:Key="AxChipPaddingKey">6,0</Thickness>
  <Thickness x:Key="AxCardPadding">14</Thickness>
  <Thickness x:Key="AxDataGridCellPadding">10,0</Thickness>
  <!--
      Полосы студии. Фильтры над панелью (журнал, терминал), полоса сообщения
      под ней и подпись подсказки при перетаскивании. Ключи здесь, а не в
      разметке экранов, по тому же правилу, что и отступ кнопки: студия —
      такой же потребитель темы, как контрол.
  -->
  <Thickness x:Key="AxToolBarPadding">4,2</Thickness>
  <Thickness x:Key="AxNotePadding">8,4</Thickness>
  <Thickness x:Key="AxDockHintPadding">12,8</Thickness>
  <!--
      Содержимое экрана приветствия: 36 по горизонтали, 28 по вертикали.
      На шкалу не садится и садиться не должно: это поля страницы, а не зазор.
  -->
  <Thickness x:Key="AxWelcomePadding">36,28</Thickness>
  <!--
      Настройки. Карточка отступает внутрь на 16 по бокам и 2 сверху и снизу,
      строка плагина внутри неё держит высоту 44, а страница справа отступает
      от краёв окна.
  -->
  <Thickness x:Key="AxSettingsCardPadding">16,2</Thickness>
  <Thickness x:Key="AxSettingsRowPadding">14,10</Thickness>
  <Thickness x:Key="AxSettingsPagePadding">28,24</Thickness>
  <!--
      Заставка: поля экрана по бокам и отбивка раздела снизу, над подвалом.
      Сверху ноль — верх занимает картинка релиза, и отступ ей задаёт она сама.
  -->
  <Thickness x:Key="AxSplashPadding">40,0,40,24</Thickness>
  <!--
      Строка внутри списка: пункт меню, вкладка, строка выпадающего списка.
      Одно решение на три шаблона — до сих пор восьмёрка стояла в каждом
      порознь, и разъехаться им было нечем помешать.
  -->
  <Thickness x:Key="AxRowPadding">8,0</Thickness>
  <Thickness x:Key="AxQuickSearchFieldPadding">12,10</Thickness>
  <Thickness x:Key="AxQuickSearchHintsPadding">12,8</Thickness>
  <!--
      Строка блока кода в долях кегля — как безразмерный line-height в CSS.
      При кегле 13 это 20; растёт кегль — растёт и строка, а запас над текстом и под ним
      остаётся поровну. Прибитые 20 при крупном кегле клали строки одну на
      другую.

      20 / 13 конечной дробью не записывается, и округлять можно только вниз:
      раскладка округляет размер вверх до пикселя, и 1.5385 давало строку в
      20,0005 и блок на пиксель выше.
  -->
  <x:Double x:Key="AxCodeLineHeightRatio">1.5384615</x:Double>

  <!--
      Меню. Полотно отступает внутрь со всех сторон — меню, контекстное меню
      и MenuFlyout одинаково, и это одно решение на три шаблона; разделителю
      нужен воздух по бокам линии. Пункт отступает как строка списка, поэтому
      своего ключа у него нет.
  -->
  <Thickness x:Key="AxMenuPadding">4</Thickness>
  <!--
      Поле под тень вокруг карточки в окне попапа и диалога. Окно обрезает всё,
      что за его краем, и тень, которой не хватило поля, кончалась прямой
      ступенькой — в светлой теме её видно серой рамкой вокруг меню. Поле
      выведено из самой тени (Palette.axaml): размытие плюс сдвиг по каждой оси.
      У тени попапа 0 4 16 это 16 по горизонтали и 16 + 4 по вертикали, у тени
      диалога 0 8 40 — 40 и 48.

      Поле симметрично по осям, хотя тень сдвинута только вниз: меню у края
      экрана переворачивается вверх, и поправка места на поле (AxMenuFlyout)
      оставалась бы верной только в одну сторону.
  -->
  <Thickness x:Key="AxPopupShadowRoom">16,20</Thickness>
  <Thickness x:Key="AxModalShadowRoom">40,48</Thickness>
  <!--
      Вложенное меню: попап встаёт справа от пункта, и его сдвиг вычитает поле
      под тень. По горизонтали карточка отходит от правого края пункта на 4 —
      как стояла, пока поле было 8. По вертикали первый пункт вложенного меню
      встаёт вровень с пунктом, который его открыл: поле 20, отбивка меню 4 и
      рамка 1 — прежде он стоял на тринадцать ниже.
  -->
  <x:Double x:Key="AxSubmenuHorizontalOffset">-12</x:Double>
  <x:Double x:Key="AxSubmenuVerticalOffset">-25</x:Double>
  <Thickness x:Key="AxMenuSeparatorMargin">6,4</Thickness>

  <!--
      Диалог. Шапка и подвал — полосы одного отступа; у тела верх нулевой,
      потому что верхнюю отбивку ему уже дала шапка. У алерта шапки нет, и
      тело отступает ровно на AxSpaceLoose со всех сторон — там это ступень
      шкалы, а не своё число, и объявлено оно ею.
  -->
  <Thickness x:Key="AxDialogBandPadding">16,12</Thickness>
  <Thickness x:Key="AxDialogBodyMargin">16,0,16,16</Thickness>

  <!--
      Флажок и переключатель. Все длины чётные: 17 и 13 при 150 % давали
      полпиксели, и бегунок в дорожке 17 стоял по центру только на целом
      масштабе. Дорожка 30 × 16, бегунок 12 — по два пикселя поля с каждой
      стороны, как и было.
  -->
  <x:Double x:Key="AxCheckboxSize">16</x:Double>
  <x:Double x:Key="AxCheckboxGap">6</x:Double>
  <Thickness x:Key="AxCheckboxGapThickness">6,0,0,0</Thickness>
  <x:Double x:Key="AxToggleWidth">30</x:Double>
  <x:Double x:Key="AxToggleHeight">16</x:Double>
  <x:Double x:Key="AxToggleKnobSize">12</x:Double>

  <!--
      Хром: высоты, которые идут за плотностью. Все кратны четырём — тогда ни
      при каком масштабе с шагом 25 % они не встают на полпикселя, — и каждая
      объявлена ключом, а не числом в своём шаблоне: до этой вехи вкладка (34),
      шапка панели (30) и полоса заголовка (40) стояли числами и за плотностью
      не шли вовсе.

      Вкладка и шапка панели — одна высота и один ключ: вкладки стоят в шапке, и
      разойтись им нельзя. Кнопка полосы — квадрат высотой с контрол: под одну
      иконку подписи нет, и расти ей нечем. Кнопка окна шире своей высоты —
      конвенция системной полосы: у края экрана цель тянется за край.
  -->
  <x:Double x:Key="AxTabHeight">32</x:Double>
  <x:Double x:Key="AxTitleBarHeight">40</x:Double>
  <x:Double x:Key="AxStatusBarHeight">24</x:Double>
  <x:Double x:Key="AxMenuRowHeight">28</x:Double>
  <x:Double x:Key="AxToolbarButtonSize">28</x:Double>
  <x:Double x:Key="AxWindowButtonWidth">36</x:Double>
  <!--
      Шаг лестницы дерева: клетка шеврона целиком. Шеврон 12 стоит в ней по
      центру, и строка без шеврона ставит значок ровно в его колонку. Прежде шаг
      был константой преобразователя в коде темы (18 = 12 + 6) и за плотностью
      не шёл.
  -->
  <x:Double x:Key="AxTreeIndent">20</x:Double>

  <!-- Иконки: единый размер 16 и толщина обводки 1.2 — вес всего набора. -->
  <x:Double x:Key="AxIconSize">16</x:Double>
  <!--
      Мелкая иконка — единственное отступление от 16, названное разделом 7:
      шеврон в тесной строке, где шестнадцать не помещаются. Здесь, а не числом
      в стиле класса: размер этот носят полтора десятка мест, и колонка шеврона
      в дереве обязана совпадать с ним — иначе стрелка перестанет попадать в
      свою клетку.
  -->
  <x:Double x:Key="AxIconSizeSmall">12</x:Double>
  <x:Double x:Key="AxIconStrokeThickness">1.2</x:Double>

  <!--
      Линия в пиксель: разделитель, линейка заголовка группы, рамка контрола и
      поверхности, обводка кольца радиокнопки. Одна величина в двух формах и на
      каждой стороне порознь — рамка снизу у полосы, сверху у подвала, справа у
      колонки. До этой вехи единица стояла числом в сорока местах темы и
      разметки, и «рамка в пиксель» была не решением, а совпадением.
  -->
  <x:Double x:Key="AxHairline">1</x:Double>
  <Thickness x:Key="AxHairlineThickness">1</Thickness>
  <Thickness x:Key="AxHairlineTopThickness">0,1,0,0</Thickness>
  <Thickness x:Key="AxHairlineBottomThickness">0,0,0,1</Thickness>
  <Thickness x:Key="AxHairlineLeadingThickness">1,0,0,0</Thickness>
  <Thickness x:Key="AxHairlineTrailingThickness">0,0,1,0</Thickness>

  <!-- Плитка с инициалами. -->
  <x:Double x:Key="AxAvatarSize">36</x:Double>
  <!--
      Клетка, в которой нарисован набор: путь значка живёт в ней, а на экран его
      растягивает Viewbox. Это не размер значка на экране — тот AxIconSize.
  -->
  <x:Double x:Key="AxIconGrid">16</x:Double>
  <!--
      Спиннер: крупный вдвое от клетки значка, кольцо внутри клетки и его
      обводка. Кольцо мельче клетки ровно на обводку — иначе оно вышло бы за
      край и срезалось.
  -->
  <x:Double x:Key="AxSpinnerSizeLarge">24</x:Double>
  <x:Double x:Key="AxSpinnerRingSize">14</x:Double>
  <x:Double x:Key="AxSpinnerStrokeThickness">2</x:Double>
  <!--
      Дорожка: полоса хода и жёлоб ползунка — одна высота и один радиус в
      половину её, чтобы торцы остались полукруглыми. Ручка ползунка крупнее
      дорожки и накрывает её.
  -->
  <x:Double x:Key="AxTrackHeight">4</x:Double>
  <CornerRadius x:Key="AxCornerRadiusTrack">2</CornerRadius>
  <x:Double x:Key="AxSliderThumbSize">14</x:Double>
  <!-- Полоса выбранной вкладки и точка несохранённых правок на месте крестика. -->
  <x:Double x:Key="AxTabMarkerHeight">2</x:Double>
  <x:Double x:Key="AxTabModifiedDotSize">7</x:Double>
  <!-- Бейдж-счётчик, чип клавиши и наименьшая высота многострочного поля. -->
  <x:Double x:Key="AxBadgeSize">16</x:Double>
  <x:Double x:Key="AxChipKeyHeight">20</x:Double>
  <x:Double x:Key="AxTextAreaMinHeight">72</x:Double>
  <!--
      Всплывающие поверхности: ширина попапа поиска и его высота, предел ширины
      подсказки и меню, наименьшая ширина диалога. Числа эти — вёрстка экрана, а
      не шкала, и потому названы здесь, а не выведены из ступеней.
  -->
  <x:Double x:Key="AxQuickSearchWidth">300</x:Double>
  <x:Double x:Key="AxQuickSearchMaxHeight">400</x:Double>
  <x:Double x:Key="AxToolTipMaxWidth">400</x:Double>
  <x:Double x:Key="AxDialogMinWidth">320</x:Double>
  <x:Double x:Key="AxMenuMinWidth">160</x:Double>
  <x:Double x:Key="AxMenuMaxWidth">456</x:Double>
  <!-- Половины кнопки с раздельным действием: скругление снаружи, стык внутри. -->
  <CornerRadius x:Key="AxCornerRadiusSplitLeading">4,0,0,4</CornerRadius>
  <CornerRadius x:Key="AxCornerRadiusSplitTrailing">0,4,4,0</CornerRadius>
  <!--
      Кольцо выбранной радиокнопки: обводка в пять при клетке шестнадцать
      оставляет внутри точку в шесть. Толщина, а не размер точки: точка — это
      дырка в кольце, и рисуется она им.
  -->
  <x:Double x:Key="AxRadioMarkThickness">5</x:Double>
  <!--
      Поля, которые держит соседняя геометрия, а не шкала: просвет кольца фокуса
      у ссылки; действие баннера, вынесенное за его отбивку; карточка диалога в
      своём окне; линейка заголовка группы от подписи; полоса выбранной вкладки,
      снимающая её отступ; плашка наведения вкладки панели; кнопки окна у края.
  -->
  <Thickness x:Key="AxFocusOutlineGap">1</Thickness>
  <Thickness x:Key="AxBannerActionMargin">8,-4,0,-4</Thickness>
  <Thickness x:Key="AxDialogWindowMargin">10</Thickness>
  <Thickness x:Key="AxGroupRuleMargin">10,1,0,0</Thickness>
  <Thickness x:Key="AxGroupRuleMarginCollapsible">8,1,0,0</Thickness>
  <Thickness x:Key="AxTabMarkerMargin">-8,0</Thickness>
  <Thickness x:Key="AxTabHoverMargin">-6,2</Thickness>
  <Thickness x:Key="AxWindowControlsMargin">4,0,6,0</Thickness>
  <!--
      Экраны студии: ширины колонок и полей, которые держит вёрстка экрана, а не
      шкала. Студия — такой же потребитель темы, как контрол, и её числа живут
      здесь по той же причине: второе место значения расходится с первым молча.
  -->
  <x:Double x:Key="AxAvatarSizeSmall">22</x:Double>
  <x:Double x:Key="AxPluginTileSize">32</x:Double>
  <x:Double x:Key="AxSearchFieldMaxWidth">340</x:Double>
  <!-- Ширина колонки чтения: длинная строка не растягивается во всю ширину окна. -->
  <x:Double x:Key="AxReadingWidth">760</x:Double>
  <x:Double x:Key="AxWelcomeRecentRowHeight">56</x:Double>
  <x:Double x:Key="AxWelcomeDateColumnWidth">120</x:Double>
  <x:Double x:Key="AxSettingsFilterWidth">170</x:Double>
  <x:Double x:Key="AxSettingsFieldWidth">220</x:Double>
  <x:Double x:Key="AxSettingsActionWidth">112</x:Double>
  <!--
      Палитра команд: карточка шире обычного попапа поиска — в ней читают целые
      названия команд с сочетаниями справа, — и висит ниже верхнего края окна,
      чтобы не наезжать на полосу заголовка.
  -->
  <x:Double x:Key="AxPaletteWidth">520</x:Double>
  <Thickness x:Key="AxPaletteMargin">0,80,0,0</Thickness>
  <!-- Рамка подсказки и призрака докинга: вдвое толще линии, её видно поверх чужого окна. -->
  <Thickness x:Key="AxDockHintThickness">2</Thickness>
  <x:Double x:Key="AxSettingsRowHeight">44</x:Double>
  <x:Double x:Key="AxLinkRowHeight">40</x:Double>
  <!-- Разделитель в полосе заголовка: короче полосы, чтобы не доставать до её краёв. -->
  <x:Double x:Key="AxToolBarDividerHeight">20</x:Double>
  <x:Double x:Key="AxTaskProgressWidth">120</x:Double>
  <x:Double x:Key="AxTaskMessageMaxWidth">220</x:Double>
  <Thickness x:Key="AxWelcomeSidebarPadding">10,16,10,12</Thickness>
  <Thickness x:Key="AxWelcomeBrandMargin">8,0,8,16</Thickness>
  <Thickness x:Key="AxWelcomeFooterPadding">10,8,0,0</Thickness>
  <Thickness x:Key="AxWelcomeStatusPadding">24,10</Thickness>
  <!-- Заголовок раздела отходит от предыдущего дальше, чем от своего содержимого. -->
  <Thickness x:Key="AxSectionTitleMargin">0,16,0,8</Thickness>
  <!-- Подпись под полем: вправо — чтобы встать под текстом поля, вниз — на волос. -->
  <Thickness x:Key="AxFieldNoteMargin">2,6,0,0</Thickness>

  <!--
      Подсказка: сколько ждать под курсором и сколько не ждать, когда человек уже идёт по полосе.
      Первая ждёт, чтобы не выскакивать под руку; соседняя открывается сразу — иначе проход по
      тулбару превращается в шесть отдельных ожиданий.
  -->
  <x:Int32 x:Key="AxToolTipShowDelay">600</x:Int32>
  <x:Int32 x:Key="AxToolTipBetweenShowDelay">100</x:Int32>

  <!-- Разрядка заголовка секции: единственная в теме. -->
  <x:Double x:Key="AxLetterSpacingSection">0.6</x:Double>

  <!--
      Разделитель областей: линия в пиксель, а взяться за неё надо мышью —
      полоса захвата вокруг неё семь. Число из докинга студии, где граница
      областей появилась первой; здесь оно названо, чтобы второй разделитель не
      придумал себе своё.
  -->
  <x:Double x:Key="AxSplitterLane">7</x:Double>

  <!--
      Скроллбар: полоса всегда 12 поперёк, а меняется в ней ползунок — в покое
      6, под курсором 8. Так содержимое не дёргается: ширина полосы от состояния не зависит. Числа эти стоят парами,
      по одному на каждую ориентацию, — потому и здесь, а не в шаблоне.
  -->
  <x:Double x:Key="AxScrollBarLane">12</x:Double>
  <x:Double x:Key="AxScrollThumbSize">6</x:Double>
  <x:Double x:Key="AxScrollThumbSizeHover">8</x:Double>
  <!--
      Отбивка ползунка от дальнего края полосы. Число не выбрано, а посчитано:
      полоса 12, ползунок 6 — остаётся по три с каждой стороны, под курсором
      ползунок 8 и остаётся по два. Пары, как и у самих размеров: по одной на
      каждую ориентацию.
  -->
  <Thickness x:Key="AxScrollThumbInset">0,0,3,0</Thickness>
  <Thickness x:Key="AxScrollThumbInsetBottom">0,0,0,3</Thickness>
  <Thickness x:Key="AxScrollThumbInsetHover">0,0,2,0</Thickness>
  <Thickness x:Key="AxScrollThumbInsetHoverBottom">0,0,0,2</Thickness>

</ResourceDictionary>
