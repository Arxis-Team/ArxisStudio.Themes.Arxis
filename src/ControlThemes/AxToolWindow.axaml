<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ax="using:ArxisStudio.Controls">

  <!--
      Панель инструментов Int UI: шапка 30px и содержимое под ней.

      Заголовок и вкладки лежат в одной строке шапки — в Int UI вкладки не
      заменяют заголовок, а встают рядом с ним, поэтому «Проект» остаётся
      подписан даже когда внутри переключаются «Консоль» и «Проблемы».
      Действия прижаты вправо и не уезжают под длинный заголовок.
  -->
  <ControlTheme x:Key="{x:Type ax:AxToolWindow}" TargetType="ax:AxToolWindow">
    <Setter Property="Background" Value="{DynamicResource AxBg2Brush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AxFgBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AxBrdBrush}"/>
    <!--
        Панель обведена и скруглена: так её показывает карточка «Заголовок
        панели». Радиус там 6, но в шкале проекта его нет (3 / 4 / 8) — взят
        контрольный. Обрезка нужна линии под шапкой: без неё она вылезает за
        скругление и торчит усиками по краям.
    -->
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadius}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                ClipToBounds="True">
          <DockPanel>
            <!--
                Шапка 30 высотой и без собственных отступов.

                Карточка «Заголовок панели» объявляет 38 и отбивку 12 с обеих
                сторон, и это расхождение с ней — намеренное. Вкладка в шапке
                читается как вкладка, только когда доходит до края: отбивка
                оставляла слева пустую полосу, а панель под шапкой начиналась
                левее самой первой вкладки.
                <para/>
                Отбивку карточки поэтому носят те, кому она и нужна: заголовок
                слева и действия справа. Вкладки идут вровень с краем, а
                скрытый ребёнок DockPanel места не занимает — у панели без
                заголовка полоса вкладок занимает шапку целиком.
            -->
            <Border x:Name="PART_Header"
                    DockPanel.Dock="Top"
                    Height="30"
                    Padding="0,0"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="0"
                    IsVisible="{TemplateBinding ShowHeader}">
              <DockPanel>
                <ContentPresenter x:Name="PART_Actions"
                                  DockPanel.Dock="Right"
                                  Margin="12,0"
                                  Content="{TemplateBinding Actions}"
                                  VerticalAlignment="Center"
                                  IsVisible="{TemplateBinding Actions, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <!--
                    Отступ до вкладок принадлежит заголовку, а не им: он их
                    разделяет. Стой он на вкладках — у панели без заголовка (а
                    в докинге он всегда пуст) вкладки отходили бы от края на
                    ровное место, отделяясь от пустоты.
                -->
                <TextBlock x:Name="PART_Title"
                           Text="{TemplateBinding Title}"
                           Margin="12,0"
                           FontWeight="SemiBold"
                           Foreground="{TemplateBinding Foreground}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           IsVisible="{TemplateBinding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <ContentPresenter x:Name="PART_Tabs"
                                  Content="{TemplateBinding Tabs}"
                                  VerticalAlignment="Stretch"
                                  IsVisible="{TemplateBinding Tabs, Converter={x:Static ObjectConverters.IsNotNull}}"/>
              </DockPanel>
            </Border>
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^[ShowHeaderSeparator=True] /template/ Border#PART_Header">
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
  </ControlTheme>

</ResourceDictionary>
