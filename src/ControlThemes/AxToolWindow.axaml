<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ax="https://github.com/Arxis-Team/ArxisStudio">

  <!--
      Панель инструментов: шапка ростом с вкладку и содержимое под ней.

      Заголовок и вкладки лежат в одной строке шапки — вкладки не
      заменяют заголовок, а встают рядом с ним, поэтому «Проект» остаётся
      подписан даже когда внутри переключаются «Консоль» и «Проблемы».
      Действия прижаты вправо и не уезжают под длинный заголовок.
  -->
  <ControlTheme x:Key="{x:Type ax:AxToolWindow}" TargetType="ax:AxToolWindow">
    <Setter Property="Background" Value="{DynamicResource AxSurfacePanelBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AxTextPrimaryBrush}"/>
    <!--
        Панель плоская: ни рамки, ни скругления. Доки — не стопка карточек, а одна поверхность,
        разрезанная линиями: панели стоят встык, и границу между ними держит разделитель области
        в пиксель устройства. Обведённая панель добавляла к нему свою рамку с каждой стороны — три
        линии там, где нужна одна, — а скруглённый угол на стыке открывал фон оболочки, и по
        границам выступали тёмные зазубрины.

        BorderBrush при этом остаётся: это цвет линии под шапкой, и рисует её разделитель.
    -->
    <Setter Property="BorderBrush" Value="{DynamicResource AxStrokeSubtleBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                ClipToBounds="True">
          <DockPanel>
            <!--
                Шапка 30 высотой. Высота наименьшая: заголовок и вкладки растут
                с кеглем темы, и прибитые тридцать срезали бы их снизу.

                Слева отбивки нет намеренно. Вкладка в шапке читается как
                вкладка, только когда доходит до края: отбивка оставляла слева
                пустую полосу, а панель под шапкой начиналась левее самой первой
                вкладки. Отбивку слева носит тот, кому она нужна, — заголовок.

                Справа отбивка принадлежит самой шапке, и это не симметрия ради
                симметрии. У правого края стоят иконочные кнопки, и кто там
                окажется последним, шапка не знает: у панели это её действия, у
                группы доков — кнопка скрытия, приехавшая с вкладками, а у
                группы, которой прятаться нельзя, — кнопка переполнения внутри
                самой полосы. Носи отбивку они сами, её пришлось бы помнить в
                трёх местах, и забывший прижимался бы к краю: кнопка, доведённая
                до края, читается обрезанной, а подсветка под курсором упирается
                в соседнюю панель.
            -->
            <Border x:Name="PART_Header"
                    DockPanel.Dock="Top"
                    MinHeight="{DynamicResource AxTabHeight}"
                    Padding="{DynamicResource AxSpaceWideTrailingThickness}"
                    IsVisible="{TemplateBinding ShowHeader}">
              <DockPanel>
                <!-- Своя отбивка у действий одна: зазор от вкладок слева. Край им даёт шапка. -->
                <ContentPresenter x:Name="PART_Actions"
                                  DockPanel.Dock="Right"
                                  Margin="{DynamicResource AxSpaceWideLeadingThickness}"
                                  Content="{TemplateBinding Actions}"
                                  VerticalAlignment="Center"
                                  IsVisible="{TemplateBinding Actions, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <!--
                    Отступ до вкладок принадлежит заголовку, а не им: он их
                    разделяет. Стой он на вкладках — у панели без заголовка (а
                    в докинге он всегда пуст) вкладки отходили бы от края на
                    ровное место, отделяясь от пустоты.
                -->
                <TextBlock x:Name="PART_Title"
                           Text="{TemplateBinding Title}"
                           Margin="{DynamicResource AxSpaceWideSidesThickness}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AxTextSecondaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           IsVisible="{TemplateBinding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <ContentPresenter x:Name="PART_Tabs"
                                  Content="{TemplateBinding Tabs}"
                                  VerticalAlignment="Stretch"
                                  IsVisible="{TemplateBinding Tabs, Converter={x:Static ObjectConverters.IsNotNull}}"/>
              </DockPanel>
            </Border>
            <!--
                Линия под шапкой: разделитель, а не нижняя рамка шапки. Раскладочная единица при
                150 % даёт два пикселя, и шапка панели обрастала кантом вдвое толще линий,
                которыми разрезан весь остальной док. Разделитель считает пиксель устройства сам.
            -->
            <ax:AxDivider x:Name="PART_HeaderRule"
                          DockPanel.Dock="Top"
                          Fill="{TemplateBinding BorderBrush}"
                          IsVisible="False"/>
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- Линия под шапкой нужна только там, где есть шапка: без неё она легла бы на пустое место. -->
    <Style Selector="^[ShowHeaderSeparator=True][ShowHeader=True] /template/ ax|AxDivider#PART_HeaderRule">
      <Setter Property="IsVisible" Value="True"/>
    </Style>

    <!--
        Активная панель — та, в которой сейчас клавиатура. Без этого состояния у среды с десятком
        панелей нет ответа на вопрос «куда пойдёт нажатие», и человек узнаёт его, только нажав.

        Отвечает на него не шапка. Прежде шапка поднималась на ступень поверхности, и пятно во всю
        её ширину переезжало между панелями на каждый щелчок по вкладке: боковым зрением это видно
        даже слишком, а сказать, что именно изменилось, человек не может. У JetBrains в новом
        оформлении ToolWindow.Header.background и ToolWindow.Header.inactiveBackground — один и тот
        же цвет: шапка не меняется вовсе, а различаются underlineColor и inactiveUnderlineColor,
        то есть полоса выбранной вкладки. У Unity индикатор фокуса тоже принадлежит вкладке, а не
        контейнеру. Здесь теперь так же: цвет полосы и цвет подписи выбранной вкладки — см.
        AxTabStrip.

        Шапке остаётся её собственный цвет и её тонкая линия, и они не меняются никогда.

        Заголовок в докинге пуст — там работу делают вкладки, — но у панели, показывающей
        заголовок вместо них, отвечать больше нечему: он и берёт на себя ту же роль, основным
        цветом вместо вторичного. Вкладка и заголовок говорят одним способом — яркостью подписи.

        :active, а не :focus-within: фокус стоит на контроле внутри панели, у самой панели его не
        бывает никогда, а focus-within вдобавок гас, стоило открыть меню — у окна попапа нет
        визуального предка. Признак ставит область выделения, которая смотрит на логическую
        цепочку, и меню остаётся внутри панели, из которой его позвали. Вкладки берут то же
        значение наследованием: область метит собой всё поддерево.
    -->
    <Style Selector="^:active /template/ TextBlock#PART_Title">
      <Setter Property="Foreground" Value="{DynamicResource AxTextPrimaryBrush}"/>
    </Style>
  </ControlTheme>

</ResourceDictionary>
