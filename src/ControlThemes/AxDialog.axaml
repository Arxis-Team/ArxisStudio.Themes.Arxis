<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ax="using:ArxisStudio.Controls"
                    xmlns:axi="using:ArxisStudio.Icons">

  <!--
      Диалог: окно без системной рамки на тени AxModalShadow — заголовок с
      крестиком, содержимое, полоса кнопок за линией. Основное действие стоит
      крайним справа; слева в полосе живёт FooterContent («Больше не
      спрашивать»). Размер даёт содержимое, позиция — центр окна-владельца.
  -->
  <ControlTheme x:Key="{x:Type ax:AxDialog}" TargetType="ax:AxDialog">
    <Setter Property="Foreground" Value="{DynamicResource AxFgBrush}"/>
    <Setter Property="FontFamily" Value="{DynamicResource AxFontFamily}"/>
    <Setter Property="FontSize" Value="{DynamicResource AxFontSize}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <VisualLayerManager>
          <Border Background="{DynamicResource AxBg1Brush}"
                  CornerRadius="{DynamicResource AxCornerRadiusFloating}"
                  BoxShadow="{DynamicResource AxModalShadow}"
                  Margin="24"
                  MinWidth="320"
                  ClipToBounds="False">
            <DockPanel>
              <!--
                  Шапка обычного диалога. У алерта её нет: со значком заголовок
                  и текст встают колонкой рядом с ним, и уйти оттуда можно
                  только кнопкой — решение обязательно.
              -->
              <DockPanel x:Name="PART_Header" DockPanel.Dock="Top" Margin="16,12">
                <ax:AxButton DockPanel.Dock="Right"
                             x:Name="PART_Close"
                             Classes="icon"
                             VerticalAlignment="Center"
                             IsVisible="{Binding IsCloseVisible, RelativeSource={RelativeSource TemplatedParent}}">
                  <axi:AxIcon Classes="small" Data="{x:Static axi:AxIcons.Close}"
                             Foreground="{Binding $parent[ax:AxButton].Foreground}"/>
                </ax:AxButton>
                <TextBlock Text="{TemplateBinding Title}"
                           FontWeight="SemiBold"
                           FontSize="{DynamicResource AxFontSizeLarge}"
                           VerticalAlignment="Center"/>
              </DockPanel>
              <Border x:Name="PART_Footer"
                      DockPanel.Dock="Bottom"
                      BorderBrush="{DynamicResource AxBrdBrush}"
                      BorderThickness="0,1,0,0"
                      Padding="16,12">
                <DockPanel>
                  <ContentPresenter Content="{TemplateBinding Buttons}"
                                    DockPanel.Dock="Right"
                                    Margin="12,0,0,0"
                                    HorizontalAlignment="Right"
                                    IsVisible="{TemplateBinding Buttons, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                  <ContentPresenter Content="{TemplateBinding FooterContent}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    IsVisible="{TemplateBinding FooterContent, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </DockPanel>
              </Border>
              <!--
                  Тело. У алерта в него въезжают значок слева и заголовок над
                  текстом — оба прячутся, пока значка нет.
              -->
              <DockPanel x:Name="PART_Body" Margin="16,0,16,16">
                <ContentPresenter x:Name="PART_AlertIcon"
                                  DockPanel.Dock="Left"
                                  Margin="0,0,12,0"
                                  VerticalAlignment="Top"
                                  Content="{TemplateBinding AlertIcon}"
                                  IsVisible="False"/>
                <StackPanel Spacing="4">
                  <TextBlock x:Name="PART_AlertTitle"
                             Text="{TemplateBinding Title}"
                             FontWeight="SemiBold"
                             FontSize="{DynamicResource AxFontSizeLarge}"
                             TextWrapping="Wrap"
                             IsVisible="False"/>
                  <ContentPresenter x:Name="PART_ContentPresenter"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    TextBlock.Foreground="{DynamicResource AxFg2Brush}"
                                    TextBlock.TextWrapping="Wrap"/>
                </StackPanel>
              </DockPanel>
            </DockPanel>
          </Border>
        </VisualLayerManager>
      </ControlTemplate>
    </Setter>
    <!--
        Алерт: шапки нет, значок и заголовок встают в тело. Верхнюю отбивку
        тело берёт на себя — у обычного диалога её давала шапка.
    -->
    <Style Selector="^:alert /template/ DockPanel#PART_Header">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="^:alert /template/ DockPanel#PART_Body">
      <Setter Property="Margin" Value="16"/>
    </Style>
    <Style Selector="^:alert /template/ ContentPresenter#PART_AlertIcon">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="^:alert /template/ TextBlock#PART_AlertTitle">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
  </ControlTheme>

</ResourceDictionary>
