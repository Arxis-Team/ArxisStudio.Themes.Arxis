<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ax="https://github.com/Arxis-Team/ArxisStudio">

  <!--
      Полоса сообщения: цветной фон по смыслу, значок слева, действия справа.
      Цвета фона — приглушённые из шкалы (Blue 1 / Green 1 / Yellow 1 / Red 1
      в тёмной теме), чтобы полоса читалась, но не спорила с содержимым.
  -->
  <ControlTheme x:Key="{x:Type ax:AxBanner}" TargetType="ax:AxBanner">
    <Setter Property="Background" Value="{DynamicResource AxInfoFillBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AxTextPrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AxInfoStrokeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadiusLarge}"/>
    <Setter Property="Padding" Value="{DynamicResource AxBannerPadding}"/>
    <Setter Property="FontSize" Value="{DynamicResource AxFontSize}"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <DockPanel>
            <!-- По центру строки: содержимое баннера выровнено по центру,
                 а не по верху. -->
            <ax:AxIcon x:Name="PART_Icon"
                       DockPanel.Dock="Left"
                       Margin="{DynamicResource AxGapIconTextThickness}"
                       VerticalAlignment="Center"
                       Data="{x:Static ax:AxIcons.Info}"
                       Foreground="{DynamicResource AxAccentBrush}"/>
            <!--
                Крестик закрытия: он есть у баннера любой строгости, даже без
                действий, — сообщение о состоянии перестаёт быть нужным раньше,
                чем состояние меняется.

                Отрицательные отступы сверху и снизу — чтобы цель нажатия в 24
                не распирала полосу: цель меньше 24 не бывает, а
                баннер растёт по содержимому — строка 16,
                отступ 8 сверху и снизу, рамка в пиксель, всего 34.
            -->
            <ax:AxButton x:Name="PART_Close"
                         DockPanel.Dock="Right"
                         Theme="{StaticResource AxInlineIconButton}"
                         Margin="8,-4,0,-4"
                         VerticalAlignment="Center"
                         AutomationProperties.Name="{DynamicResource AxTextMessageClose}">
              <ax:AxIcon Size="Small"
                         Data="{x:Static ax:AxIcons.Close}"
                         Foreground="{Binding $parent[ax:AxButton].Foreground}"/>
            </ax:AxButton>
            <ContentPresenter x:Name="PART_Actions"
                              DockPanel.Dock="Right"
                              Margin="{DynamicResource AxSpaceWideLeadingThickness}"
                              VerticalAlignment="Center"
                              Content="{TemplateBinding Actions}"
                              IsVisible="{TemplateBinding Actions, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              VerticalAlignment="Center"
                              TextBlock.TextWrapping="Wrap"/>
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^[Severity=Success]">
      <Setter Property="Background" Value="{DynamicResource AxSuccessFillBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AxSuccessStrokeBrush}"/>
    </Style>
    <Style Selector="^[Severity=Success] /template/ ax|AxIcon#PART_Icon">
      <Setter Property="Data" Value="{x:Static ax:AxIcons.Success}"/>
      <Setter Property="Foreground" Value="{DynamicResource AxSuccessBrush}"/>
    </Style>

    <!-- Значок предупреждения — треугольник и AxWarningOutline: AxWarning рассчитан
         на текст и в светлой теме слишком тёмный для значка. -->
    <Style Selector="^[Severity=Warning]">
      <Setter Property="Background" Value="{DynamicResource AxWarningFillBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AxWarningStrokeBrush}"/>
    </Style>
    <Style Selector="^[Severity=Warning] /template/ ax|AxIcon#PART_Icon">
      <Setter Property="Data" Value="{x:Static ax:AxIcons.WarningTriangle}"/>
      <Setter Property="Foreground" Value="{DynamicResource AxWarningOutlineBrush}"/>
    </Style>

    <Style Selector="^[Severity=Error]">
      <Setter Property="Background" Value="{DynamicResource AxErrorFillBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AxErrorStrokeBrush}"/>
    </Style>
    <Style Selector="^[Severity=Error] /template/ ax|AxIcon#PART_Icon">
      <Setter Property="Data" Value="{x:Static ax:AxIcons.Error}"/>
      <Setter Property="Foreground" Value="{DynamicResource AxErrorBrush}"/>
    </Style>
  </ControlTheme>

</ResourceDictionary>
