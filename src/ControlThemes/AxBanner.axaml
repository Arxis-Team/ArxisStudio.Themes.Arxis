<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ax="using:ArxisStudio.Controls">

  <!--
      Полоса сообщения: цветной фон по смыслу, значок слева, действия справа.
      Цвета фона — приглушённые из шкалы (Blue 1 / Green 1 / Yellow 1 / Red 1
      в тёмной теме), чтобы полоса читалась, но не спорила с содержимым.
  -->
  <ControlTheme x:Key="{x:Type ax:AxBanner}" TargetType="ax:AxBanner">
    <Setter Property="Background" Value="{DynamicResource AxInfoBackgroundBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AxFgBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AxInfoBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadiusLarge}"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="FontSize" Value="{DynamicResource AxFontSize}"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <DockPanel>
            <ax:AxIcon x:Name="PART_Icon"
                       DockPanel.Dock="Left"
                       Margin="0,0,10,0"
                       VerticalAlignment="Top"
                       Data="{x:Static ax:AxIcons.Info}"
                       Foreground="{DynamicResource AxAccBrush}"/>
            <!--
                Крестик закрытия: он есть у баннера любой строгости, даже без
                действий, — сообщение о состоянии перестаёт быть нужным раньше,
                чем состояние меняется.

                Отрицательные отступы сверху и снизу — чтобы цель нажатия в 24
                не распирала полосу: раздел 12 запрещает цель меньше 24, а
                карточка проекта рисует баннер по содержимому, и лишние четыре
                пикселя высоты видны сразу.
            -->
            <ax:AxButton x:Name="PART_Close"
                         DockPanel.Dock="Right"
                         Theme="{StaticResource AxInlineIconButton}"
                         Margin="8,-2,0,-2"
                         VerticalAlignment="Center"
                         AutomationProperties.Name="Закрыть сообщение">
              <ax:AxIcon Classes="small"
                         Data="{x:Static ax:AxIcons.Close}"
                         Foreground="{Binding $parent[ax:AxButton].Foreground}"/>
            </ax:AxButton>
            <ContentPresenter x:Name="PART_Actions"
                              DockPanel.Dock="Right"
                              Margin="12,0,0,0"
                              VerticalAlignment="Center"
                              Content="{TemplateBinding Actions}"
                              IsVisible="{TemplateBinding Actions, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              VerticalAlignment="Center"
                              TextBlock.TextWrapping="Wrap"/>
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^[Severity=Success]">
      <Setter Property="Background" Value="{DynamicResource AxSuccessBackgroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AxSuccessBorderBrush}"/>
    </Style>
    <Style Selector="^[Severity=Success] /template/ ax|AxIcon#PART_Icon">
      <Setter Property="Data" Value="{x:Static ax:AxIcons.Success}"/>
      <Setter Property="Foreground" Value="{DynamicResource AxGrnBrush}"/>
    </Style>

    <!-- Значок предупреждения — треугольник и AxOutlineWarning: AxYel рассчитан
         на текст и в светлой теме слишком тёмный для значка. -->
    <Style Selector="^[Severity=Warning]">
      <Setter Property="Background" Value="{DynamicResource AxWarningBackgroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AxWarningBorderBrush}"/>
    </Style>
    <Style Selector="^[Severity=Warning] /template/ ax|AxIcon#PART_Icon">
      <Setter Property="Data" Value="{x:Static ax:AxIcons.WarningTriangle}"/>
      <Setter Property="Foreground" Value="{DynamicResource AxOutlineWarningBrush}"/>
    </Style>

    <Style Selector="^[Severity=Error]">
      <Setter Property="Background" Value="{DynamicResource AxErrorBackgroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AxErrorBorderBrush}"/>
    </Style>
    <Style Selector="^[Severity=Error] /template/ ax|AxIcon#PART_Icon">
      <Setter Property="Data" Value="{x:Static ax:AxIcons.Error}"/>
      <Setter Property="Foreground" Value="{DynamicResource AxRedBrush}"/>
    </Style>
  </ControlTheme>

</ResourceDictionary>
