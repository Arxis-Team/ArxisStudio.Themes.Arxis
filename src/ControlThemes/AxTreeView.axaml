<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ax="https://github.com/Arxis-Team/ArxisStudio">

  <!--
      Дерево проекта: строка 24 — та же, что у строки списка,
      выделение — заливка на всю ширину панели, стрелка раскрытия слева от
      содержимого. Отступ по уровню даёт сама Avalonia через TreeViewItem.Level.

      Лестница — 8 → 26 → 44 от левого края строки — держится на
      арифметике: 8 отбивки, 12 шеврона, 6 зазора дают ровно 26, дальше шаг 18.
      Поэтому колонка шеврона обязана быть 12, а не 16: лишние 4 сдвигают все
      подписи, и лестница разъезжается.
  -->
  <ControlTheme x:Key="{x:Type ax:AxTreeView}" TargetType="ax:AxTreeView">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <!--
        Отбивка по горизонтали 2: выделенная строка вставлена на 2px от краёв
        панели. Повешенные на саму строку, эти 2px уводили бы её подпись вправо
        от соседних — здесь они отданы панели, так заливка отступает от краёв,
        а подписи всех строк остаются в одной колонке.
    -->
    <Setter Property="Padding" Value="{DynamicResource AxTreeViewPadding}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" Margin="{TemplateBinding Padding}"/>
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ax:AxTreeViewItem}" TargetType="ax:AxTreeViewItem">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource AxTextPrimaryBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource AxFontSize}"/>
    <Setter Property="Padding" Value="{DynamicResource AxTreeViewItemPadding}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel>
          <Panel>
          <Border x:Name="PART_Root"
                  MinHeight="{DynamicResource AxRowHeight}"
                  CornerRadius="{DynamicResource AxCornerRadius}"
                  Background="{TemplateBinding Background}">
            <DockPanel Margin="{Binding Level, RelativeSource={RelativeSource TemplatedParent},
                                        Converter={x:Static ax:AxTreeIndentConverter.Instance}}">
              <ToggleButton x:Name="PART_ExpandCollapseChevron"
                            DockPanel.Dock="Left"
                            Width="{DynamicResource AxIconSizeSmall}" Height="{DynamicResource AxRowHeight}"
                            Margin="{DynamicResource AxGapIconTextThickness}"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Focusable="False"
                            IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate>
                    <Border Background="Transparent">
                      <ContentPresenter Content="{TemplateBinding Content}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
                <!--
                    Мелкий шеврон — отдельный класс, а не свои размеры на
                    месте. Толщина обводки остаётся набора: на отдельных
                    иконках её не меняют, иначе набор расслаивается по весу.

                    Значок стоит содержимым кнопки, а не в её шаблоне: шаблон
                    кнопки — своя область имён, и стиль раскрытого узла ниже
                    туда не достаёт — шеврон так и остался бы смотреть вправо.
                -->
                <ax:AxIcon x:Name="Chevron"
                           Classes="small"
                           Data="{x:Static ax:AxIcons.ChevronRight}"
                           Foreground="{DynamicResource AxTextSecondaryBrush}"/>
              </ToggleButton>
              <!--
                  Значок: слева от подписи стоит то глиф
                  папки, то плашку типа файла. Место занимается только когда
                  значок есть — у строки без него подпись не отъезжает.
              -->
              <ContentPresenter x:Name="PART_Icon"
                                DockPanel.Dock="Left"
                                Margin="{DynamicResource AxGapIconTextThickness}"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Icon}"
                                IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}"/>
              <ContentPresenter Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                Padding="{TemplateBinding Padding}"
                                VerticalAlignment="Center"/>
            </DockPanel>
          </Border>
            <!--
                Кольцо строки лежит внутри, а не снаружи: строка дерева
                занимает всю его ширину, и вынесенное наружу кольцо срезал бы
                сам список. Панель обнимает только PART_Root — детей строка не
                содержит, они идут отдельной частью ниже, и обводить их вместе
                с родителем значило бы обводить пол-дерева.
            -->
            <Border x:Name="PART_FocusRing"
                    BorderThickness="{DynamicResource AxFocusOutlineInset}"
                    BorderBrush="{DynamicResource AxFocusRingBrush}"
                    CornerRadius="{DynamicResource AxCornerRadius}"
                    IsVisible="False"/>
          </Panel>
          <ItemsPresenter x:Name="PART_ItemsPresenter"
                          IsVisible="{TemplateBinding IsExpanded}"
                          ItemsPanel="{TemplateBinding ItemsPanel}"/>
        </StackPanel>
      </ControlTemplate>
    </Setter>

    <!--
        У листа колонки шеврона нет вовсе: значок файла встаёт ровно на его
        место: значок листа стоит в одной колонке с
        папкой родителя (26 у App.axaml против 44 у ViewModels), а не правее её
        на шаг. Пустая колонка вместо этого увела бы все файлы на 18 вправо.
    -->
    <Style Selector="^:empty /template/ ToggleButton#PART_ExpandCollapseChevron">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <!--
        Раскрытый узел смотрит вниз. Состояние берётся с самой кнопки, а не с
        псевдокласса строки: IsChecked кнопки связан с IsExpanded напрямую, и
        так стиль не зависит от того, заводит ли Avalonia :expanded у строки.
    -->
    <Style Selector="^ /template/ ToggleButton#PART_ExpandCollapseChevron:checked ax|AxIcon#Chevron">
      <Setter Property="Data" Value="{x:Static ax:AxIcons.ChevronDown}"/>
    </Style>

    <!--
        Наведение спрашиваем у самой строки, а не у элемента дерева: у элемента
        :pointerover держится, пока курсор над любым его потомком, а дочерние
        строки лежат внутри него — и вместе с наведённой подсвечивалась вся
        ветка предков. PART_Root детей не содержит, они идут отдельной частью
        ниже, поэтому его наведение — ровно одна строка.
    -->
    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True"/>
    </Style>

    <Style Selector="^ /template/ Border#PART_Root:pointerover">
      <Setter Property="Background" Value="{DynamicResource AxHoverBrush}"/>
    </Style>
    <Style Selector="^:selected /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource AxSelectionInactiveBrush}"/>
    </Style>
    <!--
        Погашенное выделение — состояние по умолчанию: полную силу ему даёт
        фокус списка, и стиль на это живёт в ArxisTheme.axaml — стилю из темы
        контрола предок не виден.
    -->
    <!--
        Выключенная строка: текст на AxTextDisabled.
        Стиль стоит последним намеренно — выделение и наведение объявлены выше,
        и без этого выключенная выбранная строка выглядела бы обычной.
    -->
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource AxTextDisabledBrush}"/>
    </Style>

  </ControlTheme>

</ResourceDictionary>
