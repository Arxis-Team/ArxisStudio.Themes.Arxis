<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ax="using:ArxisStudio.Controls">

  <!-- Флажок 14×14, radius 3.5; отмеченный — акцентная заливка с белой галочкой. -->
  <ControlTheme x:Key="{x:Type ax:AxCheckBox}" TargetType="ax:AxCheckBox">
    <Setter Property="Foreground" Value="{DynamicResource AxFgBrush}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
          <Border x:Name="PART_Box"
                  Width="14" Height="14" CornerRadius="3.5"
                  BorderBrush="{DynamicResource AxBrd2Brush}"
                  BorderThickness="1.5"
                  Background="Transparent"
                  VerticalAlignment="Center">
            <Path x:Name="PART_Check"
                  Data="M 3.5 8.5 L 6.5 11.5 L 12.5 4.5"
                  Stroke="{DynamicResource AxOnAccBrush}"
                  StrokeThickness="2"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  Stretch="Uniform"
                  Margin="2"
                  IsVisible="False"/>
          </Border>
          <ContentPresenter Grid.Column="1"
                            Margin="8,0,0,0"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True"
                            IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}"/>
        </Grid>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:checked /template/ Border#PART_Box">
      <Setter Property="Background" Value="{DynamicResource AxAccBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="^:checked /template/ Path#PART_Check">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.5"/>
    </Style>
  </ControlTheme>

</ResourceDictionary>
