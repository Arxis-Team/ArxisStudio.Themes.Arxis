<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ax="using:ArxisStudio.Controls">

  <!-- Флажок Int UI 16×16, скругление 3; отмеченный — акцентная заливка с галочкой. -->
  <ControlTheme x:Key="{x:Type ax:AxCheckBox}" TargetType="ax:AxCheckBox">
    <Setter Property="Foreground" Value="{DynamicResource AxFgBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource AxFontSize}"/>
    <Setter Property="MinHeight" Value="{DynamicResource AxControlHeightCompact}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <!-- Кольцо фокуса обнимает всю строку с подписью — как в компоненте. -->
          <Border x:Name="PART_FocusRing"
                  Margin="-2"
                  CornerRadius="6"
                  BorderThickness="{DynamicResource AxFocusOutlineThickness}"
                  BorderBrush="{DynamicResource AxOutlineFocusedBrush}"
                  IsVisible="False"/>
          <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
            <Panel VerticalAlignment="Center">
              <Border x:Name="PART_Box"
                      Width="{DynamicResource AxCheckboxSize}"
                      Height="{DynamicResource AxCheckboxSize}"
                      CornerRadius="{DynamicResource AxCornerRadiusSmall}"
                      BorderBrush="{DynamicResource AxBrd2Brush}"
                      BorderThickness="1"
                      Background="{DynamicResource AxInpBrush}"
                      VerticalAlignment="Center"/>
              <!--
                  Галочка и черта — пути 16-сетки со штрихом иконок, как в
                  компоненте: рисуются поверх коробки без масштабирования,
                  чтобы вес совпадал с остальным набором глифов.
              -->
              <Path x:Name="PART_Check"
                    Width="{DynamicResource AxCheckboxSize}"
                    Height="{DynamicResource AxCheckboxSize}"
                    Data="M 3.5 8.5 L 6.5 11.5 L 12.5 4.5"
                    Stroke="{DynamicResource AxOnAccBrush}"
                    StrokeThickness="{DynamicResource AxIconStrokeThickness}"
                    StrokeLineCap="Round"
                    StrokeJoin="Round"
                    IsVisible="False"/>
              <Path x:Name="PART_Dash"
                    Width="{DynamicResource AxCheckboxSize}"
                    Height="{DynamicResource AxCheckboxSize}"
                    Data="M 4.5 8 L 11.5 8"
                    Stroke="{DynamicResource AxOnAccBrush}"
                    StrokeThickness="{DynamicResource AxIconStrokeThickness}"
                    StrokeLineCap="Round"
                    IsVisible="False"/>
            </Panel>
            <ContentPresenter Grid.Column="1"
                              Margin="5,0,0,0"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True"
                              IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}"/>
          </Grid>
        </Panel>
      </ControlTemplate>
    </Setter>

    <!--
        Заливка флажка остаётся AxAcc, не AxAccStrong: белой галочке довольно
        3:1 (приёмка, раздел 6 — «AxAcc остаётся флажкам»).
    -->
    <Style Selector="^:checked /template/ Border#PART_Box">
      <Setter Property="Background" Value="{DynamicResource AxAccBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="^:checked /template/ Path#PART_Check">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="^:checked:pointerover /template/ Border#PART_Box">
      <Setter Property="Background" Value="{DynamicResource AxAccHoverBrush}"/>
    </Style>
    <Style Selector="^:indeterminate /template/ Border#PART_Box">
      <Setter Property="Background" Value="{DynamicResource AxAccBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="^:indeterminate /template/ Path#PART_Dash">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="^:indeterminate:pointerover /template/ Border#PART_Box">
      <Setter Property="Background" Value="{DynamicResource AxAccHoverBrush}"/>
    </Style>

    <!-- Проблема ввода: рамка и фон коробки говорят о ней и без текста рядом. -->
    <Style Selector="^.error /template/ Border#PART_Box">
      <Setter Property="BorderBrush" Value="{DynamicResource AxOutlineErrorBrush}"/>
      <Setter Property="Background" Value="{DynamicResource AxErrorBackgroundBrush}"/>
    </Style>
    <Style Selector="^.error:checked /template/ Border#PART_Box">
      <Setter Property="Background" Value="{DynamicResource AxRedBrush}"/>
    </Style>
    <Style Selector="^:pointerover /template/ Border#PART_Box">
      <Setter Property="BorderBrush" Value="{DynamicResource AxFg2Brush}"/>
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource AxFgDisabledBrush}"/>
      <Setter Property="Cursor" Value="Arrow"/>
    </Style>
    <Style Selector="^:disabled /template/ Border#PART_Box">
      <Setter Property="Background" Value="{DynamicResource AxInpDisabledBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AxBrdBrush}"/>
    </Style>
    <Style Selector="^:disabled:checked /template/ Border#PART_Box, ^:disabled:indeterminate /template/ Border#PART_Box">
      <Setter Property="Background" Value="{DynamicResource AxBg4Brush}"/>
    </Style>
  </ControlTheme>

</ResourceDictionary>
