<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ax="using:ArxisStudio.Controls">

  <!-- Плитка с инициалами 36×36; класс round — круглая (пользователь, собеседник). -->
  <ControlTheme x:Key="{x:Type ax:AxAvatar}" TargetType="ax:AxAvatar">
    <Setter Property="Width" Value="36"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadiusLarge}"/>
    <Setter Property="TileBrush" Value="{DynamicResource AxAccStrongBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AxOnAccBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource AxFontSizeSmall}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding TileBrush}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <TextBlock Text="{TemplateBinding Initials}"
                     Foreground="{TemplateBinding Foreground}"
                     FontSize="{TemplateBinding FontSize}"
                     FontWeight="{TemplateBinding FontWeight}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^.round">
      <Setter Property="CornerRadius" Value="1000"/>
    </Style>
  </ControlTheme>

  <!-- Контурная иконка 16×16: обводка Foreground, класс/свойство IsFilled — заливка. -->
  <ControlTheme x:Key="{x:Type ax:AxIcon}" TargetType="ax:AxIcon">
    <Setter Property="Width" Value="{DynamicResource AxIconSize}"/>
    <Setter Property="Height" Value="{DynamicResource AxIconSize}"/>
    <Setter Property="StrokeThickness" Value="{DynamicResource AxIconStrokeThickness}"/>
    <Setter Property="Foreground" Value="{DynamicResource AxFg2Brush}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <!--
            Клетка 16×16 обязана быть здесь явно.

            Viewbox подгоняет под рамку то, что намерил ребёнок, и без клетки
            он мерил границы самого пути: плюс 9×9 раздувался до 13×13, дуга
            спиннера — в два с половиной раза, а обводка 1.2 росла вместе с
            ними. Заодно каждый глиф садился по центру своих границ, а не по
            центру клетки, — потому и «не отцентровано».

            Canvas не растягивает ребёнка и не сдвигает его выравниванием:
            путь рисуется там, где сказано его координатами, ровно как в
            viewBox="0 0 16 16" дизайн-проекта. Масштаб остаётся один на все
            иконки и меняется только вместе с размером самой иконки.
        -->
        <Viewbox Stretch="Uniform">
          <Canvas Width="{DynamicResource AxIconSize}" Height="{DynamicResource AxIconSize}">
            <Path x:Name="PART_Path"
                  Data="{TemplateBinding Data}"
                  Stroke="{TemplateBinding Foreground}"
                  StrokeThickness="{TemplateBinding StrokeThickness}"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"/>
          </Canvas>
        </Viewbox>
      </ControlTemplate>
    </Setter>

    <Style Selector="^[IsFilled=True] /template/ Path#PART_Path">
      <Setter Property="Fill" Value="{Binding $parent[ax:AxIcon].Foreground}"/>
      <Setter Property="Stroke" Value="{x:Null}"/>
    </Style>

    <!-- Мелкий шеврон в тесной строке — единственное отступление от 16. -->
    <Style Selector="^.small">
      <Setter Property="Width" Value="12"/>
      <Setter Property="Height" Value="12"/>
    </Style>
  </ControlTheme>

</ResourceDictionary>
