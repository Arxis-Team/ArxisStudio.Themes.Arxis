<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ax="https://github.com/Arxis-Team/ArxisStudio">

  <!-- Плитка с инициалами 36×36; Shape=Circle — круглая (пользователь, собеседник). -->
  <ControlTheme x:Key="{x:Type ax:AxAvatar}" TargetType="ax:AxAvatar">
    <Setter Property="Width" Value="{DynamicResource AxAvatarSize}"/>
    <Setter Property="Height" Value="{DynamicResource AxAvatarSize}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadiusLarge}"/>
    <Setter Property="TileBrush" Value="{DynamicResource AxAccentFillBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AxTextOnAccentBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource AxFontSizeSmall}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Template">
      <ControlTemplate>
        <!--
            Инициалы вписываются в плитку, а не срезаются ею. Плитка — картинка
            постоянного размера, а кегль инициалов идёт за шкалой темы: вырасти
            он вдвое, и «FF» в плитке двадцать два на двадцать два потеряли бы
            половину букв. Viewbox только уменьшает — в обычном кегле инициалы
            стоят как стояли.
        -->
        <Border Background="{TemplateBinding TileBrush}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <Viewbox StretchDirection="DownOnly" Margin="{DynamicResource AxSpaceHairThickness}">
            <TextBlock Text="{TemplateBinding Initials}"
                       Foreground="{TemplateBinding Foreground}"
                       FontSize="{TemplateBinding FontSize}"
                       FontWeight="{TemplateBinding FontWeight}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
          </Viewbox>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:circle">
      <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadiusPill}"/>
    </Style>

    <!--
        Цветные монограммы не ставят на AxTintOrange / AxSuccess / AxTintPurple / AxError: белые
        инициалы дают там в тёмной теме 2,50…3,44:1.
        Цвета Tint берут роли монограмм, где белый держит 5,9:1 и выше, — и берут их
        отсюда, а не с места: цвет плитки монограммы решает не потребитель.
    -->
    <Style Selector="^:orange">
      <Setter Property="TileBrush" Value="{DynamicResource AxMonogramOrangeBrush}"/>
    </Style>
    <Style Selector="^:green">
      <Setter Property="TileBrush" Value="{DynamicResource AxMonogramGreenBrush}"/>
    </Style>
    <Style Selector="^:purple">
      <Setter Property="TileBrush" Value="{DynamicResource AxMonogramPurpleBrush}"/>
    </Style>
    <Style Selector="^:red">
      <Setter Property="TileBrush" Value="{DynamicResource AxMonogramRedBrush}"/>
    </Style>
  </ControlTheme>

  <!--
      Контурная иконка 16×16: обводка Foreground; силуэт (:filled) — заливка.

      Срез плоский и стык острый, а не скруглённые. Набор нарисован под
      пиксель: концы штрихов стоят на границах пикселей, углы — в их центрах.
      Скруглённый срез вытягивал бы каждый конец на 0.6 в соседний пиксель
      полупрозрачным хвостом, а скруглённый стык срезал бы угол рамки — на
      16 px это читалось не как скругление, а как мутный контур.
  -->
  <ControlTheme x:Key="{x:Type ax:AxIcon}" TargetType="ax:AxIcon">
    <Setter Property="Width" Value="{DynamicResource AxIconSize}"/>
    <Setter Property="Height" Value="{DynamicResource AxIconSize}"/>
    <Setter Property="StrokeThickness" Value="{DynamicResource AxIconStrokeThickness}"/>
    <Setter Property="Foreground" Value="{DynamicResource AxTextSecondaryBrush}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <!--
            Клетка 16×16 обязана быть здесь явно.

            Viewbox подгоняет под рамку то, что намерил ребёнок, и без клетки
            он мерил границы самого пути: плюс 9×9 раздувался до 13×13, дуга
            спиннера — в два с половиной раза, а обводка 1.2 росла вместе с
            ними. Заодно каждый глиф садился по центру своих границ, а не по
            центру клетки, — потому и «не отцентровано».

            Canvas не растягивает ребёнка и не сдвигает его выравниванием:
            путь рисуется там, где сказано его координатами, ровно как в
            viewBox="0 0 16 16" исходного SVG. Масштаб остаётся один на все
            иконки и меняется только вместе с размером самой иконки.

            Клетка — свой ключ AxIconGrid, а не AxIconSize, и это не
            недосмотр: клетка — система координат, в которой нарисованы пути, а
            AxIconSize — размер, которым иконку показывают. Совпадают они сегодня
            и расходятся завтра, и тогда Viewbox начнёт вписывать клетку в клетку
            вместо рисунка в рамку: при размере 24 путь занял бы шестнадцать
            единиц в углу двадцатичетырёх, а не всю рамку.
        -->
        <Viewbox Stretch="Uniform">
          <Canvas Width="{DynamicResource AxIconGrid}" Height="{DynamicResource AxIconGrid}">
            <Path x:Name="PART_Path"
                  Data="{TemplateBinding Data}"
                  Stroke="{TemplateBinding Foreground}"
                  StrokeThickness="{TemplateBinding StrokeThickness}"
                  StrokeLineCap="Flat"
                  StrokeJoin="Miter"/>
          </Canvas>
        </Viewbox>
      </ControlTemplate>
    </Setter>

    <!--
        Силуэт ставит сам контрол: путь набора, нарисованный силуэтом, или путь,
        которому хозяин сказал IsFilled.
    -->
    <Style Selector="^:filled /template/ Path#PART_Path">
      <Setter Property="Fill" Value="{Binding $parent[ax:AxIcon].Foreground}"/>
      <Setter Property="Stroke" Value="{x:Null}"/>
    </Style>

    <!-- Мелкий шеврон в тесной строке — единственное отступление от 16. -->
    <Style Selector="^:small">
      <Setter Property="Width" Value="{DynamicResource AxIconSizeSmall}"/>
      <Setter Property="Height" Value="{DynamicResource AxIconSizeSmall}"/>
    </Style>
  </ControlTheme>

</ResourceDictionary>
