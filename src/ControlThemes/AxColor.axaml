<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ax="https://github.com/Arxis-Team/ArxisStudio"
                    xmlns:t="using:ArxisStudio.Themes.Arxis">

  <!--
      Выбор цвета: спектр, ползунок канала, кольцо оттенков, сам выбор и поле цвета. Цвета градиентов — данные
      модели HSV, их ставят контролы; тема даёт рамки, скругления, ручку, шахматку под прозрачным и раскладку окна.
  -->

  <!--
      Ручка спектра и ползунка — белое кольцо в тёмной кайме: видна на любом цвете, от белого до чёрного. В
      самой ручке цвета нет — смотрят сквозь неё, на то место, куда она указала.
  -->
  <ControlTheme x:Key="AxColorThumb" TargetType="Border">
    <Setter Property="Width" Value="{DynamicResource AxSliderThumbSize}"/>
    <Setter Property="Height" Value="{DynamicResource AxSliderThumbSize}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadiusPill}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AxColorThumbOutlineBrush}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource AxHairlineThickness}"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Child">
      <Template>
        <Border CornerRadius="{DynamicResource AxCornerRadiusPill}"
                BorderBrush="{DynamicResource AxColorThumbBrush}"
                BorderThickness="{DynamicResource AxFocusOutlineThickness}"/>
      </Template>
    </Setter>
  </ControlTheme>

  <!--
      Спектр: насыщенность слева направо, яркость сверху вниз — два градиента, обрезанных скруглением. Рамка
      в волос поверх них, а с клавиатуры она красится цветом кольца и вместе с кольцом даёт контур в два, как у
      поля ввода. Выключенный спектр закрыт заливкой выключенного: цвета на нём уже не выбрать.
  -->
  <ControlTheme x:Key="{x:Type ax:AxColorSpectrum}" TargetType="ax:AxColorSpectrum">
    <!-- Не обрезаем себя: ручка у края и кольцо фокуса выходят за границы. -->
    <Setter Property="ClipToBounds" Value="False"/>
    <Setter Property="Height" Value="{DynamicResource AxColorSpectrumHeight}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadius}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AxStrokeSubtleBrush}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource AxHairlineThickness}"/>
    <Setter Property="AutomationProperties.Name" Value="{DynamicResource AxTextColorSpectrum}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <t:AxFocusRing x:Name="PART_FocusRing"/>
          <Border CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
            <Panel>
              <Border x:Name="PART_Saturation"/>
              <Border x:Name="PART_Shade"/>
              <Border x:Name="PART_Disabled" Background="{DynamicResource AxFillDisabledBrush}" IsVisible="False"/>
            </Panel>
          </Border>
          <Border x:Name="PART_Frame"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  IsHitTestVisible="False"/>
          <Canvas IsHitTestVisible="False">
            <Border x:Name="PART_Thumb" Theme="{StaticResource AxColorThumb}"/>
          </Canvas>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:focus-visible /template/ t|AxFocusRing#PART_FocusRing">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Frame">
      <Setter Property="BorderBrush" Value="{DynamicResource AxFocusRingBrush}"/>
    </Style>
    <Style Selector="^:disabled /template/ Border#PART_Disabled">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="^:disabled /template/ Border#PART_Thumb">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
  </ControlTheme>

  <!--
      Ползунок канала: дорожка-пилюля под ручкой, градиент канала по ней, а у непрозрачности под градиентом —
      шахматка (:alpha), иначе прозрачный конец не отличить от фона. Кольцо — вокруг строки, как у ползунка.
  -->
  <ControlTheme x:Key="{x:Type ax:AxColorSlider}" TargetType="ax:AxColorSlider">
    <!-- Не обрезаем себя: ручка у края и кольцо фокуса выходят за границы. -->
    <Setter Property="ClipToBounds" Value="False"/>
    <Setter Property="Height" Value="{DynamicResource AxSliderThumbSize}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadiusPill}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <t:AxFocusRing x:Name="PART_FocusRing" Placement="Row"/>
          <Border Height="{DynamicResource AxColorTrackHeight}"
                  VerticalAlignment="Center"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  ClipToBounds="True">
            <Panel>
              <Border x:Name="PART_Checker" Background="{DynamicResource AxCheckerPattern}" IsVisible="False"/>
              <Border x:Name="PART_Gradient"/>
              <Border x:Name="PART_Disabled" Background="{DynamicResource AxFillDisabledBrush}" IsVisible="False"/>
            </Panel>
          </Border>
          <Canvas IsHitTestVisible="False">
            <Border x:Name="PART_Thumb" Theme="{StaticResource AxColorThumb}"/>
          </Canvas>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:alpha /template/ Border#PART_Checker">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="^:focus-visible /template/ t|AxFocusRing#PART_FocusRing">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="^:disabled /template/ Border#PART_Disabled">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="^:disabled /template/ Border#PART_Thumb">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
  </ControlTheme>

  <!--
      Кольцо оттенков, как у Unity, рисует себя само (AxColorWheel.Render): тема даёт толщину кольца и ручку — светлое
      кольцо в тёмной кайме, той же пары и тех же толщин, что у ручки спектра. Фокус клавиатуры — окружность вокруг
      кольца цветом кольца фокуса; выключенное кольцо закрыто заливкой выключенного, и ручки на нём нет.
  -->
  <ControlTheme x:Key="{x:Type ax:AxColorWheel}" TargetType="ax:AxColorWheel">
    <!-- Не обрезаем себя: кольцо фокуса выходит за границы. -->
    <Setter Property="ClipToBounds" Value="False"/>
    <Setter Property="RingThickness" Value="{DynamicResource AxColorWheelRingThickness}"/>
    <Setter Property="ThumbBrush" Value="{DynamicResource AxColorThumbBrush}"/>
    <Setter Property="ThumbOutlineBrush" Value="{DynamicResource AxColorThumbOutlineBrush}"/>
    <Setter Property="ThumbThickness" Value="{DynamicResource AxFocusOutlineWidth}"/>
    <Setter Property="ThumbOutlineThickness" Value="{DynamicResource AxHairline}"/>
    <Setter Property="AutomationProperties.Name" Value="{DynamicResource AxTextColorHue}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Ellipse x:Name="PART_Disabled"
                   Stroke="{DynamicResource AxFillDisabledBrush}"
                   StrokeThickness="{TemplateBinding RingThickness}"
                   IsHitTestVisible="False"
                   IsVisible="False"/>
          <Ellipse x:Name="PART_FocusRing"
                   Margin="{DynamicResource AxFocusOutlineRowMargin}"
                   Stroke="{DynamicResource AxFocusRingBrush}"
                   StrokeThickness="{DynamicResource AxFocusOutlineWidth}"
                   IsHitTestVisible="False"
                   IsVisible="False"/>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:focus-visible /template/ Ellipse#PART_FocusRing">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="ThumbBrush" Value="{x:Null}"/>
      <Setter Property="ThumbOutlineBrush" Value="{x:Null}"/>
    </Style>
    <Style Selector="^:disabled /template/ Ellipse#PART_Disabled">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
  </ControlTheme>

  <!--
      Образец «было» в окне цвета — кнопка без своей рамки и заливки: рамку держит полоса образцов, а цвет под
      наведением остаётся цветом. Кольцо фокуса — как у всякой кнопки.
  -->
  <ControlTheme x:Key="AxColorOriginalButton" TargetType="ax:AxButton"
                BasedOn="{StaticResource {x:Type ax:AxButton}}">
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>

    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
  </ControlTheme>

  <!--
      Ячейка палитры и образца — кнопка размером AxColorPresetCellSize: цвет на шахматке в рамке в волос, наведение
      усиливает рамку, а не заливает ячейку — цвет под ним остаётся цветом. Кольцо фокуса — как у всякой кнопки.
  -->
  <ControlTheme x:Key="AxColorPresetCell" TargetType="ax:AxButton"
                BasedOn="{StaticResource {x:Type ax:AxButton}}">
    <Setter Property="Width" Value="{DynamicResource AxColorPresetCellSize}"/>
    <Setter Property="Height" Value="{DynamicResource AxColorPresetCellSize}"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AxStrokeControlBrush}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource AxHairlineThickness}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>

    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AxStrokeStrongBrush}"/>
    </Style>
    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
  </ControlTheme>

  <!--
      Строка образца в виде списком: ячейка цвета размером AxColorPresetCellSize и имя во всю ширину, наведение заливает
      строку, как строку меню. Ячейку в строке размеряет контрол ключами темы: она — содержимое, а не часть шаблона.
  -->
  <ControlTheme x:Key="AxColorPresetRow" TargetType="ax:AxButton"
                BasedOn="{StaticResource {x:Type ax:AxButton}}">
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="{DynamicResource AxControlHeightCompact}"/>
    <Setter Property="Padding" Value="{DynamicResource AxSpaceTightSidesThickness}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </ControlTheme>

  <!--
      Выбор цвета — окно Color у Unity: сверху пипетка и полоса образцов «стало | было», под ними кольцо оттенков с
      квадратом насыщенности и яркости внутри, справа выбор вида каналов, ползунки каналов с числами и код — шесть
      цифр, моноширинным: это значение, а не подпись. Строка прозрачности есть, только если цвет бывает прозрачным.
      Ниже — раскрывающиеся «Палитра» и «Образцы»: ячейки ставит контрол, тема даёт им панели — сетку с зазором в волос
      и список; раздел образцов есть, только когда хозяин дал хранилище (:presets), а имя образца и библиотеки
      спрашивает всплывающее поле. Сетки ячеек — шириной AxColorPaletteWidth, ровно двенадцать в ряд, а список — не шире
      выбора: окно меряет выбор по содержимому, и сетка без предела встала бы одной строкой во всю палитру.
      Ширина — наименьшая, а не прибитая: с крупным текстом подпись кода и выбор вида раздвигают окно, а не выталкивают
      поле за край.
  -->
  <ControlTheme x:Key="{x:Type ax:AxColorPicker}" TargetType="ax:AxColorPicker">
    <Setter Property="ClipToBounds" Value="False"/>
    <Setter Property="MinWidth" Value="{DynamicResource AxColorPickerWidth}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Spacing="{DynamicResource AxSpace}">
          <DockPanel>
            <ax:AxButton x:Name="PART_Eyedropper"
                         DockPanel.Dock="Left"
                         Theme="{StaticResource AxInlineIconButton}"
                         Margin="{DynamicResource AxSpaceSnugTrailingThickness}"
                         AutomationProperties.Name="{DynamicResource AxTextColorEyedropper}"
                         ToolTip.Tip="{DynamicResource AxTextColorEyedropper}">
              <ax:AxIcon Data="{x:Static ax:AxIcons.Eyedropper}"/>
            </ax:AxButton>
            <Border MinHeight="{DynamicResource AxControlHeightCompact}"
                    Padding="{DynamicResource AxColorSwatchInset}"
                    Background="{DynamicResource AxSurfaceBaseBrush}"
                    BorderBrush="{DynamicResource AxStrokeControlBrush}"
                    BorderThickness="{DynamicResource AxHairlineThickness}"
                    CornerRadius="{DynamicResource AxCornerRadiusSmall}">
              <Grid ColumnDefinitions="*,*">
                <ax:AxColorSwatch x:Name="PART_New"/>
                <ax:AxButton x:Name="PART_Original"
                             Grid.Column="1"
                             Theme="{StaticResource AxColorOriginalButton}"
                             AutomationProperties.Name="{DynamicResource AxTextColorOriginal}"
                             ToolTip.Tip="{DynamicResource AxTextColorOriginal}">
                  <ax:AxColorSwatch x:Name="PART_OriginalSwatch"/>
                </ax:AxButton>
              </Grid>
            </Border>
          </DockPanel>

          <Panel Width="{DynamicResource AxColorWheelSize}"
                 Height="{DynamicResource AxColorWheelSize}"
                 HorizontalAlignment="Center">
            <ax:AxColorWheel x:Name="PART_Wheel"/>
            <ax:AxColorSpectrum x:Name="PART_Spectrum"
                                Width="{DynamicResource AxColorWheelSquare}"
                                Height="{DynamicResource AxColorWheelSquare}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
          </Panel>

          <ax:AxComboBox x:Name="PART_Mode"
                         Size="Compact"
                         HorizontalAlignment="Right"
                         AutomationProperties.Name="{DynamicResource AxTextColorMode}">
            <ax:AxComboBoxItem Content="{DynamicResource AxTextColorModeRgb255}"/>
            <ax:AxComboBoxItem Content="{DynamicResource AxTextColorModeRgb1}"/>
            <ax:AxComboBoxItem Content="{DynamicResource AxTextColorModeHsv}"/>
          </ax:AxComboBox>

          <Grid ColumnDefinitions="Auto,*,Auto"
                RowDefinitions="Auto,Auto,Auto,Auto"
                ColumnSpacing="{DynamicResource AxSpace}"
                RowSpacing="{DynamicResource AxSpaceTight}">
            <TextBlock x:Name="PART_Label0" VerticalAlignment="Center" ax:AxText.Tone="Secondary"/>
            <ax:AxColorSlider x:Name="PART_Slider0" Grid.Column="1"
                              AutomationProperties.LabeledBy="{Binding #PART_Label0}"/>
            <ax:AxNumberField x:Name="PART_Number0" Grid.Column="2" Size="Compact"
                              Width="{DynamicResource AxColorChannelNumberWidth}"
                              AutomationProperties.LabeledBy="{Binding #PART_Label0}"/>

            <TextBlock x:Name="PART_Label1" Grid.Row="1" VerticalAlignment="Center" ax:AxText.Tone="Secondary"/>
            <ax:AxColorSlider x:Name="PART_Slider1" Grid.Row="1" Grid.Column="1"
                              AutomationProperties.LabeledBy="{Binding #PART_Label1}"/>
            <ax:AxNumberField x:Name="PART_Number1" Grid.Row="1" Grid.Column="2" Size="Compact"
                              Width="{DynamicResource AxColorChannelNumberWidth}"
                              AutomationProperties.LabeledBy="{Binding #PART_Label1}"/>

            <TextBlock x:Name="PART_Label2" Grid.Row="2" VerticalAlignment="Center" ax:AxText.Tone="Secondary"/>
            <ax:AxColorSlider x:Name="PART_Slider2" Grid.Row="2" Grid.Column="1"
                              AutomationProperties.LabeledBy="{Binding #PART_Label2}"/>
            <ax:AxNumberField x:Name="PART_Number2" Grid.Row="2" Grid.Column="2" Size="Compact"
                              Width="{DynamicResource AxColorChannelNumberWidth}"
                              AutomationProperties.LabeledBy="{Binding #PART_Label2}"/>

            <TextBlock x:Name="PART_LabelA" Grid.Row="3" VerticalAlignment="Center" ax:AxText.Tone="Secondary"
                       IsVisible="{TemplateBinding AllowsAlpha}"/>
            <ax:AxColorSlider x:Name="PART_SliderA" Grid.Row="3" Grid.Column="1"
                              IsVisible="{TemplateBinding AllowsAlpha}"
                              AutomationProperties.Name="{DynamicResource AxTextColorAlpha}"/>
            <ax:AxNumberField x:Name="PART_NumberA" Grid.Row="3" Grid.Column="2" Size="Compact"
                              Width="{DynamicResource AxColorChannelNumberWidth}"
                              IsVisible="{TemplateBinding AllowsAlpha}"
                              AutomationProperties.Name="{DynamicResource AxTextColorAlpha}"/>
          </Grid>

          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Spacing="{DynamicResource AxSpace}">
            <TextBlock Text="{DynamicResource AxTextColorCode}" VerticalAlignment="Center" ax:AxText.Tone="Secondary"/>
            <ax:AxTextBox x:Name="PART_Hex"
                          Size="Compact"
                          Width="{DynamicResource AxColorHexWidth}"
                          FontFamily="{DynamicResource AxFontFamilyMono}"
                          AutomationProperties.Name="{DynamicResource AxTextColorCode}"/>
          </StackPanel>

          <StackPanel Spacing="{DynamicResource AxSpaceTight}">
            <ax:AxGroupHeader x:Name="PART_PaletteHeader"
                              Content="{DynamicResource AxTextColorPalette}"
                              IsCollapsible="True"
                              IsExpanded="{Binding IsPaletteExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
            <WrapPanel x:Name="PART_Palette"
                       MaxWidth="{DynamicResource AxColorPaletteWidth}"
                       HorizontalAlignment="Left"
                       ItemSpacing="{DynamicResource AxSpaceHair}"
                       LineSpacing="{DynamicResource AxSpaceHair}"
                       IsVisible="{TemplateBinding IsPaletteExpanded}"/>
          </StackPanel>

          <StackPanel x:Name="PART_PresetsSection" Spacing="{DynamicResource AxSpaceTight}" IsVisible="False">
            <DockPanel>
              <ax:AxButton x:Name="PART_PresetsMenu"
                           DockPanel.Dock="Right"
                           Theme="{StaticResource AxInlineIconButton}"
                           AutomationProperties.Name="{DynamicResource AxTextColorPresetsMenu}"
                           ToolTip.Tip="{DynamicResource AxTextColorPresetsMenu}">
                <ax:AxIcon Data="{x:Static ax:AxIcons.MoreVertical}"/>
              </ax:AxButton>
              <!-- Имя образца или библиотеки: попап места не занимает, а живёт там, где есть всегда, пока есть образцы. -->
              <Popup x:Name="PART_NamePopup"
                     Placement="BottomEdgeAlignedLeft"
                     IsLightDismissEnabled="True">
                <Border Background="{DynamicResource AxSurfaceOverlayBrush}"
                        BorderBrush="{DynamicResource AxStrokeControlBrush}"
                        BorderThickness="{DynamicResource AxHairlineThickness}"
                        CornerRadius="{DynamicResource AxCornerRadiusLarge}"
                        BoxShadow="{DynamicResource AxShadowPopup}"
                        Padding="{DynamicResource AxSpaceThickness}"
                        Margin="{DynamicResource AxPopupShadowRoom}">
                  <StackPanel Spacing="{DynamicResource AxSpaceTight}" Width="{DynamicResource AxColorPresetNameWidth}">
                    <TextBlock x:Name="PART_NameLabel" ax:AxText.Tone="Secondary"/>
                    <ax:AxTextBox x:Name="PART_Name" Size="Compact"/>
                  </StackPanel>
                </Border>
              </Popup>
              <ax:AxGroupHeader x:Name="PART_PresetsHeader"
                                Content="{DynamicResource AxTextColorPresets}"
                                IsCollapsible="True"
                                IsExpanded="{Binding ArePresetsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
            </DockPanel>
            <Panel MaxWidth="{DynamicResource AxColorPickerWidth}"
                   HorizontalAlignment="Left"
                   IsVisible="{TemplateBinding ArePresetsExpanded}">
              <WrapPanel x:Name="PART_PresetGrid"
                         MaxWidth="{DynamicResource AxColorPaletteWidth}"
                         HorizontalAlignment="Left"
                         ItemSpacing="{DynamicResource AxSpaceHair}"
                         LineSpacing="{DynamicResource AxSpaceHair}"/>
              <StackPanel x:Name="PART_PresetList" Spacing="{DynamicResource AxSpaceHair}" IsVisible="False"/>
            </Panel>
          </StackPanel>

        </StackPanel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:presets /template/ StackPanel#PART_PresetsSection">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="^:list /template/ WrapPanel#PART_PresetGrid">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="^:list /template/ StackPanel#PART_PresetList">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
  </ControlTheme>

  <!--
      Образец цвета рисует себя сам (AxColorSwatch.Render): доля непрозрачности ставит ширину белой части полоски, а
      шаблону нечем перевести число в ширину. Тема даёт ему кисти и высоту полоски: белое — непрозрачность, чёрное —
      остаток, как у Unity; «нет цвета» — шахматка, перечёркнутая цветом ошибки.
  -->
  <ControlTheme x:Key="{x:Type ax:AxColorSwatch}" TargetType="ax:AxColorSwatch">
    <Setter Property="AlphaBarHeight" Value="{DynamicResource AxColorAlphaBarHeight}"/>
    <Setter Property="AlphaFillBrush" Value="{DynamicResource AxColorAlphaFillBrush}"/>
    <Setter Property="AlphaEmptyBrush" Value="{DynamicResource AxColorAlphaEmptyBrush}"/>
    <Setter Property="CheckerBrush" Value="{DynamicResource AxCheckerPattern}"/>
    <Setter Property="NoneBrush" Value="{DynamicResource AxErrorBrush}"/>
    <Setter Property="NoneThickness" Value="{DynamicResource AxColorNoneThickness}"/>
  </ControlTheme>

  <!--
      Полоса поля цвета — кнопка с рамкой поля и зазором до цвета (AxColorSwatchInset): белый не сливается со светлой
      рамкой, тёмный — с тёмной. Наведение не заливает полосу — цвет под ним остаётся цветом, — а усиливает рамку;
      кольцо фокуса — как у всякой кнопки.
  -->
  <ControlTheme x:Key="AxColorSwatchButton" TargetType="ax:AxButton"
                BasedOn="{StaticResource {x:Type ax:AxButton}}">
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="{DynamicResource AxControlHeight}"/>
    <Setter Property="Padding" Value="{DynamicResource AxColorSwatchInset}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadiusSmall}"/>
    <Setter Property="Background" Value="{DynamicResource AxSurfaceBaseBrush}"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>

    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AxSurfaceBaseBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AxStrokeStrongBrush}"/>
    </Style>
    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AxSurfaceBaseBrush}"/>
    </Style>
  </ControlTheme>

  <!--
      Поле цвета, как у Unity: полоса цвета во всю ширину — кнопка, которая открывает окно «Цвет», — с полоской
      прозрачности снизу, и справа пипетка. Текста в поле нет: код набирают в окне, а диктору и подсказке поле отдаёт
      код (ColorText). У разных значений на месте цвета — прочерк, у кисти, которой нет, — перечёркнутая шахматка.
      Попапа в шаблоне нет: без него поле открывает выбор отдельным окном.
  -->
  <ControlTheme x:Key="{x:Type ax:AxColorField}" TargetType="ax:AxColorField">
    <Setter Property="ClipToBounds" Value="False"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <DockPanel>
            <ax:AxButton x:Name="PART_Eyedropper"
                         DockPanel.Dock="Right"
                         Theme="{StaticResource AxInlineIconButton}"
                         Margin="{DynamicResource AxSpaceSnugLeadingThickness}"
                         IsVisible="{TemplateBinding ShowsEyedropper}"
                         IsEnabled="{Binding IsReadOnly, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static BoolConverters.Not}}"
                         AutomationProperties.Name="{DynamicResource AxTextColorEyedropper}"
                         ToolTip.Tip="{DynamicResource AxTextColorEyedropper}">
              <ax:AxIcon Data="{x:Static ax:AxIcons.Eyedropper}"/>
            </ax:AxButton>
            <ax:AxButton x:Name="PART_Swatch"
                         Theme="{StaticResource AxColorSwatchButton}"
                         IsEnabled="{Binding IsReadOnly, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static BoolConverters.Not}}"
                         AutomationProperties.Name="{DynamicResource AxTextColorChoose}"
                         AutomationProperties.HelpText="{TemplateBinding ColorText}"
                         ToolTip.Tip="{TemplateBinding ColorText}">
              <Panel>
                <ax:AxColorSwatch x:Name="PART_Color"
                                  Color="{TemplateBinding Color}"
                                  IsNone="{TemplateBinding IsNone}"/>
                <TextBlock x:Name="PART_Mixed"
                           Text="—"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsVisible="False"/>
              </Panel>
            </ax:AxButton>
          </DockPanel>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:compact /template/ ax|AxButton#PART_Swatch">
      <Setter Property="MinHeight" Value="{DynamicResource AxControlHeightCompact}"/>
    </Style>

    <!-- Разные значения: на месте цвета — прочерк, а подсказка и диктор говорят почему. -->
    <Style Selector="^:mixed /template/ ax|AxColorSwatch#PART_Color">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="^:mixed /template/ TextBlock#PART_Mixed">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="^:mixed /template/ ax|AxButton#PART_Swatch">
      <Setter Property="AutomationProperties.HelpText" Value="{DynamicResource AxTextMixedValues}"/>
      <Setter Property="ToolTip.Tip" Value="{DynamicResource AxTextMixedValues}"/>
    </Style>

    <!-- Нет цвета: шахматка перечёркнута, и так же её называют. -->
    <Style Selector="^:none /template/ ax|AxButton#PART_Swatch">
      <Setter Property="AutomationProperties.HelpText" Value="{DynamicResource AxTextColorNone}"/>
      <Setter Property="ToolTip.Tip" Value="{DynamicResource AxTextColorNone}"/>
    </Style>
  </ControlTheme>

</ResourceDictionary>
