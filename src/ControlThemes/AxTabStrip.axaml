<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ax="https://github.com/Arxis-Team/ArxisStudio">

  <!-- Полоса вкладок: ряд вкладок на фоне панели с разделителем снизу. -->
  <ControlTheme x:Key="{x:Type ax:AxTabStrip}" TargetType="ax:AxTabStrip">
    <Setter Property="Background" Value="{DynamicResource AxBg2Brush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AxBrdBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <!--
        Полоса вкладок документа скруглена сверху и прижата к краю: вкладки
        начинаются от самой границы, как в карточке проекта.
    -->
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadiusMediumTop}"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal"/>
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                ClipToBounds="True">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" Margin="{TemplateBinding Padding}"/>
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- Вкладки внутри шапки панели инструментов: без своего фона и рамки. -->
  <ControlTheme x:Key="AxToolWindowTabStrip" TargetType="ax:AxTabStrip"
                BasedOn="{StaticResource {x:Type ax:AxTabStrip}}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
    <!--
        В шапке панели вкладки стоят вплотную — так их размечает карточка
        «Заголовок панели», и так же идут вкладки редактора. Зазор 4 остаётся
        обычным вкладкам, которые стоят отдельной строкой над содержимым.
    -->
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal"/>
      </ItemsPanelTemplate>
    </Setter>
    <!--
        Вкладка тянется на всю шапку: полоса выбора обязана лечь на её нижний
        край, вплотную к линии под шапкой. Своя высота 34 оставила бы её
        висеть посреди тридцати восьми.
    -->
    <Setter Property="ItemContainerTheme">
      <ControlTheme TargetType="ax:AxTabItem" BasedOn="{StaticResource {x:Type ax:AxTabItem}}">
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <!--
            Высоту снимает стиль по тому же классу, а не сеттер: своя высота у
            compact объявлена стилем базовой темы, и сеттер производной ей не
            указ. Оставь её — вкладка переживёт шапку: карточные тридцать два
            при шапке в тридцать уходят вверх на два пикселя, нижний пиксель
            полосы выбора прячется под разделителем, и от трёх остаётся два.
        -->
        <Style Selector="^.compact">
          <Setter Property="Height" Value="NaN"/>
          <Setter Property="MinHeight" Value="0"/>
        </Style>
        <!--
            Выбранной вкладку в шапке делает одна полоса: своего фона у неё
            нет. Фон остаётся вкладке редактора, где ряд имён стоит на общей
            подложке и выбранное имя поднимается над ней белым.
        -->
        <Style Selector="^:selected /template/ Border#PART_Root">
          <Setter Property="Background" Value="Transparent"/>
        </Style>
      </ControlTheme>
    </Setter>
  </ControlTheme>

  <!--
      Вкладка: 36 высотой, активная подчёркнута акцентной полосой снизу.
      Кнопка закрытия проявляется на наведении и у активной вкладки; точка
      вместо крестика означает несохранённые правки.
  -->
  <ControlTheme x:Key="{x:Type ax:AxTabItem}" TargetType="ax:AxTabItem">
    <!--
        34, а не 36: столько даёт и витрина проекта для вкладок редактора, и
        макеты экранов. Лишние два пикселя разъезжались со строкой заголовка,
        рядом с которой вкладка и стоит.

        Высота наименьшая, а не прибитая: имя вкладки растёт с кеглем темы. По
        центру — чтобы в ячейке выше себя вкладка вставала там же, где вставала
        прибитая. Вкладка в шапке панели растягивается своей темой выше.
    -->
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <!--
        Восемь — число раздела 3 спецификации: «отступы вкладок 8px, промежуток
        до крестика 8px». Десять стояли здесь с первой вёрстки и не значили
        ничего, кроме лишней ширины у каждой вкладки в ряду.
    -->
    <Setter Property="Padding" Value="{DynamicResource AxRowPadding}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource AxFg2Brush}"/>
    <!--
        Значок без своего цвета идёт за подписью — вторичный, основной у
        выбранной, выключенный у выключенной. Привязкой, а не тем же ключом:
        состояния меняют подпись стилями ниже, и ключ пришлось бы повторять в
        каждом. Данный вкладке цвет — локальное значение — сильнее сеттера.
        Раньше умолчания не было, и значок без цвета не рисовался вовсе.
    -->
    <Setter Property="IconBrush" Value="{Binding $self.Foreground}"/>
    <Setter Property="FontSize" Value="{DynamicResource AxFontSize}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <!--
        Шире места своей полосы вкладка не мерится — это правило контрола. Имя,
        которому тогда не хватает ширины, кончается многоточием, а целиком
        читается в подсказке, как у кнопки. Прежде одинокая вкладка в узкой
        панели при двойном кегле уходила за край: имя обрывалось на полуслове,
        крестик пропадал, а под шапкой вылезала полоса прокрутки.
    -->
    <Setter Property="ToolTip.Tip" Value=""/>
    <Setter Property="ax:AxTrimmedTip.IsEnabled" Value="True"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_Root"
                Background="{TemplateBinding Background}"
                Padding="{TemplateBinding Padding}">
          <Panel>
            <!--
                Наведение рисуется отдельной плашкой, а не фоном всей вкладки:
                вкладке в шапке панели нужен отступ от краёв, а отступ у
                PART_Root раздвинул бы соседей — ширина вкладки это её
                содержимое плюс поля. Плашка стоит первой в панели, значит под
                текстом, и невидима, пока её не покажет стиль.
            -->
            <Border x:Name="PART_Hover" IsVisible="False"/>
            <!--
                Док, а не стопка: в стопке имя получало бы бесконечную ширину и
                не сокращалось никогда. Крестик стоит у края, имя со значком
                берут остаток. Скрытому крестику док зазора не оставляет, как не
                оставляла стопка.
            -->
            <DockPanel HorizontalSpacing="{DynamicResource AxSpace}" VerticalAlignment="Center">
              <!--
                  Ловит мышь вся площадка, а не сам путь крестика: попасть по
                  линии в полтора пикселя человек не должен. Прозрачный фон
                  здесь и делает шестнадцать на шестнадцать нажимаемыми.

                  Border, а не Panel, и у него своё наведение: пока подсветки у
                  крестика не было, наведение на него выглядело точно так же,
                  как наведение на вкладку, и человек не видел, что сейчас
                  закроет её, а не выберет.
              -->
              <Border x:Name="PART_Close"
                      DockPanel.Dock="Right"
                      Width="16" Height="16"
                      CornerRadius="{DynamicResource AxCornerRadius}"
                      Background="Transparent"
                      IsVisible="{TemplateBinding IsClosable}">
                <Panel>
                  <Ellipse x:Name="PART_Modified"
                           Width="7" Height="7"
                           Fill="{DynamicResource AxAccBrush}"
                           IsVisible="{TemplateBinding IsModified}"/>
                  <!--
                      Крестик стоит на месте, а не появляется на наведении:
                      закрываемая вкладка так и выглядит в проекте. Уступает он
                      только точке несохранённых правок — и возвращается, когда
                      на вкладку наводят, чтобы её можно было закрыть.
                  -->
                  <ax:AxIcon x:Name="PART_CloseIcon"
                             Classes="small"
                             Data="{x:Static ax:AxIcons.Close}"
                             Foreground="{DynamicResource AxFg3Brush}"/>
                </Panel>
              </Border>
              <!--
                  Значок с именем — своим доком, а не в общем ряду. Значок и имя
                  — одна мысль, крестик — другое действие: общий зазор отодвинул
                  бы значок от имени так же далеко, как крестик, и вкладка
                  читалась бы тремя вещами вместо двух. Между значком и именем —
                  зазор значка и текста, как у строки дерева; скрытый значок
                  места не держит.

                  Клетка целая, 16, а не мелкая: набор нарисован в клетке 16, и
                  обводка ложится в пиксели только там, где клетка в них ложится.
                  Цвет — IconBrush, а его умолчание в сеттере темы идёт за
                  подписью: глиф панели своего цвета не несёт и красится, как
                  текст рядом, а тип документа красит свой значок сам.
              -->
              <DockPanel>
                <ax:AxIcon x:Name="PART_Icon"
                           DockPanel.Dock="Left"
                           Margin="{DynamicResource AxGapIconTextThickness}"
                           VerticalAlignment="Center"
                           Data="{TemplateBinding Icon}"
                           Foreground="{TemplateBinding IconBrush}"
                           IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <ContentPresenter Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Foreground="{TemplateBinding Foreground}"
                                  TextTrimming="CharacterEllipsis"
                                  VerticalAlignment="Center"/>
              </DockPanel>
            </DockPanel>
            <!--
                Полоса выбора идёт ровно во всю ширину вкладки: отрицательное
                поле снимает её собственные отступы. Раньше здесь стояло −12
                при отступах 10, и полоса на два пикселя залезала под соседку.
            -->
            <Border x:Name="PART_ActiveMarker"
                    Height="2"
                    VerticalAlignment="Bottom"
                    Margin="-8,0"
                    Background="{DynamicResource AxAccBrush}"
                    IsVisible="False"/>
            <!--
                Кольцо строки лежит внутри, а не снаружи, и это не мелочь. У
                кнопки оно вынесено наружу отрицательным полем — там вокруг
                есть место. Строка занимает всю ширину списка, и вынесенное
                кольцо срезал бы сам список: остались бы две вертикальные
                чёрточки по бокам. Толщина поэтому своя.

                Стоит последним, значит поверх заливки выделения: иначе
                выбранная строка в фокусе прятала бы кольцо под собой.
            -->
            <Border x:Name="PART_FocusRing"
                    BorderThickness="{DynamicResource AxFocusOutlineInset}"
                    BorderBrush="{DynamicResource AxOutlineFocusedBrush}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    IsVisible="False"/>
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True"/>
    </Style>

    <Style Selector="^:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource AxBg3Brush}"/>
    </Style>
    <Style Selector="^:pointerover /template/ ax|AxIcon#PART_CloseIcon">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="^:pointerover /template/ Ellipse#PART_Modified">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="^[IsModified=True] /template/ ax|AxIcon#PART_CloseIcon">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="^:selected /template/ ax|AxIcon#PART_CloseIcon">
      <Setter Property="Foreground" Value="{DynamicResource AxFg2Brush}"/>
    </Style>
    <!--
        У крестика своё наведение: ступенью заметнее, чем у самой вкладки, —
        AxBg4 против AxBg3. Без него наведение на крестик выглядело точь-в-точь
        как наведение на вкладку, и человек нажимал, не зная, закроет он её или
        выберет.
    -->
    <Style Selector="^ /template/ Border#PART_Close:pointerover">
      <Setter Property="Background" Value="{DynamicResource AxBg4Brush}"/>
    </Style>
    <Style Selector="^ /template/ Border#PART_Close:pointerover ax|AxIcon#PART_CloseIcon">
      <Setter Property="Foreground" Value="{DynamicResource AxFgBrush}"/>
    </Style>

    <Style Selector="^:selected">
      <Setter Property="Foreground" Value="{DynamicResource AxFgBrush}"/>
    </Style>
    <!--
        Веса выбранной вкладке не даёт ни та, ни другая разновидность. Жирное
        начертание меняет метрику текста, вкладка становится шире — и весь ряд
        сдвигается на каждое переключение. Выбор показывают цвет и полоса
        снизу: они не двигают соседей.
    -->
    <Style Selector="^:selected /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource AxBg1Brush}"/>
    </Style>
    <Style Selector="^:selected /template/ Border#PART_ActiveMarker">
      <Setter Property="IsVisible" Value="True"/>
    </Style>

    <!-- Вкладка в шапке панели инструментов: ниже и без своего фона. -->
    <Style Selector="^.compact">
      <Setter Property="MinHeight" Value="32"/>
    </Style>
    <Style Selector="^.compact:selected /template/ Border#PART_Root">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <!--
        Наведение на вкладку в шапке — плашка внутри вкладки, а не сама вкладка.
        Цвет наведенческий, AxBg3 (раздел 3 закрепляет за токеном эту роль,
        раздел 10 повторяет её селектором).

        Заливка во всю площадь сливалась бы с рамкой панели сверху и с
        разделителем снизу — те же AxBg3, — и от одного слова оставалась бы
        плита от края до края. Отступ в два пикселя со всех сторон открывает
        края плашки, оставляет между соседними плашками карточные четыре и не
        закрывает полосу выбора: она те же два пикселя снизу.

        Скругление со всех сторон, а не только сверху: плашка стоит внутри
        вкладки и ни из чего не растёт. Прежняя, скруглённая сверху и на восемь
        пикселей шире вкладки, залезала на соседку — тем заметнее, чем короче
        имя.

        По горизонтали отступ отсчитывается от поля вкладки: -8 вернуло бы
        плашку на всю ширину, -6 оставляет два пикселя. Тем же приёмом мерит
        себя полоса выбора выше.

        Размер самой вкладки прежний: раздел 10 запрещает менять размеры на
        наведении, да и попадать мышью человек должен по вкладке, а не по
        плашке.
    -->
    <Style Selector="^.compact:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="^.compact:pointerover /template/ Border#PART_Hover">
      <Setter Property="IsVisible" Value="True"/>
      <Setter Property="Margin" Value="-6,2"/>
      <Setter Property="Background" Value="{DynamicResource AxBg3Brush}"/>
      <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadius}"/>
    </Style>
    <!--
        Выключенная строка (раздел 10 спецификации): текст на AxFgDisabled.
        Стиль стоит последним намеренно — выделение и наведение объявлены выше,
        и без этого выключенная выбранная строка выглядела бы обычной.
    -->
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource AxFgDisabledBrush}"/>
    </Style>

  </ControlTheme>

</ResourceDictionary>
