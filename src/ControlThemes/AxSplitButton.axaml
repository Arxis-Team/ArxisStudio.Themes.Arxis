<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ax="using:ArxisStudio.Controls">

  <!--
      Кнопка с меню: левая часть — действие, правая (24) открывает Flyout.
      Класс accent — основное действие, обе части на AxAccStrong; без класса —
      контурная. Разделитель между частями рисует правая половина.
  -->

  <ControlTheme x:Key="AxSplitButtonPrimary" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource AxFgBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="{DynamicResource AxButtonPadding}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <!--
              Кольцо у половины, а не у всей кнопки. SplitButton сам фокуса не
              берёт — Avalonia отдаёт его половинам, — и кольцо на общей рамке
              ждало :focus-visible, который на ней не наступает никогда: по Tab
              не было видно, где стоишь. Половин две, шага тоже два: действие и
              стрелка, и каждый показывает себя сам.
          -->
          <Border x:Name="PART_FocusRing"
                  Margin="-2"
                  CornerRadius="6"
                  BorderThickness="{DynamicResource AxFocusOutlineThickness}"
                  BorderBrush="{DynamicResource AxOutlineFocusedBrush}"
                  IsVisible="False"/>
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True"/>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AxBg3Brush}"/>
    </Style>
    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AxBg4Brush}"/>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="AxSplitButtonSecondary" TargetType="Button"
                BasedOn="{StaticResource AxSplitButtonPrimary}">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Width" Value="{DynamicResource AxControlHeightCompact}"/>
  </ControlTheme>

  <!--
      Акцентные половины: свои темы вместо вложенных селекторов — два
      /template/ в одном селекторе Avalonia не разрешает.
  -->
  <ControlTheme x:Key="AxSplitButtonPrimaryAccent" TargetType="Button"
                BasedOn="{StaticResource AxSplitButtonPrimary}">
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AxAccStrongHoverBrush}"/>
    </Style>
    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AxAccPressedBrush}"/>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="AxSplitButtonSecondaryAccent" TargetType="Button"
                BasedOn="{StaticResource AxSplitButtonPrimaryAccent}">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Width" Value="{DynamicResource AxControlHeightCompact}"/>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ax:AxSplitButton}" TargetType="ax:AxSplitButton">
    <Setter Property="Height" Value="{DynamicResource AxControlHeight}"/>
    <Setter Property="MinWidth" Value="{DynamicResource AxButtonMinWidth}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadius}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AxBrd2Brush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource AxFgBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource AxFontSize}"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border x:Name="PART_Container"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  ClipToBounds="True">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <Button x:Name="PART_PrimaryButton"
                      Theme="{StaticResource AxSplitButtonPrimary}"
                      Foreground="{TemplateBinding Foreground}"
                      Content="{TemplateBinding Content}"
                      ContentTemplate="{TemplateBinding ContentTemplate}"
                      Command="{TemplateBinding Command}"
                      CommandParameter="{TemplateBinding CommandParameter}"/>
              <Border x:Name="PART_Separator"
                      Grid.Column="1" Width="1"
                      Background="{DynamicResource AxBrd2Brush}"/>
              <Button x:Name="PART_SecondaryButton"
                      Grid.Column="2"
                      Theme="{StaticResource AxSplitButtonSecondary}"
                      Foreground="{DynamicResource AxFg2Brush}">
                <ax:AxIcon Data="{x:Static ax:AxIcons.ChevronDown}" Classes="small"
                           Foreground="{Binding $parent[Button].Foreground}"/>
              </Button>
            </Grid>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource AxFgDisabledBrush}"/>
      <Setter Property="Cursor" Value="Arrow"/>
    </Style>
    <Style Selector="^:disabled /template/ Border#PART_Container">
      <Setter Property="Background" Value="{DynamicResource AxBg3Brush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AxBg3Brush}"/>
    </Style>
    <Style Selector="^:disabled /template/ Button#PART_SecondaryButton">
      <Setter Property="Foreground" Value="{DynamicResource AxFgDisabledBrush}"/>
    </Style>
    <Style Selector="^:disabled /template/ Border#PART_Separator">
      <Setter Property="Background" Value="{DynamicResource AxBrdBrush}"/>
    </Style>

    <!-- Основное действие: обе половины на залитом акценте. -->
    <Style Selector="^.accent">
      <Setter Property="Background" Value="{DynamicResource AxAccStrongBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AxAccStrongBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AxOnAccBrush}"/>
    </Style>
    <Style Selector="^.accent /template/ Button#PART_SecondaryButton">
      <Setter Property="Foreground" Value="{DynamicResource AxOnAccBrush}"/>
    </Style>
    <Style Selector="^.accent /template/ Border#PART_Separator">
      <Setter Property="Background" Value="{DynamicResource AxOnAccBrush}"/>
      <Setter Property="Opacity" Value="0.45"/>
    </Style>
    <Style Selector="^.accent /template/ Button#PART_PrimaryButton">
      <Setter Property="Theme" Value="{StaticResource AxSplitButtonPrimaryAccent}"/>
    </Style>
    <Style Selector="^.accent /template/ Button#PART_SecondaryButton">
      <Setter Property="Theme" Value="{StaticResource AxSplitButtonSecondaryAccent}"/>
    </Style>
  </ControlTheme>

</ResourceDictionary>
