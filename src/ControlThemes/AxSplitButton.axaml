<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ax="https://github.com/Arxis-Team/ArxisStudio">

  <!--
      Кнопка с меню: левая часть — действие, правая (24) открывает Flyout.
      Класс accent — основное действие, обе части на AxAccentFill; без класса —
      контурная. Разделитель между частями рисует правая половина.
  -->

  <ControlTheme x:Key="AxSplitButtonPrimary" TargetType="Button">
    <!-- Не обрезаем себя: кольцо фокуса выходит за границы контрола. -->
    <Setter Property="ClipToBounds" Value="False"/>

    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource AxTextPrimaryBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="{DynamicResource AxButtonPadding}"/>
    <!--
        Половина скругляется сама, со своей стороны. Прежде общее скругление
        давала обрезка на контейнере — и она же съедала кольцо фокуса, которое
        у половины выходит наружу.
    -->
    <Setter Property="CornerRadius" Value="4,0,0,4"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <!--
        Длинная подпись действия — как у кнопки: многоточие, а целиком в
        подсказке. Стрелке правило не мешает: текста у неё нет, и подсказка не
        откроется.
    -->
    <Setter Property="ToolTip.Tip" Value=""/>
    <Setter Property="ax:AxTrimmedTip.IsEnabled" Value="True"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <!--
              Кольцо у половины, а не у всей кнопки. SplitButton сам фокуса не
              берёт — Avalonia отдаёт его половинам, — и кольцо на общей рамке
              ждало :focus-visible, который на ней не наступает никогда: по Tab
              не было видно, где стоишь. Половин две, шага тоже два: действие и
              стрелка, и каждый показывает себя сам.
          -->
          <!-- Просвет в пиксель: у класса accent половина залита акцентом. -->
          <Border x:Name="PART_FocusRing"
                  Margin="{DynamicResource AxFocusOutlineRowMargin}"
                  CornerRadius="{DynamicResource AxCornerRadiusFocusRow}"
                  BorderThickness="{DynamicResource AxFocusOutlineThickness}"
                  BorderBrush="{DynamicResource AxFocusRingBrush}"
                  IsVisible="False"/>
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            TextTrimming="CharacterEllipsis"
                            RecognizesAccessKey="True"/>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AxHoverBrush}"/>
    </Style>
    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AxPressedBrush}"/>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="AxSplitButtonSecondary" TargetType="Button"
                BasedOn="{StaticResource AxSplitButtonPrimary}">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Width" Value="{DynamicResource AxControlHeightCompact}"/>
    <Setter Property="CornerRadius" Value="0,4,4,0"/>
  </ControlTheme>

  <!--
      Акцентные половины: свои темы вместо вложенных селекторов — два
      /template/ в одном селекторе Avalonia не разрешает.
  -->
  <ControlTheme x:Key="AxSplitButtonPrimaryAccent" TargetType="Button"
                BasedOn="{StaticResource AxSplitButtonPrimary}">
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AxAccentFillHoverBrush}"/>
    </Style>
    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AxAccentFillPressedBrush}"/>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="AxSplitButtonSecondaryAccent" TargetType="Button"
                BasedOn="{StaticResource AxSplitButtonPrimaryAccent}">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Width" Value="{DynamicResource AxControlHeightCompact}"/>
    <Setter Property="CornerRadius" Value="0,4,4,0"/>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ax:AxSplitButton}" TargetType="ax:AxSplitButton">
    <!-- Не обрезаем себя: кольцо фокуса половины выходит за общие границы. -->
    <Setter Property="ClipToBounds" Value="False"/>
    <!-- Наименьшая высота и центр — по той же причине, что у кнопки. -->
    <Setter Property="MinHeight" Value="{DynamicResource AxControlHeight}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="MinWidth" Value="{DynamicResource AxButtonMinWidth}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadius}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AxStrokeControlBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource AxTextPrimaryBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource AxFontSize}"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border x:Name="PART_Container"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <Button x:Name="PART_PrimaryButton"
                      Theme="{StaticResource AxSplitButtonPrimary}"
                      Foreground="{TemplateBinding Foreground}"
                      Content="{TemplateBinding Content}"
                      ContentTemplate="{TemplateBinding ContentTemplate}"
                      Command="{TemplateBinding Command}"
                      CommandParameter="{TemplateBinding CommandParameter}"/>
              <Border x:Name="PART_Separator"
                      Grid.Column="1" Width="1"
                      Background="{DynamicResource AxStrokeControlBrush}"/>
              <Button x:Name="PART_SecondaryButton"
                      Grid.Column="2"
                      Theme="{StaticResource AxSplitButtonSecondary}"
                      Foreground="{DynamicResource AxTextSecondaryBrush}">
                <ax:AxIcon Data="{x:Static ax:AxIcons.ChevronDown}" Size="Small"
                           Foreground="{Binding $parent[Button].Foreground}"/>
              </Button>
            </Grid>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource AxTextDisabledBrush}"/>
      <Setter Property="Cursor" Value="Arrow"/>
    </Style>
    <Style Selector="^:disabled /template/ Border#PART_Container">
      <Setter Property="Background" Value="{DynamicResource AxSurfaceRaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AxSurfaceRaisedBrush}"/>
    </Style>
    <Style Selector="^:disabled /template/ Button#PART_SecondaryButton">
      <Setter Property="Foreground" Value="{DynamicResource AxTextDisabledBrush}"/>
    </Style>
    <Style Selector="^:disabled /template/ Border#PART_Separator">
      <Setter Property="Background" Value="{DynamicResource AxStrokeSubtleBrush}"/>
    </Style>

    <!-- Основное действие: обе половины на залитом акценте. -->
    <Style Selector="^:primary">
      <Setter Property="Background" Value="{DynamicResource AxAccentFillBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AxAccentFillBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AxTextOnAccentBrush}"/>
    </Style>
    <Style Selector="^:primary /template/ Button#PART_SecondaryButton">
      <Setter Property="Foreground" Value="{DynamicResource AxTextOnAccentBrush}"/>
    </Style>
    <Style Selector="^:primary /template/ Border#PART_Separator">
      <Setter Property="Background" Value="{DynamicResource AxTextOnAccentBrush}"/>
      <Setter Property="Opacity" Value="0.45"/>
    </Style>
    <Style Selector="^:primary /template/ Button#PART_PrimaryButton">
      <Setter Property="Theme" Value="{StaticResource AxSplitButtonPrimaryAccent}"/>
    </Style>
    <Style Selector="^:primary /template/ Button#PART_SecondaryButton">
      <Setter Property="Theme" Value="{StaticResource AxSplitButtonSecondaryAccent}"/>
    </Style>
  </ControlTheme>

</ResourceDictionary>
