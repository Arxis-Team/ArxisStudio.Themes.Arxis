<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ax="https://github.com/Arxis-Team/ArxisStudio">

  <!-- Выпадающий список: поле 28 (24 в плотной зоне) с шевроном, попап на bg2. -->
  <ControlTheme x:Key="{x:Type ax:AxComboBox}" TargetType="ax:AxComboBox">
    <!-- Не обрезаем себя: кольцо фокуса выходит за границы контрола. -->
    <Setter Property="ClipToBounds" Value="False"/>

    <Setter Property="MinHeight" Value="{DynamicResource AxControlHeight}"/>
    <Setter Property="Padding" Value="{DynamicResource AxComboBoxPadding}"/>
    <Setter Property="FontSize" Value="{DynamicResource AxFontSize}"/>
    <Setter Property="Background" Value="{DynamicResource AxSurfaceBaseBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AxStrokeControlBrush}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource AxHairlineThickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadius}"/>
    <Setter Property="Foreground" Value="{DynamicResource AxTextPrimaryBrush}"/>
    <Setter Property="PlaceholderForeground" Value="{DynamicResource AxTextSecondaryBrush}"/>
    <Setter Property="MaxDropDownHeight" Value="320"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
        <Border x:Name="PART_FocusRing"
                Margin="{DynamicResource AxFocusOutlineOuterMargin}"
                CornerRadius="{DynamicResource AxCornerRadiusFocusOuter}"
                BorderThickness="{DynamicResource AxFocusOutlineOuter}"
                BorderBrush="{DynamicResource AxFocusRingBrush}"
                IsVisible="False"/>
        <Border x:Name="PART_Background"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <Grid ColumnDefinitions="*,Auto" Margin="{TemplateBinding Padding}">
            <TextBlock x:Name="PART_PlaceholderText"
                       Text="{TemplateBinding PlaceholderText}"
                       Foreground="{TemplateBinding PlaceholderForeground}"
                       VerticalAlignment="Center"
                       IsVisible="{TemplateBinding SelectionBoxItem, Converter={x:Static ObjectConverters.IsNull}}"/>
            <ContentControl Content="{TemplateBinding SelectionBoxItem}"
                            ContentTemplate="{TemplateBinding ItemTemplate}"
                            VerticalAlignment="Center"/>
            <ax:AxIcon Grid.Column="1"
                       x:Name="PART_Chevron"
                       Margin="{DynamicResource AxSpaceSnugLeadingThickness}"
                       Data="{x:Static ax:AxIcons.ChevronDown}"
                       Foreground="{DynamicResource AxTextSecondaryBrush}"
                       VerticalAlignment="Center"/>
            <Popup x:Name="PART_Popup"
                   IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                   MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                   MaxHeight="{TemplateBinding MaxDropDownHeight}"
                   IsLightDismissEnabled="True"
                   InheritsTransform="True">
              <Border Background="{DynamicResource AxSurfaceOverlayBrush}"
                      BorderBrush="{DynamicResource AxStrokeControlBrush}"
                      BorderThickness="{DynamicResource AxHairlineThickness}"
                      CornerRadius="{DynamicResource AxCornerRadiusLarge}"
                      BoxShadow="{DynamicResource AxShadowPopup}"
                      Margin="{DynamicResource AxSpaceTightAboveThickness}">
                <ScrollViewer>
                  <ItemsPresenter x:Name="PART_ItemsPresenter"
                                  ItemsPanel="{TemplateBinding ItemsPanel}"
                                  Margin="{DynamicResource AxSpaceTightThickness}"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </Border>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Border#PART_Background">
      <Setter Property="Background" Value="{DynamicResource AxHoverBrush}"/>
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Background">
      <Setter Property="BorderBrush" Value="{DynamicResource AxFocusRingBrush}"/>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource AxTextDisabledBrush}"/>
      <Setter Property="Cursor" Value="Arrow"/>
    </Style>
    <Style Selector="^:disabled /template/ Border#PART_Background">
      <Setter Property="Background" Value="{DynamicResource AxFillDisabledBrush}"/>
    </Style>
    <Style Selector="^:disabled /template/ ax|AxIcon#PART_Chevron">
      <Setter Property="Foreground" Value="{DynamicResource AxTextDisabledBrush}"/>
    </Style>

    <!-- Плотная зона: шапка инструментального окна и строки Инспектора. -->
    <Style Selector="^:compact">
      <Setter Property="MinHeight" Value="{DynamicResource AxControlHeightCompact}"/>
    </Style>
  </ControlTheme>

  <!-- Элемент выпадающего списка. -->
  <ControlTheme x:Key="{x:Type ax:AxComboBoxItem}" TargetType="ax:AxComboBoxItem">
    <Setter Property="Padding" Value="{DynamicResource AxRowPadding}"/>
    <Setter Property="MinHeight" Value="{DynamicResource AxRowHeight}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadius}"/>
    <Setter Property="FontSize" Value="{DynamicResource AxFontSize}"/>
    <Setter Property="Foreground" Value="{DynamicResource AxTextPrimaryBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            VerticalContentAlignment="Center"/>
            <!--
                Кольцо строки лежит внутри, а не снаружи, и это не мелочь. У
                кнопки оно вынесено наружу отрицательным полем — там вокруг
                есть место. Строка занимает всю ширину списка, и вынесенное
                кольцо срезал бы сам список: остались бы две вертикальные
                чёрточки по бокам. Толщина поэтому своя.

                Стоит последним, значит поверх заливки выделения: иначе
                выбранная строка в фокусе прятала бы кольцо под собой.
            -->
            <Border x:Name="PART_FocusRing"
                    BorderThickness="{DynamicResource AxFocusOutlineInset}"
                    BorderBrush="{DynamicResource AxFocusRingBrush}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    IsVisible="False"/>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AxHoverBrush}"/>
    </Style>
    <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AxSelectionActiveBrush}"/>
    </Style>
    <!--
        Выключенная строка: текст на AxTextDisabled.
        Стиль стоит последним намеренно — выделение и наведение объявлены выше,
        и без этого выключенная выбранная строка выглядела бы обычной.
    -->
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource AxTextDisabledBrush}"/>
    </Style>

  </ControlTheme>

</ResourceDictionary>
