<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ax="using:ArxisStudio.Controls">

  <!-- Выпадающий список: поле 28 (24 в плотной зоне) с шевроном, попап на bg2. -->
  <ControlTheme x:Key="{x:Type ax:AxComboBox}" TargetType="ax:AxComboBox">
    <Setter Property="MinHeight" Value="{DynamicResource AxControlHeight}"/>
    <Setter Property="Padding" Value="{DynamicResource AxComboBoxPadding}"/>
    <Setter Property="FontSize" Value="{DynamicResource AxFontSize}"/>
    <Setter Property="Background" Value="{DynamicResource AxInpBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AxBrd2Brush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadius}"/>
    <Setter Property="Foreground" Value="{DynamicResource AxFgBrush}"/>
    <Setter Property="PlaceholderForeground" Value="{DynamicResource AxFg2Brush}"/>
    <Setter Property="MaxDropDownHeight" Value="320"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
        <Border x:Name="PART_FocusRing"
                Margin="-2"
                CornerRadius="6"
                BorderThickness="{DynamicResource AxFocusOutlineThickness}"
                BorderBrush="{DynamicResource AxOutlineFocusedBrush}"
                IsVisible="False"/>
        <Border x:Name="PART_Background"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <Grid ColumnDefinitions="*,Auto" Margin="{TemplateBinding Padding}">
            <TextBlock x:Name="PART_PlaceholderText"
                       Text="{TemplateBinding PlaceholderText}"
                       Foreground="{TemplateBinding PlaceholderForeground}"
                       VerticalAlignment="Center"
                       IsVisible="{TemplateBinding SelectionBoxItem, Converter={x:Static ObjectConverters.IsNull}}"/>
            <ContentControl Content="{TemplateBinding SelectionBoxItem}"
                            ContentTemplate="{TemplateBinding ItemTemplate}"
                            VerticalAlignment="Center"/>
            <ax:AxIcon Grid.Column="1"
                       x:Name="PART_Chevron"
                       Margin="6,0,0,0"
                       Data="{x:Static ax:AxIcons.ChevronDown}"
                       Foreground="{DynamicResource AxFg2Brush}"
                       VerticalAlignment="Center"/>
            <Popup x:Name="PART_Popup"
                   IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                   MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                   MaxHeight="{TemplateBinding MaxDropDownHeight}"
                   IsLightDismissEnabled="True"
                   InheritsTransform="True">
              <Border Background="{DynamicResource AxBg2Brush}"
                      BorderBrush="{DynamicResource AxBrd2Brush}"
                      BorderThickness="1"
                      CornerRadius="{DynamicResource AxCornerRadiusLarge}"
                      BoxShadow="{DynamicResource AxPopupShadow}"
                      Margin="0,4,0,0">
                <ScrollViewer>
                  <ItemsPresenter x:Name="PART_ItemsPresenter"
                                  ItemsPanel="{TemplateBinding ItemsPanel}"
                                  Margin="4"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </Border>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Border#PART_Background">
      <Setter Property="Background" Value="{DynamicResource AxBg3Brush}"/>
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Background">
      <Setter Property="BorderBrush" Value="{DynamicResource AxOutlineFocusedBrush}"/>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource AxFgDisabledBrush}"/>
      <Setter Property="Cursor" Value="Arrow"/>
    </Style>
    <Style Selector="^:disabled /template/ Border#PART_Background">
      <Setter Property="Background" Value="{DynamicResource AxInpDisabledBrush}"/>
    </Style>
    <Style Selector="^:disabled /template/ ax|AxIcon#PART_Chevron">
      <Setter Property="Foreground" Value="{DynamicResource AxFgDisabledBrush}"/>
    </Style>

    <!-- Плотная зона: шапка инструментального окна и строки Инспектора. -->
    <Style Selector="^.compact">
      <Setter Property="MinHeight" Value="{DynamicResource AxControlHeightCompact}"/>
    </Style>
  </ControlTheme>

  <!-- Элемент выпадающего списка. -->
  <ControlTheme x:Key="{x:Type ax:AxComboBoxItem}" TargetType="ax:AxComboBoxItem">
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="MinHeight" Value="{DynamicResource AxRowHeight}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadius}"/>
    <Setter Property="FontSize" Value="{DynamicResource AxFontSize}"/>
    <Setter Property="Foreground" Value="{DynamicResource AxFgBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter x:Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          Padding="{TemplateBinding Padding}"
                          VerticalContentAlignment="Center"/>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AxBg3Brush}"/>
    </Style>
    <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AxSelBrush}"/>
    </Style>
    <!--
        Выключенная строка (раздел 10 спецификации): текст на AxFgDisabled.
        Стиль стоит последним намеренно — выделение и наведение объявлены выше,
        и без этого выключенная выбранная строка выглядела бы обычной.
    -->
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource AxFgDisabledBrush}"/>
    </Style>

  </ControlTheme>

</ResourceDictionary>
