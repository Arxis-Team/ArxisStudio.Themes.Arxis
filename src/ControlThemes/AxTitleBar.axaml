<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ax="https://github.com/Arxis-Team/ArxisStudio"
                    xmlns:t="using:ArxisStudio.Themes.Arxis">

  <!--
      Полоса заголовка: содержимое приложения слева, кнопки окна справа.
      Отступ слева появляется только на macOS — под системные кнопки.
  -->
  <ControlTheme x:Key="{x:Type ax:AxTitleBar}" TargetType="ax:AxTitleBar">
    <Setter Property="Background" Value="{DynamicResource AxSurfacePanelBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AxTextPrimaryBrush}"/>
    <!--
        BorderBrush — цвет линии под полосой; рамки у полосы нет. Линия эта не рамка, а граница
        двух областей окна, и мерить её раскладочной единицей нельзя: при 150 % единица даёт два
        пикселя, и полоса заголовка обрастает видимым кантом ровно там, где всё соседнее остаётся
        на месте. Разделитель считает пиксель устройства сам.
    -->
    <Setter Property="BorderBrush" Value="{DynamicResource AxStrokeSubtleBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <!--
        40: высота полосы, в которой стоят проект, лента вкладов и кнопки окна.

        Высота наименьшая, а не прибитая: заголовок и всё, что стоит в полосе,
        растут с кеглем темы. Центр — по той же причине, что у кнопки: прибитая
        высота в ячейке выше себя вставала посередине.
    -->
    <Setter Property="MinHeight" Value="{DynamicResource AxTitleBarHeight}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}">
          <DockPanel>
            <ax:AxDivider x:Name="PART_Rule"
                          DockPanel.Dock="Bottom"
                          Fill="{TemplateBinding BorderBrush}"/>
            <ax:AxWindowControls x:Name="PART_WindowControls"
                                 DockPanel.Dock="Right"
                                 IsVisible="{TemplateBinding ShowWindowControls}"/>
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Margin="{TemplateBinding SystemControlsInset, Converter={x:Static t:AxInsetConverter.Instance}}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!--
      Кнопки окна: свернуть, развернуть или восстановить, закрыть.
      Кнопки 32×26; у закрытия наведение красное, как принято в Windows.

      Глифы — обычные иконки набора, 16×16 и обводкой 1.2. Стояли они на классе
      small с обводкой 1.3, и это было
      заимствованной чужой поблажкой: small заведён для мелкого шеврона в тесной
      строке, а здесь тесноты нет — кнопка 32×26. Уменьшение шло дважды, клеткой
      и рисунком: квадрат в семь единиц из шестнадцати, сжатый до двенадцати,
      доезжал до экрана пятью пикселями с четвертью. Свернуть и закрыть теперь
      берут глифы прямо из набора (Minus и Close), развернуть и восстановить
      нарисованы по правилам набора: прямые штрихи по полупикселю, в
      зоне 2.5…13.5, рамка девять на девять.

      Девять, а не семь. Семь отводит квадрату правило
      оптического веса, но правило это писано про залитые фигуры — про Stop
      рядом с кругом той же площади. Контурная рамка почти пуста и рядом с
      девятью единицами черты и восемью диагонального креста читается мельче
      обоих; в самом наборе контурные рамки Window и Grid — девять в высоту.
  -->
  <ControlTheme x:Key="{x:Type ax:AxWindowControls}" TargetType="ax:AxWindowControls">
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="{DynamicResource AxWindowControlsMargin}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource AxSpaceHair}">
          <Button x:Name="PART_Minimize" Theme="{StaticResource AxWindowButton}">
            <ax:AxIcon Data="{x:Static ax:AxIcons.Minus}"
                       Foreground="{Binding $parent[Button].Foreground}"/>
          </Button>
          <Button x:Name="PART_Maximize" Theme="{StaticResource AxWindowButton}">
            <Panel>
              <ax:AxIcon x:Name="PART_MaximizeIcon"
                         Data="M3.5 3.5H12.5V12.5H3.5Z"
                         Foreground="{Binding $parent[Button].Foreground}"/>
              <ax:AxIcon x:Name="PART_RestoreIcon"
                         Data="M5.5 3.5H12.5V10.5M3.5 5.5H10.5V12.5H3.5Z"
                         Foreground="{Binding $parent[Button].Foreground}"
                         IsVisible="False"/>
            </Panel>
          </Button>
          <Button x:Name="PART_Close" Theme="{StaticResource AxWindowButton}" Classes="close">
            <ax:AxIcon Data="{x:Static ax:AxIcons.Close}"
                       Foreground="{Binding $parent[Button].Foreground}"/>
          </Button>
        </StackPanel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^[IsMaximized=True] /template/ ax|AxIcon#PART_MaximizeIcon">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="^[IsMaximized=True] /template/ ax|AxIcon#PART_RestoreIcon">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
  </ControlTheme>

  <!--
      Одна кнопка окна: шире своей высоты, без рамки; закрытие краснеет под
      курсором. Ширина и высота — ключи хрома: кнопка стоит в полосе заголовка и
      идёт за её плотностью.
  -->
  <ControlTheme x:Key="AxWindowButton" TargetType="Button">
    <Setter Property="Width" Value="{DynamicResource AxWindowButtonWidth}"/>
    <Setter Property="Height" Value="{DynamicResource AxToolbarButtonSize}"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadiusSmall}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource AxTextSecondaryBrush}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Content="{TemplateBinding Content}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
          <!--
              Кольцо внутри, а не снаружи: кнопка окна стоит вплотную к краю, и вынесенное наружу
              кольцо срезала бы сама рама. Свернуть, развернуть и закрыть — первые три остановки
              Tab в любом окне студии, и без кольца человек, идущий с клавиатуры, начинал путь в
              пустоте.
          -->
          <t:AxFocusRing x:Name="PART_FocusRing" Placement="Inside"
                         CornerRadius="{TemplateBinding CornerRadius}"/>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:focus-visible /template/ t|AxFocusRing#PART_FocusRing">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AxHoverBrush}"/>
    </Style>
    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AxPressedBrush}"/>
    </Style>
    <Style Selector="^.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AxErrorBrush}"/>
    </Style>
    <Style Selector="^.close:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource AxTextOnAccentBrush}"/>
    </Style>
  </ControlTheme>

</ResourceDictionary>
