<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ax="https://github.com/Arxis-Team/ArxisStudio">

  <!--
      Полоса заголовка: содержимое приложения слева, кнопки окна справа.
      Отступ слева появляется только на macOS — под системные кнопки.
  -->
  <ControlTheme x:Key="{x:Type ax:AxTitleBar}" TargetType="ax:AxTitleBar">
    <Setter Property="Background" Value="{DynamicResource AxBg2Brush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AxFgBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AxBrdBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <!--
        40: столько объявляет карточка «Тулбар» — единственная в проекте, где
        полоса с проектом, виджетом запуска и кнопками окна показана целиком.
        Прежние 42 в проекте ничем не подтверждаются.
    -->
    <Setter Property="Height" Value="40"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}">
          <DockPanel>
            <ax:AxWindowControls x:Name="PART_WindowControls"
                                 DockPanel.Dock="Right"
                                 IsVisible="{TemplateBinding ShowWindowControls}"/>
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Margin="{TemplateBinding SystemControlsInset, Converter={x:Static ax:AxInsetConverter.Instance}}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!--
      Кнопки окна: свернуть, развернуть или восстановить, закрыть.
      Размеры кнопок — из мокапа студии (32×26 в полосе 42px); у закрытия hover
      красный, как принято в Windows и в Int UI.

      Глифы — обычные иконки набора, 16×16 и обводкой 1.2, как требует раздел 7
      спецификации. Стояли они на классе small с обводкой 1.3, и это было
      заимствованной чужой поблажкой: small заведён для мелкого шеврона в тесной
      строке, а здесь тесноты нет — кнопка 32×26. Уменьшение шло дважды, клеткой
      и рисунком: квадрат в семь единиц из шестнадцати, сжатый до двенадцати,
      доезжал до экрана пятью пикселями с четвертью. Свернуть и закрыть теперь
      берут глифы прямо из набора (Minus и Close), развернуть и восстановить
      нарисованы по правилам того же раздела: прямые штрихи по полупикселю, в
      зоне 2.5…13.5, рамка девять на девять.

      Девять, а не семь. Семь спецификация отводит квадрату в правиле
      оптического веса, но правило это писано про залитые фигуры — про Stop
      рядом с кругом той же площади. Контурная рамка почти пуста и рядом с
      девятью единицами черты и восемью диагонального креста читается мельче
      обоих; в самом наборе контурные рамки Window и Grid — девять в высоту.
  -->
  <ControlTheme x:Key="{x:Type ax:AxWindowControls}" TargetType="ax:AxWindowControls">
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="4,0,6,0"/>
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Orientation="Horizontal" Spacing="2">
          <Button x:Name="PART_Minimize" Theme="{StaticResource AxWindowButton}">
            <ax:AxIcon Data="{x:Static ax:AxIcons.Minus}"
                       Foreground="{Binding $parent[Button].Foreground}"/>
          </Button>
          <Button x:Name="PART_Maximize" Theme="{StaticResource AxWindowButton}">
            <Panel>
              <ax:AxIcon x:Name="PART_MaximizeIcon"
                         Data="M3.5 3.5H12.5V12.5H3.5Z"
                         Foreground="{Binding $parent[Button].Foreground}"/>
              <ax:AxIcon x:Name="PART_RestoreIcon"
                         Data="M5.5 3.5H12.5V10.5M3.5 5.5H10.5V12.5H3.5Z"
                         Foreground="{Binding $parent[Button].Foreground}"
                         IsVisible="False"/>
            </Panel>
          </Button>
          <Button x:Name="PART_Close" Theme="{StaticResource AxWindowButton}" Classes="close">
            <ax:AxIcon Data="{x:Static ax:AxIcons.Close}"
                       Foreground="{Binding $parent[Button].Foreground}"/>
          </Button>
        </StackPanel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^[IsMaximized=True] /template/ ax|AxIcon#PART_MaximizeIcon">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="^[IsMaximized=True] /template/ ax|AxIcon#PART_RestoreIcon">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
  </ControlTheme>

  <!-- Одна кнопка окна: 32×26, без рамки; закрытие краснеет под курсором. -->
  <ControlTheme x:Key="AxWindowButton" TargetType="Button">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="26"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadiusSmall}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource AxFg2Brush}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter x:Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Content="{TemplateBinding Content}"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"/>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AxBg3Brush}"/>
    </Style>
    <Style Selector="^.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AxRedBrush}"/>
    </Style>
    <Style Selector="^.close:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource AxOnAccBrush}"/>
    </Style>
  </ControlTheme>

</ResourceDictionary>
