<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ax="using:ArxisStudio.Controls">

  <!-- Бейдж-счётчик: акцентная пилюля 15px. -->
  <ControlTheme x:Key="{x:Type ax:AxBadge}" TargetType="ax:AxBadge">
    <!-- Чётный размер: правило раздела 12, целые пиксели при 125 % и 150 %. -->
    <Setter Property="MinWidth" Value="16"/>
    <Setter Property="Height" Value="16"/>
    <Setter Property="CornerRadius" Value="8"/>
    <!-- Счётчик — текст на заливке: AxAccStrong (приёмка, раздел 6). -->
    <Setter Property="Background" Value="{DynamicResource AxAccStrongBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AxOnAccBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource AxFontSizeCaption}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="4,0"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- Чип-метка: bg3-пилюля; accent — выделенная; kbd — вид клавиши. -->
  <ControlTheme x:Key="{x:Type ax:AxChip}" TargetType="ax:AxChip">
    <Setter Property="Padding" Value="8,2"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Background" Value="{DynamicResource AxBg3Brush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AxFgBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource AxFontSizeCaption}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
        </Border>
      </ControlTemplate>
    </Setter>
    <!-- Акцентный текст на залитой плашке — AxLinkOn: AxAcc там даёт 4,18:1. -->
    <Style Selector="^.accent">
      <Setter Property="Background" Value="{DynamicResource AxSelBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AxLinkOnBrush}"/>
    </Style>
    <!--
        Чип шортката: 20 высотой, отступ только по горизонтали, радиус
        контрольный. Текст остаётся AxFg, а не вторичным: правило раздела 12
        требует на залитом AxBg3 именно основной цвет — вторичный там даёт
        4,18:1.
    -->
    <Style Selector="^.kbd">
      <Setter Property="FontFamily" Value="{DynamicResource AxFontFamilyMono}"/>
      <Setter Property="FontSize" Value="{DynamicResource AxFontSizeSmall}"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadius}"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="Padding" Value="6,0"/>
    </Style>
  </ControlTheme>

  <!-- Карточка-контейнер: панель bg2 с рамкой и radius 10. -->
  <ControlTheme x:Key="{x:Type ax:AxCard}" TargetType="ax:AxCard">
    <Setter Property="Background" Value="{DynamicResource AxBg2Brush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AxBrdBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadiusLarge}"/>
    <Setter Property="Padding" Value="14"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Margin="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- Тонкий индикатор прогресса (4px). -->
  <ControlTheme x:Key="{x:Type ax:AxProgressBar}" TargetType="ax:AxProgressBar">
    <Setter Property="Height" Value="4"/>
    <Setter Property="MinHeight" Value="4"/>
    <Setter Property="CornerRadius" Value="2"/>
    <Setter Property="Background" Value="{DynamicResource AxBg3Brush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AxAccBrush}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                ClipToBounds="True">
          <Border x:Name="PART_Indicator"
                  Background="{TemplateBinding Foreground}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  HorizontalAlignment="Left">
            <Border.RenderTransform>
              <TranslateTransform/>
            </Border.RenderTransform>
          </Border>
        </Border>
      </ControlTemplate>
    </Setter>

    <!--
        Бесконечный режим: полоса бежит слева направо — второе и последнее
        разрешённое движение рядом с лоадером. Позиции считает сам ProgressBar
        (TemplateSettings), поэтому цифр здесь нет.
    -->
    <Style Selector="^:indeterminate /template/ Border#PART_Indicator">
      <!--
          В бесконечном режиме ширину бегунка считает сам ProgressBar и кладёт
          в TemplateSettings: без этой привязки индикатор растянут во всю
          дорожку, и движение не видно.
      -->
      <Setter Property="Width"
              Value="{Binding TemplateSettings.ContainerWidth, RelativeSource={RelativeSource TemplatedParent}}"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Style.Animations>
        <Animation IterationCount="Infinite" Duration="0:0:2">
          <KeyFrame Cue="0%">
            <Setter Property="TranslateTransform.X"
                    Value="{Binding TemplateSettings.ContainerAnimationStartPosition, RelativeSource={RelativeSource TemplatedParent}}"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="TranslateTransform.X"
                    Value="{Binding TemplateSettings.ContainerAnimationEndPosition, RelativeSource={RelativeSource TemplatedParent}}"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </ControlTheme>

</ResourceDictionary>
