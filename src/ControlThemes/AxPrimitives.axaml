<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ax="https://github.com/Arxis-Team/ArxisStudio"
                    xmlns:t="using:ArxisStudio.Themes.Arxis">

  <!-- Бейдж-счётчик: акцентная пилюля 16px. -->
  <ControlTheme x:Key="{x:Type ax:AxBadge}" TargetType="ax:AxBadge">
    <!--
        Чётный размер: целые пиксели при 125 % и 150 %.
        Высота наименьшая, а не прибитая: цифры растут с кеглем темы, и
        прибитые шестнадцать срезали бы их. Центр — чтобы в ячейке выше себя
        бейдж вставал там же, где вставал прибитый.
    -->
    <Setter Property="MinWidth" Value="{DynamicResource AxBadgeSize}"/>
    <Setter Property="MinHeight" Value="{DynamicResource AxBadgeSize}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadiusPill}"/>
    <!-- Счётчик — текст на заливке: AxAccentFill. -->
    <Setter Property="Background" Value="{DynamicResource AxAccentFillBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AxTextOnAccentBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource AxFontSizeCaption}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="{DynamicResource AxBadgePadding}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!--
      Чип-метка: пилюля на приподнятой поверхности; Kind=Accent — выделенная; Kind=Key — вид клавиши.

      Снимаемый чип (IsRemovable) несёт крестик справа — голый глиф в клетке значка, как крестик поля
      поиска: плашка под ним в чипе высотой двадцать читалась бы второй кнопкой. Каретку крестик не
      берёт — чип в поле жетонов снимают с клавиатуры Delete, стоя на самом чипе, — и кольцо поэтому у
      чипа: формой пилюли, на просвете в пиксель, как у контрола без своей рамки.
  -->
  <ControlTheme x:Key="{x:Type ax:AxChip}" TargetType="ax:AxChip">
    <!-- Не обрезаем себя: кольцо фокуса выходит за границы чипа. -->
    <Setter Property="ClipToBounds" Value="False"/>
    <Setter Property="Padding" Value="{DynamicResource AxChipPadding}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadiusPill}"/>
    <Setter Property="Background" Value="{DynamicResource AxSurfaceRaisedBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AxTextPrimaryBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource AxFontSizeCaption}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <t:AxFocusRing x:Name="PART_FocusRing"
                         Margin="{DynamicResource AxFocusOutlineRowMargin}"
                         BorderThickness="{DynamicResource AxFocusOutlineThickness}"
                         CornerRadius="{TemplateBinding CornerRadius}"/>
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <DockPanel>
              <ax:AxButton x:Name="PART_Remove"
                           DockPanel.Dock="Right"
                           Theme="{StaticResource AxInlineIconButton}"
                           Width="{DynamicResource AxIconSize}"
                           Height="{DynamicResource AxIconSize}"
                           Focusable="False"
                           VerticalAlignment="Center"
                           AutomationProperties.Name="{DynamicResource AxTextChipRemove}"
                           ToolTip.Tip="{DynamicResource AxTextChipRemove}">
                <ax:AxIcon Size="Small"
                           Data="{x:Static ax:AxIcons.Close}"
                           Foreground="{Binding $parent[ax:AxButton].Foreground}"/>
              </ax:AxButton>
              <ContentPresenter Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"/>
            </DockPanel>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
    <!-- Крестик скрыт стилем, а не значением шаблона: значение шаблона сильнее стиля, и снимаемый его не показал бы. -->
    <Style Selector="^ /template/ ax|AxButton#PART_Remove">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="^:removable /template/ ax|AxButton#PART_Remove">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="^:removable">
      <Setter Property="Padding" Value="{DynamicResource AxChipPaddingRemovable}"/>
    </Style>
    <Style Selector="^:focus-visible /template/ t|AxFocusRing#PART_FocusRing">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <!-- Акцентный текст на залитой плашке — AxLinkOnPlate: AxAccent там даёт 3,41:1. -->
    <Style Selector="^:accent">
      <Setter Property="Background" Value="{DynamicResource AxSelectionActiveBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AxLinkOnPlateBrush}"/>
    </Style>
    <!--
        Чип шортката: 20 высотой, отступ только по горизонтали, радиус
        контрольный. Текст — AxTextPrimary, а не вторичный: клавишу в чипе читают как
        саму клавишу, а не как пояснение к ней.
    -->
    <!--
        Клавиша набрана тем же шрифтом, что и подпись рядом: моношрифт отдан
        коду, путям и значениям, а «Shift F10» — ни то, ни другое.
    -->
    <Style Selector="^:key">
      <Setter Property="FontSize" Value="{DynamicResource AxFontSizeSmall}"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadius}"/>
      <!-- Наименьшая и по центру — по той же причине, что у бейджа. -->
      <Setter Property="MinHeight" Value="{DynamicResource AxChipKeyHeight}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Padding" Value="{DynamicResource AxChipPaddingKey}"/>
    </Style>
  </ControlTheme>

  <!-- Карточка-контейнер: панель bg2 с рамкой и radius 10. -->
  <ControlTheme x:Key="{x:Type ax:AxCard}" TargetType="ax:AxCard">
    <Setter Property="Background" Value="{DynamicResource AxSurfacePanelBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AxStrokeSubtleBrush}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource AxHairlineThickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadiusLarge}"/>
    <Setter Property="Padding" Value="{DynamicResource AxCardPadding}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Margin="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- Тонкий индикатор прогресса (4px). -->
  <!--
      Прогресс: полоса 4 с радиусом 2 на дорожке AxTrack. Наведение сюда не
      годится — под заполнением дорожка обязана читаться как жёлоб, а не как
      подсветка строки, и одним цветом на любой поверхности, поэтому она
      непрозрачна.
  -->
  <ControlTheme x:Key="{x:Type ax:AxProgressBar}" TargetType="ax:AxProgressBar">
    <Setter Property="Height" Value="{DynamicResource AxTrackHeight}"/>
    <Setter Property="MinHeight" Value="{DynamicResource AxTrackHeight}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadiusTrack}"/>
    <Setter Property="Background" Value="{DynamicResource AxTrackBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AxAccentBrush}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                ClipToBounds="True">
          <Border x:Name="PART_Indicator"
                  Background="{TemplateBinding Foreground}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  HorizontalAlignment="Left">
            <Border.RenderTransform>
              <TranslateTransform/>
            </Border.RenderTransform>
          </Border>
        </Border>
      </ControlTemplate>
    </Setter>

    <!--
        Бесконечный режим: полоса бежит слева направо — второе и последнее
        разрешённое движение рядом с лоадером. Позиции считает сам ProgressBar
        (TemplateSettings), поэтому цифр здесь нет.
    -->
    <Style Selector="^:indeterminate /template/ Border#PART_Indicator">
      <!--
          В бесконечном режиме ширину бегунка считает сам ProgressBar и кладёт
          в TemplateSettings: без этой привязки индикатор растянут во всю
          дорожку, и движение не видно.
      -->
      <Setter Property="Width"
              Value="{Binding TemplateSettings.ContainerWidth, RelativeSource={RelativeSource TemplatedParent}}"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Style.Animations>
        <!-- Проход за 1.2 с, линейно, без разгона. -->
        <Animation IterationCount="Infinite" Duration="0:0:1.2">
          <KeyFrame Cue="0%">
            <Setter Property="TranslateTransform.X"
                    Value="{Binding TemplateSettings.ContainerAnimationStartPosition, RelativeSource={RelativeSource TemplatedParent}}"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="TranslateTransform.X"
                    Value="{Binding TemplateSettings.ContainerAnimationEndPosition, RelativeSource={RelativeSource TemplatedParent}}"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </ControlTheme>

</ResourceDictionary>
