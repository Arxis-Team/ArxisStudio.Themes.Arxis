<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ax="https://github.com/Arxis-Team/ArxisStudio"
                    xmlns:t="using:ArxisStudio.Themes.Arxis">

  <!--
      Меню студии. Тема пункта написана для родного MenuItem и перекрывает его
      ключом типа — контекстные меню и Flyout получают вид студии без своих
      контейнеров; AxMenuItem наследует её. Правила: строка AxMenuRowHeight —
      она выше строки списка на ступень, потому что в меню целятся мышью, а не
      читают списком; шорткат прижат вправо и остаётся AxTextTertiary (декор);
      подсвеченный пункт — AxSelectionActive; деструктивный несёт класс danger.

      Колонки выровнены по всему меню, а не по каждому пункту: глиф, жест и
      шеврон объявлены общими группами размера, и место им даёт самый широкий
      пункт. Прежде колонка глифа была шириной в клетку значка у каждого пункта
      порознь, а колонки жеста не было вовсе — жест стоял сразу за подписью, и
      столбец шорткатов гулял по меню лесенкой. Область общего размера объявляет
      каждое меню у себя: колонки равняются внутри одного полотна, а не между
      разными.
  -->
  <ControlTheme x:Key="{x:Type MenuItem}" TargetType="MenuItem">
    <Setter Property="MinHeight" Value="{DynamicResource AxMenuRowHeight}"/>
    <Setter Property="Padding" Value="{DynamicResource AxRowPadding}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadius}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource AxTextPrimaryBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource AxFontSize}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border x:Name="PART_LayoutRoot"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <Grid VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="AxMenuGlyph"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="AxMenuGesture"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="AxMenuChevron"/>
              </Grid.ColumnDefinitions>
              <!--
                  Значок и галочка стоят в одной клетке: пункт-переключатель
                  показывает своё состояние там же, где сосед показывает значок,
                  и подписи в меню не разъезжаются на две колонки.
              -->
              <Panel Margin="{DynamicResource AxGapIconTextThickness}">
                <Viewbox Width="{DynamicResource AxIconSize}" Height="{DynamicResource AxIconSize}"
                         StretchDirection="DownOnly"
                         HorizontalAlignment="Center" VerticalAlignment="Center">
                  <ContentPresenter x:Name="PART_IconPresenter"
                                    Content="{TemplateBinding Icon}"/>
                </Viewbox>
                <ax:AxIcon x:Name="PART_Check"
                           Data="{x:Static ax:AxIcons.Check}"
                           Foreground="{DynamicResource AxAccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="False"/>
              </Panel>
              <ContentPresenter x:Name="PART_HeaderPresenter"
                                Grid.Column="1"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                RecognizesAccessKey="True"
                                VerticalAlignment="Center"/>
              <!--
                  Жест пишется так, как его читают на этой платформе: на macOS
                  той же командой правит знак команды, а клавиши с именем Ctrl
                  под пальцем нет вовсе. Привязка к строке отдавала инвариантную
                  запись обеим.
              -->
              <TextBlock x:Name="PART_InputGestureText"
                         Grid.Column="2"
                         Margin="{DynamicResource AxSpaceWideLeadingThickness}"
                         Text="{TemplateBinding InputGesture, Converter={x:Static t:AxGestureText.Platform}}"
                         Foreground="{DynamicResource AxTextTertiaryBrush}"
                         FontSize="{DynamicResource AxFontSizeSmall}"
                         VerticalAlignment="Center"/>
              <ax:AxIcon x:Name="PART_SubmenuChevron"
                         Grid.Column="3"
                         Size="Small"
                         Data="{x:Static ax:AxIcons.ChevronRight}"
                         Foreground="{DynamicResource AxTextSecondaryBrush}"
                         VerticalAlignment="Center"
                         IsVisible="False"/>
            </Grid>
          </Border>
          <Popup x:Name="PART_Popup"
                 Placement="RightEdgeAlignedTop"
                 HorizontalOffset="{DynamicResource AxSubmenuHorizontalOffset}"
                 VerticalOffset="{DynamicResource AxSubmenuVerticalOffset}"
                 IsLightDismissEnabled="False"
                 IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}">
            <Border Background="{DynamicResource AxSurfaceOverlayBrush}"
                    BorderBrush="{DynamicResource AxStrokeControlBrush}"
                    BorderThickness="{DynamicResource AxHairlineThickness}"
                    CornerRadius="{DynamicResource AxCornerRadiusLarge}"
                    BoxShadow="{DynamicResource AxShadowPopup}"
                    Padding="{DynamicResource AxMenuPadding}"
                    Margin="{DynamicResource AxPopupShadowRoom}">
              <ScrollViewer>
                <ItemsPresenter x:Name="PART_ItemsPresenter"
                                Grid.IsSharedSizeScope="True"
                                ItemsPanel="{TemplateBinding ItemsPanel}"/>
              </ScrollViewer>
            </Border>
          </Popup>
        </Panel>
      </ControlTemplate>
    </Setter>

    <!--
        Подсветка пункта: и под курсором, и под клавиатурой. Avalonia метит наведённый пункт
        :selected, и поначалу этого хватало — но :selected приходит и от стрелок, и от мыши, а
        правило состояний спрашивает наведение отдельно: пункт, помеченный только выбором, в
        линте выглядит пунктом без наведения, и отличить одно от другого нечем.
    -->
    <Style Selector="^:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource AxSelectionActiveBrush}"/>
    </Style>
    <Style Selector="^:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource AxSelectionActiveBrush}"/>
    </Style>
    <!--
        Галочка переключателя и точка выбора — оба состояния показывает та же
        галочка: два разных глифа в колонке в шестнадцать точек различались бы
        только под лупой, а смысл у них один — этот пункт сейчас включён.
    -->
    <Style Selector="^:toggle:checked /template/ ax|AxIcon#PART_Check">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="^:radio:checked /template/ ax|AxIcon#PART_Check">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="^:empty /template/ ax|AxIcon#PART_SubmenuChevron">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="^:not(:empty) /template/ ax|AxIcon#PART_SubmenuChevron">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource AxTextDisabledBrush}"/>
    </Style>
    <Style Selector="^:disabled /template/ TextBlock#PART_InputGestureText">
      <Setter Property="Foreground" Value="{DynamicResource AxStrokeControlBrush}"/>
    </Style>

    <!-- Деструктивный пункт: красный текст, шорткат — светлее на шаг. -->
    <Style Selector="^:destructive">
      <Setter Property="Foreground" Value="{DynamicResource AxErrorTextBrush}"/>
    </Style>
    <Style Selector="^:destructive /template/ TextBlock#PART_InputGestureText">
      <Setter Property="Foreground" Value="{DynamicResource AxErrorTextBrush}"/>
      <Setter Property="Opacity" Value="0.6"/>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ax:AxMenuItem}" TargetType="ax:AxMenuItem"
                BasedOn="{StaticResource {x:Type MenuItem}}"/>

  <!-- Полотно контекстного меню и MenuFlyout: карточка на тени попапа. -->
  <ControlTheme x:Key="{x:Type MenuFlyoutPresenter}" TargetType="MenuFlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource AxSurfaceOverlayBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AxStrokeControlBrush}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource AxHairlineThickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadiusLarge}"/>
    <Setter Property="Padding" Value="{DynamicResource AxMenuPadding}"/>
    <Setter Property="MaxWidth" Value="{DynamicResource AxMenuMaxWidth}"/>
    <Setter Property="MinWidth" Value="{DynamicResource AxMenuMinWidth}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                BoxShadow="{DynamicResource AxShadowPopup}"
                Padding="{TemplateBinding Padding}"
                Margin="{DynamicResource AxPopupShadowRoom}">
          <ScrollViewer>
            <ItemsPresenter x:Name="PART_ItemsPresenter"
                            Grid.IsSharedSizeScope="True"
                            ItemsPanel="{TemplateBinding ItemsPanel}"/>
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ContextMenu}" TargetType="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource AxSurfaceOverlayBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AxStrokeControlBrush}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource AxHairlineThickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadiusLarge}"/>
    <Setter Property="Padding" Value="{DynamicResource AxMenuPadding}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                BoxShadow="{DynamicResource AxShadowPopup}"
                Padding="{TemplateBinding Padding}"
                Margin="{DynamicResource AxPopupShadowRoom}">
          <ScrollViewer>
            <ItemsPresenter x:Name="PART_ItemsPresenter"
                            Grid.IsSharedSizeScope="True"
                            ItemsPanel="{TemplateBinding ItemsPanel}"/>
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- Разделитель меню: линия в пиксель с воздухом по бокам. -->
  <ControlTheme x:Key="{x:Type Separator}" TargetType="Separator">
    <Setter Property="Background" Value="{DynamicResource AxStrokeSubtleBrush}"/>
    <Setter Property="Height" Value="{DynamicResource AxHairline}"/>
    <Setter Property="Margin" Value="{DynamicResource AxMenuSeparatorMargin}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"/>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>
