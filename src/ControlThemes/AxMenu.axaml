<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ax="https://github.com/Arxis-Team/ArxisStudio">

  <!--
      Меню студии. Тема пункта написана для родного MenuItem и перекрывает его
      ключом типа — контекстные меню и Flyout получают вид студии без своих
      контейнеров; AxMenuItem наследует её. Правила: строка AxRowHeight,
      колонка иконок 16 фиксирована — пункт без иконки получает пустой отступ,
      и текст не съезжает; шорткат прижат вправо и остаётся AxFg3 (декор);
      подсвеченный пункт — AxSel; деструктивный несёт класс danger.
  -->
  <ControlTheme x:Key="{x:Type MenuItem}" TargetType="MenuItem">
    <Setter Property="MinHeight" Value="{DynamicResource AxRowHeight}"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadius}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource AxFgBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource AxFontSize}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border x:Name="PART_LayoutRoot"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <!--
                Колонка иконки — Auto, а не 16: ширину ей задаёт сама клетка
                иконки, и число не приходится держать в двух местах сразу.
            -->
            <Grid ColumnDefinitions="Auto,8,*,12,Auto,Auto" VerticalAlignment="Center">
              <Viewbox Width="{DynamicResource AxIconSize}" Height="{DynamicResource AxIconSize}"
                       StretchDirection="DownOnly"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <ContentPresenter x:Name="PART_IconPresenter"
                                  Content="{TemplateBinding Icon}"/>
              </Viewbox>
              <ContentPresenter x:Name="PART_HeaderPresenter"
                                Grid.Column="2"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                RecognizesAccessKey="True"
                                VerticalAlignment="Center"/>
              <TextBlock x:Name="PART_InputGestureText"
                         Grid.Column="4"
                         Text="{TemplateBinding InputGesture}"
                         Foreground="{DynamicResource AxFg3Brush}"
                         FontSize="{DynamicResource AxFontSizeSmall}"
                         VerticalAlignment="Center"/>
              <ax:AxIcon x:Name="PART_SubmenuChevron"
                         Grid.Column="5"
                         Classes="small"
                         Data="{x:Static ax:AxIcons.ChevronRight}"
                         Foreground="{DynamicResource AxFg2Brush}"
                         VerticalAlignment="Center"
                         IsVisible="False"/>
            </Grid>
          </Border>
          <Popup x:Name="PART_Popup"
                 Placement="RightEdgeAlignedTop"
                 HorizontalOffset="-4"
                 IsLightDismissEnabled="False"
                 IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}">
            <Border Background="{DynamicResource AxBg2Brush}"
                    BorderBrush="{DynamicResource AxBrd2Brush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource AxCornerRadiusLarge}"
                    BoxShadow="{DynamicResource AxPopupShadow}"
                    Padding="4"
                    Margin="8">
              <ScrollViewer>
                <ItemsPresenter x:Name="PART_ItemsPresenter"
                                ItemsPanel="{TemplateBinding ItemsPanel}"/>
              </ScrollViewer>
            </Border>
          </Popup>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource AxSelBrush}"/>
    </Style>
    <Style Selector="^:empty /template/ ax|AxIcon#PART_SubmenuChevron">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="^:not(:empty) /template/ ax|AxIcon#PART_SubmenuChevron">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource AxFgDisabledBrush}"/>
    </Style>
    <Style Selector="^:disabled /template/ TextBlock#PART_InputGestureText">
      <Setter Property="Foreground" Value="{DynamicResource AxBrd2Brush}"/>
    </Style>

    <!-- Деструктивный пункт: красный текст, шорткат — светлее на шаг. -->
    <Style Selector="^.danger">
      <Setter Property="Foreground" Value="{DynamicResource AxRedTextBrush}"/>
    </Style>
    <Style Selector="^.danger /template/ TextBlock#PART_InputGestureText">
      <Setter Property="Foreground" Value="{DynamicResource AxRedTextBrush}"/>
      <Setter Property="Opacity" Value="0.6"/>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ax:AxMenuItem}" TargetType="ax:AxMenuItem"
                BasedOn="{StaticResource {x:Type MenuItem}}"/>

  <!-- Полотно контекстного меню и MenuFlyout: карточка на тени попапа. -->
  <ControlTheme x:Key="{x:Type MenuFlyoutPresenter}" TargetType="MenuFlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource AxBg2Brush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AxBrd2Brush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadiusLarge}"/>
    <Setter Property="Padding" Value="4"/>
    <Setter Property="MaxWidth" Value="456"/>
    <Setter Property="MinWidth" Value="160"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                BoxShadow="{DynamicResource AxPopupShadow}"
                Padding="{TemplateBinding Padding}"
                Margin="8">
          <ScrollViewer>
            <ItemsPresenter x:Name="PART_ItemsPresenter"
                            ItemsPanel="{TemplateBinding ItemsPanel}"/>
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ContextMenu}" TargetType="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource AxBg2Brush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AxBrd2Brush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadiusLarge}"/>
    <Setter Property="Padding" Value="4"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                BoxShadow="{DynamicResource AxPopupShadow}"
                Padding="{TemplateBinding Padding}"
                Margin="8">
          <ScrollViewer>
            <ItemsPresenter x:Name="PART_ItemsPresenter"
                            ItemsPanel="{TemplateBinding ItemsPanel}"/>
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- Разделитель меню: линия в пиксель с воздухом по бокам. -->
  <ControlTheme x:Key="{x:Type Separator}" TargetType="Separator">
    <Setter Property="Background" Value="{DynamicResource AxBrdBrush}"/>
    <Setter Property="Height" Value="1"/>
    <Setter Property="Margin" Value="6,4"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"/>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>
