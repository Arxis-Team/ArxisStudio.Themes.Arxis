<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ax="https://github.com/Arxis-Team/ArxisStudio"
                    xmlns:t="using:ArxisStudio.Themes.Arxis">

  <!--
      Тумблер 30×17 с кнобом 13 (размеры — метрики темы): выключен — дорожка bg4
      и кноб слева, включён — залитая акцентом дорожка и кноб справа. Дорожка
      с текстом не встречается, но кноб стоит на акценте, поэтому включённый —
      AxAccentFill, как и остальные залитые поверхности.
  -->
  <ControlTheme x:Key="{x:Type ax:AxToggleSwitch}" TargetType="ax:AxToggleSwitch">
    <!-- Не обрезаем себя: кольцо фокуса выходит за границы контрола. -->
    <Setter Property="ClipToBounds" Value="False"/>

    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource AxTextPrimaryBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource AxFontSize}"/>
    <Setter Property="MinHeight" Value="{DynamicResource AxControlHeightCompact}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel VerticalAlignment="Center">
          <!--
              Кольцо обнимает подпись вместе с дорожкой — как в компоненте, — но
              по содержимому, а не по MinHeight: строка держит 24, дорожка
              высотой 17, и кольцо по контролу висело вокруг пустоты.

              Отступ −3 против толщины 2 оставляет просвет в пиксель: у
              включённого переключателя дорожка залита акцентом, и кольцо
              вплотную слилось бы с ней в одно пятно. Просвет в 1px стоит во
              всех фокусных состояниях.
          -->
          <t:AxFocusRing x:Name="PART_FocusRing" Placement="Row"/>
          <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <!-- Подпись идёт слева от дорожки — как в компоненте. -->
            <ContentPresenter Margin="{DynamicResource AxSpaceTrailingThickness}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True"
                              IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <Border x:Name="PART_Track"
                    Grid.Column="1"
                    Width="{DynamicResource AxToggleWidth}"
                    Height="{DynamicResource AxToggleHeight}"
                    CornerRadius="{DynamicResource AxCornerRadiusPill}"
                    VerticalAlignment="Center"
                    Background="{DynamicResource AxTrackBrush}">
              <Ellipse x:Name="PART_Knob"
                       Width="{DynamicResource AxToggleKnobSize}"
                       Height="{DynamicResource AxToggleKnobSize}"
                       Margin="{DynamicResource AxSpaceHairSidesThickness}"
                       Fill="{DynamicResource AxTextOnAccentBrush}"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"/>
            </Border>
          </Grid>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:checked /template/ Border#PART_Track">
      <Setter Property="Background" Value="{DynamicResource AxAccentFillBrush}"/>
    </Style>
    <Style Selector="^:checked:pointerover /template/ Border#PART_Track">
      <Setter Property="Background" Value="{DynamicResource AxAccentFillHoverBrush}"/>
    </Style>

    <!-- Нажатие: дорожка темнеет — выключенная шагом нажатия, включённая шагом акцента. -->
    <Style Selector="^:pressed:not(:checked) /template/ Border#PART_Track">
      <Setter Property="Background" Value="{DynamicResource AxPressedBrush}"/>
    </Style>
    <Style Selector="^:pressed:checked /template/ Border#PART_Track">
      <Setter Property="Background" Value="{DynamicResource AxAccentFillPressedBrush}"/>
    </Style>
    <Style Selector="^:checked /template/ Ellipse#PART_Knob">
      <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
    <Style Selector="^:focus-visible /template/ t|AxFocusRing#PART_FocusRing">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <!--
        Выключенный тумблер компонент перекрашивает, а не гасит: дорожка уходит
        на AxSurfacePanel, бегунок и подпись — на AxTextDisabled. Прозрачность дала бы
        другой цвет — AxPressed вполсилы зависит от того, что лежит под контролом,
        и на разных фонах выключенный тумблер выглядел бы по-разному.

        Положение бегунка при этом остаётся по состоянию: выключенный включённый
        тумблер показывает, что он включён, — иначе контрол врёт о своём
        значении.
    -->
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource AxTextDisabledBrush}"/>
    </Style>
    <Style Selector="^:disabled /template/ Border#PART_Track">
      <Setter Property="Background" Value="{DynamicResource AxFillDisabledBrush}"/>
    </Style>
    <Style Selector="^:disabled /template/ Ellipse#PART_Knob">
      <Setter Property="Fill" Value="{DynamicResource AxTextDisabledBrush}"/>
    </Style>
  </ControlTheme>

</ResourceDictionary>
