<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ax="using:ArxisStudio.Controls">

  <!-- Тумблер 30×17: выключен — дорожка bg4 и кноб слева, включён — акцент и кноб справа. -->
  <ControlTheme x:Key="{x:Type ax:AxToggleSwitch}" TargetType="ax:AxToggleSwitch">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_Track"
                Width="30" Height="17" CornerRadius="10"
                Background="{DynamicResource AxBg4Brush}">
          <Ellipse x:Name="PART_Knob"
                   Width="13" Height="13" Margin="2,0"
                   Fill="#FFFFFF"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"/>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:checked /template/ Border#PART_Track">
      <Setter Property="Background" Value="{DynamicResource AxAccBrush}"/>
    </Style>
    <Style Selector="^:checked /template/ Ellipse#PART_Knob">
      <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.5"/>
    </Style>
  </ControlTheme>

</ResourceDictionary>
