<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ax="using:ArxisStudio.Controls"
                    xmlns:axi="using:ArxisStudio.Icons">

  <!--
      Переключатель одного варианта: круг 16px, у выбранного — акцентная
      заливка с белой точкой. Размеры и отступ до текста те же, что у флажка.
  -->
  <ControlTheme x:Key="{x:Type ax:AxRadioButton}" TargetType="ax:AxRadioButton">
    <!-- Не обрезаем себя: кольцо фокуса выходит за границы контрола. -->
    <Setter Property="ClipToBounds" Value="False"/>

    <Setter Property="Foreground" Value="{DynamicResource AxFgBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource AxFontSize}"/>
    <Setter Property="MinHeight" Value="{DynamicResource AxControlHeightCompact}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="Template">
      <ControlTemplate>
        <!--
            Панель по содержимому, а не по строке: у контрола есть нижняя
            граница высоты в 24 — цель нажатия, — и кольцо, обнимая её, вокруг
            коробки в 16 вытягивалось капсулой. Теперь оно обнимает то, что
            видно: коробку с подписью, а без подписи — саму коробку.
        -->
        <Panel VerticalAlignment="Center">
          <!--
              Кольцо на просвет в пиксель от точки: включённая она залита тем
              же акцентом, и вплотную кольцо сливалось с ней в одно пятно.
          -->
          <Border x:Name="PART_FocusRing"
                  Margin="-3"
                  CornerRadius="6"
                  BorderThickness="{DynamicResource AxFocusOutlineThickness}"
                  BorderBrush="{DynamicResource AxOutlineFocusedBrush}"
                  IsVisible="False"/>
          <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
            <Panel Width="{DynamicResource AxCheckboxSize}"
                   Height="{DynamicResource AxCheckboxSize}"
                   VerticalAlignment="Center">
              <Ellipse x:Name="PART_Circle"
                       Fill="{DynamicResource AxInpBrush}"
                       Stroke="{DynamicResource AxBrd2Brush}"
                       StrokeThickness="1"/>
            </Panel>
            <ContentPresenter Grid.Column="1"
                              Margin="5,0,0,0"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True"
                              IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}"/>
          </Grid>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Ellipse#PART_Circle">
      <Setter Property="Stroke" Value="{DynamicResource AxFg2Brush}"/>
    </Style>
    <!-- Выбранный вариант — толстое акцентное кольцо со светлым центром. -->
    <!--
        Включённая: кольцо акцента 5 и белая точка внутри. Точка именно белая,
        а не цвета поля: в светлой теме это одно и то же, а в тёмной поле —
        почти чёрное, и вместо метки получалась дырка. Тем же белым компонент
        красит бегунок тумблера на акцентной дорожке — это одна и та же метка
        «выбрано» на залитой поверхности.
    -->
    <Style Selector="^:checked /template/ Ellipse#PART_Circle">
      <Setter Property="Fill" Value="{DynamicResource AxOnAccBrush}"/>
      <Setter Property="Stroke" Value="{DynamicResource AxAccBrush}"/>
      <Setter Property="StrokeThickness" Value="5"/>
    </Style>
    <Style Selector="^:checked:pointerover /template/ Ellipse#PART_Circle">
      <Setter Property="Stroke" Value="{DynamicResource AxAccHoverBrush}"/>
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource AxFgDisabledBrush}"/>
      <Setter Property="Cursor" Value="Arrow"/>
    </Style>
    <Style Selector="^:disabled /template/ Ellipse#PART_Circle">
      <Setter Property="Fill" Value="{DynamicResource AxInpDisabledBrush}"/>
      <Setter Property="Stroke" Value="{DynamicResource AxBrdBrush}"/>
    </Style>
    <!--
        Выключенная включённая обязана остаться включённой на вид. Точка цвета
        поля темнее кольца, и метка пропадала — выбор нельзя было прочитать.
        Проект разводит их наоборот: кольцо AxBg3, точка AxFg3, светлее кольца.
    -->
    <Style Selector="^:disabled:checked /template/ Ellipse#PART_Circle">
      <Setter Property="Fill" Value="{DynamicResource AxFg3Brush}"/>
      <Setter Property="Stroke" Value="{DynamicResource AxBg3Brush}"/>
    </Style>
  </ControlTheme>

  <!-- Разделительная линия в пиксель. -->
  <ControlTheme x:Key="{x:Type ax:AxDivider}" TargetType="ax:AxDivider">
    <Setter Property="Background" Value="{DynamicResource AxBrdBrush}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"/>
      </ControlTemplate>
    </Setter>
    <Style Selector="^[Orientation=Horizontal]">
      <Setter Property="Height" Value="1"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="^[Orientation=Vertical]">
      <Setter Property="Width" Value="1"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>
  </ControlTheme>

  <!-- Заголовок группы: подпись и линия до конца строки. -->
  <!--
      Заголовок группы: подпись основным текстом и линия до конца строки.

      Сворачиваемый — тот же заголовок со стрелкой слева и счётчиком после
      подписи. Зазор до линии в карточке разный: 10 у обычного, 8 у
      сворачиваемого — там его задаёт общий gap ряда, в который попадает и
      стрелка. Держим 10 у обычного и 8 у сворачиваемого, как размечено.
  -->
  <ControlTheme x:Key="{x:Type ax:AxGroupHeader}" TargetType="ax:AxGroupHeader">
    <Setter Property="Foreground" Value="{DynamicResource AxFgBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource AxFontSize}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="Auto,Auto,Auto,*" VerticalAlignment="Center">
          <!--
              Стрелка мелкая — тот же «отдельный класс» из раздела 6 приёмки,
              что у дерева, и той же толщины обводки: icons.md запрещает менять
              её на отдельных иконках.
          -->
          <axi:AxIcon x:Name="PART_Chevron"
                     Classes="small"
                     Margin="0,0,8,0"
                     Data="{x:Static axi:AxIcons.ChevronRight}"
                     Foreground="{DynamicResource AxFg2Brush}"
                     VerticalAlignment="Center"
                     IsVisible="{TemplateBinding IsCollapsible}"/>
          <ContentPresenter Grid.Column="1"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            VerticalAlignment="Center"/>
          <!-- Счётчик: сколько всего в группе. Вторичным текстом и мельче. -->
          <ContentPresenter x:Name="PART_Counter"
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            Content="{TemplateBinding Counter}"
                            TextBlock.Foreground="{DynamicResource AxFg2Brush}"
                            TextBlock.FontSize="{DynamicResource AxFontSizeSmall}"
                            TextElement.FontWeight="Normal"
                            VerticalAlignment="Center"
                            IsVisible="{TemplateBinding Counter, Converter={x:Static ObjectConverters.IsNotNull}}"/>
          <Border x:Name="PART_Rule"
                  Grid.Column="3"
                  Height="1"
                  Margin="10,1,0,0"
                  VerticalAlignment="Center"
                  Background="{DynamicResource AxBrdBrush}"/>
        </Grid>
      </ControlTemplate>
    </Setter>

    <Style Selector="^[IsCollapsible=True] /template/ Border#PART_Rule">
      <Setter Property="Margin" Value="8,1,0,0"/>
    </Style>
    <Style Selector="^[IsExpanded=True] /template/ axi|AxIcon#PART_Chevron">
      <Setter Property="Data" Value="{x:Static axi:AxIcons.ChevronDown}"/>
    </Style>
  </ControlTheme>

  <!--
      Половинки дорожки ползунка: заполненная слева от ручки и пустая справа.
      Темами, а не вложенными шаблонами: Track пересоздаёт кнопки, и шаблон,
      объявленный внутри него, до отрисовки не доживает.
  -->
  <ControlTheme x:Key="AxSliderRail" TargetType="RepeatButton">
    <Setter Property="Background" Value="{DynamicResource AxBg3Brush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                Height="4"
                CornerRadius="2"
                VerticalAlignment="Center"/>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="AxSliderFill" TargetType="RepeatButton"
                BasedOn="{StaticResource AxSliderRail}">
    <Setter Property="Background" Value="{DynamicResource AxAccBrush}"/>

    <!--
        Выключенное заполнение красится, а не гасится: половина прозрачности
        зависит от того, что лежит под ползунком, и на панели он выглядел бы
        иначе, чем в диалоге. Выключенное состояние — AxFgDisabled (раздел 10).
    -->
    <Style Selector="^:disabled">
      <Setter Property="Background" Value="{DynamicResource AxFgDisabledBrush}"/>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="AxSliderThumb" TargetType="Thumb">
    <Setter Property="Width" Value="14"/>
    <Setter Property="Height" Value="14"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Ellipse Fill="{DynamicResource AxBg1Brush}"
                 Stroke="{DynamicResource AxAccBrush}"
                 StrokeThickness="{DynamicResource AxFocusOutlineWidth}"/>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Ellipse">
      <Setter Property="Stroke" Value="{DynamicResource AxAccHoverBrush}"/>
    </Style>
    <Style Selector="^:disabled /template/ Ellipse">
      <Setter Property="Stroke" Value="{DynamicResource AxFgDisabledBrush}"/>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Cursor" Value="Arrow"/>
    </Style>
  </ControlTheme>

  <!-- Ползунок: дорожка 4, заполнение акцентом, ручка-круг 14 с акцентной рамкой. -->
  <ControlTheme x:Key="{x:Type ax:AxSlider}" TargetType="ax:AxSlider">
    <!-- Не обрезаем себя: кольцо фокуса выходит за границы контрола. -->
    <Setter Property="ClipToBounds" Value="False"/>

    <Setter Property="Foreground" Value="{DynamicResource AxAccBrush}"/>
    <Setter Property="Background" Value="{DynamicResource AxBg3Brush}"/>
    <Setter Property="MinHeight" Value="{DynamicResource AxControlHeightCompact}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <!-- Просвет в пиксель: заполненная часть дорожки акцентная. -->
          <Border x:Name="PART_FocusRing"
                  Margin="-3"
                  CornerRadius="6"
                  BorderThickness="{DynamicResource AxFocusOutlineThickness}"
                  BorderBrush="{DynamicResource AxOutlineFocusedBrush}"
                  IsVisible="False"/>
          <Track Name="PART_Track"
                 Minimum="{TemplateBinding Minimum}"
                 Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value, Mode=TwoWay}"
                 Orientation="Horizontal"
                 VerticalAlignment="Center">
            <Track.DecreaseButton>
              <RepeatButton Theme="{StaticResource AxSliderFill}"/>
            </Track.DecreaseButton>
            <Track.IncreaseButton>
              <RepeatButton Theme="{StaticResource AxSliderRail}"/>
            </Track.IncreaseButton>
            <Thumb Theme="{StaticResource AxSliderThumb}"/>
          </Track>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
  </ControlTheme>

</ResourceDictionary>
