<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ax="https://github.com/Arxis-Team/ArxisStudio"
                    xmlns:t="using:ArxisStudio.Themes.Arxis">

  <!--
      Переключатель одного варианта: круг 16px, у выбранного — акцентная
      заливка с белой точкой. Размеры и отступ до текста те же, что у флажка.
  -->
  <ControlTheme x:Key="{x:Type ax:AxRadioButton}" TargetType="ax:AxRadioButton">
    <!-- Не обрезаем себя: кольцо фокуса выходит за границы контрола. -->
    <Setter Property="ClipToBounds" Value="False"/>

    <Setter Property="Foreground" Value="{DynamicResource AxTextPrimaryBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource AxFontSize}"/>
    <Setter Property="MinHeight" Value="{DynamicResource AxControlHeightCompact}"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="Template">
      <ControlTemplate>
        <!--
            Панель по содержимому, а не по строке: у контрола есть нижняя
            граница высоты в 24 — цель нажатия, — и кольцо, обнимая её, вокруг
            коробки в 16 вытягивалось капсулой. Теперь оно обнимает то, что
            видно: коробку с подписью, а без подписи — саму коробку.
        -->
        <Panel VerticalAlignment="Center">
          <!--
              Кольцо на просвет в пиксель от точки: включённая она залита тем
              же акцентом, и вплотную кольцо сливалось с ней в одно пятно.
          -->
          <t:AxFocusRing x:Name="PART_FocusRing" Placement="Row"/>
          <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
            <Panel Width="{DynamicResource AxCheckboxSize}"
                   Height="{DynamicResource AxCheckboxSize}"
                   VerticalAlignment="Center">
              <Ellipse x:Name="PART_Circle"
                       Fill="{DynamicResource AxSurfaceBaseBrush}"
                       Stroke="{DynamicResource AxStrokeControlBrush}"
                       StrokeThickness="{DynamicResource AxHairline}"/>
            </Panel>
            <ContentPresenter Grid.Column="1"
                              Margin="{DynamicResource AxCheckboxGapThickness}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True"
                              IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}"/>
          </Grid>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Ellipse#PART_Circle">
      <Setter Property="Stroke" Value="{DynamicResource AxTextSecondaryBrush}"/>
    </Style>
    <!-- Выбранный вариант — толстое акцентное кольцо со светлым центром. -->
    <!--
        Включённая: кольцо акцента 5 и белая точка внутри. Точка именно белая,
        а не цвета поля: в светлой теме это одно и то же, а в тёмной поле —
        почти чёрное, и вместо метки получалась дырка. Тем же белым компонент
        красит бегунок тумблера на акцентной дорожке — это одна и та же метка
        «выбрано» на залитой поверхности.
    -->
    <Style Selector="^:checked /template/ Ellipse#PART_Circle">
      <Setter Property="Fill" Value="{DynamicResource AxTextOnAccentBrush}"/>
      <Setter Property="Stroke" Value="{DynamicResource AxAccentBrush}"/>
      <Setter Property="StrokeThickness" Value="{DynamicResource AxRadioMarkThickness}"/>
    </Style>
    <Style Selector="^:checked:pointerover /template/ Ellipse#PART_Circle">
      <Setter Property="Stroke" Value="{DynamicResource AxAccentHoverBrush}"/>
    </Style>

    <!-- Нажатие: у пустого кружка темнеет середина, у выбранного — кольцо. -->
    <Style Selector="^:pressed:not(:checked) /template/ Ellipse#PART_Circle">
      <Setter Property="Fill" Value="{DynamicResource AxPressedBrush}"/>
    </Style>
    <Style Selector="^:pressed:checked /template/ Ellipse#PART_Circle">
      <Setter Property="Stroke" Value="{DynamicResource AxAccentFillPressedBrush}"/>
    </Style>

    <Style Selector="^:focus-visible /template/ t|AxFocusRing#PART_FocusRing">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource AxTextDisabledBrush}"/>
    </Style>
    <Style Selector="^:disabled /template/ Ellipse#PART_Circle">
      <Setter Property="Fill" Value="{DynamicResource AxFillDisabledBrush}"/>
      <Setter Property="Stroke" Value="{DynamicResource AxStrokeSubtleBrush}"/>
    </Style>
    <!--
        Выключенная включённая обязана остаться включённой на вид. Точка цвета
        поля темнее кольца, и метка пропадала — выбор нельзя было прочитать.
        Проект разводит их наоборот: кольцо AxHover, точка AxTextTertiary, светлее кольца.
    -->
    <Style Selector="^:disabled:checked /template/ Ellipse#PART_Circle">
      <Setter Property="Fill" Value="{DynamicResource AxTextTertiaryBrush}"/>
      <Setter Property="Stroke" Value="{DynamicResource AxStrokeSubtleBrush}"/>
    </Style>
  </ControlTheme>

  <!-- Разделительная линия в пиксель. -->
  <!-- Разделитель рисует себя сам, без шаблона: цвет — Fill, толщина — размер по ориентации. -->
  <ControlTheme x:Key="{x:Type ax:AxDivider}" TargetType="ax:AxDivider">
    <Setter Property="Fill" Value="{DynamicResource AxStrokeSubtleBrush}"/>
    <Style Selector="^[Orientation=Horizontal]">
      <Setter Property="Height" Value="{DynamicResource AxHairline}"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="^[Orientation=Vertical]">
      <Setter Property="Width" Value="{DynamicResource AxHairline}"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>
  </ControlTheme>

  <!--
      Разделитель областей: та же линия в пиксель, что и у AxDivider, но с
      полосой захвата вокруг. Линия остаётся однопиксельной — полоса прозрачна и
      лежит поверх соседей, — иначе граница выглядела бы толстой рамкой.

      Под курсором и во время перетаскивания линия становится акцентной: у
      разделителя нет ни подписи, ни значка, и без этого узнать, что за него
      можно взяться, человеку неоткуда.

      Границу двигают не только мышью: базовый контрол разбирает стрелки и
      Home/End, но для этого его нужно уметь взять в фокус. Fluent объявлял
      Focusable своим шаблоном, а свой шаблон его не наследует — и без строки
      ниже клавиатура теряла бы разделитель вовсе. Отдельного кольца фокуса у
      него нет намеренно: кольцу нечего окружать, линия и есть весь контрол,
      поэтому фокус красит её тем же акцентом, что и наведение.
  -->
  <ControlTheme x:Key="{x:Type ax:AxSplitter}" TargetType="ax:AxSplitter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Focusable" Value="True"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}">
          <Border x:Name="PART_Line" Background="{DynamicResource AxStrokeSubtleBrush}"/>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^[Orientation=Horizontal]">
      <Setter Property="Height" Value="{DynamicResource AxSplitterLane}"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Style Selector="^ /template/ Border#PART_Line">
        <Setter Property="Height" Value="{DynamicResource AxHairline}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
    </Style>

    <Style Selector="^[Orientation=Vertical]">
      <Setter Property="Width" Value="{DynamicResource AxSplitterLane}"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Style Selector="^ /template/ Border#PART_Line">
        <Setter Property="Width" Value="{DynamicResource AxHairline}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
      </Style>
    </Style>

    <Style Selector="^:pointerover /template/ Border#PART_Line">
      <Setter Property="Background" Value="{DynamicResource AxAccentBrush}"/>
    </Style>

    <Style Selector="^:pressed /template/ Border#PART_Line">
      <Setter Property="Background" Value="{DynamicResource AxAccentBrush}"/>
    </Style>

    <Style Selector="^:focus-visible /template/ Border#PART_Line">
      <Setter Property="Background" Value="{DynamicResource AxAccentBrush}"/>
    </Style>

    <Style Selector="^:disabled /template/ Border#PART_Line">
      <Setter Property="Background" Value="{DynamicResource AxStrokeSubtleBrush}"/>
    </Style>
  </ControlTheme>

  <!-- Заголовок группы: подпись и линия до конца строки. -->
  <!--
      Заголовок группы: подпись основным текстом и линия до конца строки.

      Сворачиваемый — тот же заголовок со стрелкой слева и счётчиком после
      подписи. Зазор до линии разный: 10 у обычного, 8 у
      сворачиваемого — там его задаёт общий зазор ряда, в который попадает и
      стрелка.
  -->
  <ControlTheme x:Key="{x:Type ax:AxGroupHeader}" TargetType="ax:AxGroupHeader">
    <Setter Property="Foreground" Value="{DynamicResource AxTextPrimaryBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource AxFontSize}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="Auto,Auto,Auto,*" VerticalAlignment="Center">
          <!--
              Стрелка мелкая — тот же отдельный класс, что у дерева, и той же
              толщины обводки: на отдельных иконках её не меняют.
          -->
          <ax:AxIcon x:Name="PART_Chevron"
                     Size="Small"
                     Margin="{DynamicResource AxGapIconTextThickness}"
                     Data="{x:Static ax:AxIcons.ChevronRight}"
                     Foreground="{DynamicResource AxTextSecondaryBrush}"
                     VerticalAlignment="Center"
                     IsVisible="{TemplateBinding IsCollapsible}"/>
          <ContentPresenter Grid.Column="1"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            VerticalAlignment="Center"/>
          <!-- Счётчик: сколько всего в группе. Вторичным текстом и мельче. -->
          <ContentPresenter x:Name="PART_Counter"
                            Grid.Column="2"
                            Margin="{DynamicResource AxSpaceLeadingThickness}"
                            Content="{TemplateBinding Counter}"
                            TextBlock.Foreground="{DynamicResource AxTextSecondaryBrush}"
                            TextBlock.FontSize="{DynamicResource AxFontSizeSmall}"
                            TextElement.FontWeight="Normal"
                            VerticalAlignment="Center"
                            IsVisible="{TemplateBinding Counter, Converter={x:Static ObjectConverters.IsNotNull}}"/>
          <Border x:Name="PART_Rule"
                  Grid.Column="3"
                  Height="{DynamicResource AxHairline}"
                  Margin="{DynamicResource AxGroupRuleMargin}"
                  VerticalAlignment="Center"
                  Background="{DynamicResource AxStrokeSubtleBrush}"/>
        </Grid>
      </ControlTemplate>
    </Setter>

    <Style Selector="^[IsCollapsible=True] /template/ Border#PART_Rule">
      <Setter Property="Margin" Value="{DynamicResource AxGroupRuleMarginCollapsible}"/>
    </Style>
    <Style Selector="^[IsExpanded=True] /template/ ax|AxIcon#PART_Chevron">
      <Setter Property="Data" Value="{x:Static ax:AxIcons.ChevronDown}"/>
    </Style>
  </ControlTheme>

  <!--
      Половинки дорожки ползунка: заполненная слева от ручки и пустая справа.
      Темами, а не вложенными шаблонами: Track пересоздаёт кнопки, и шаблон,
      объявленный внутри него, до отрисовки не доживает.
  -->
  <ControlTheme x:Key="AxSliderRail" TargetType="RepeatButton">
    <Setter Property="Background" Value="{DynamicResource AxSurfaceRaisedBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                Height="{DynamicResource AxTrackHeight}"
                CornerRadius="{DynamicResource AxCornerRadiusTrack}"
                VerticalAlignment="Center"/>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="AxSliderFill" TargetType="RepeatButton"
                BasedOn="{StaticResource AxSliderRail}">
    <Setter Property="Background" Value="{DynamicResource AxAccentBrush}"/>

    <!--
        Выключенное заполнение красится, а не гасится: половина прозрачности
        зависит от того, что лежит под ползунком, и на панели он выглядел бы
        иначе, чем в диалоге. Выключенное состояние — AxTextDisabled.
    -->
    <Style Selector="^:disabled">
      <Setter Property="Background" Value="{DynamicResource AxTextDisabledBrush}"/>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="AxSliderThumb" TargetType="Thumb">
    <Setter Property="Width" Value="{DynamicResource AxSliderThumbSize}"/>
    <Setter Property="Height" Value="{DynamicResource AxSliderThumbSize}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Ellipse Fill="{DynamicResource AxSurfaceBaseBrush}"
                 Stroke="{DynamicResource AxAccentBrush}"
                 StrokeThickness="{DynamicResource AxFocusOutlineWidth}"/>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Ellipse">
      <Setter Property="Stroke" Value="{DynamicResource AxAccentHoverBrush}"/>
    </Style>
    <Style Selector="^:disabled /template/ Ellipse">
      <Setter Property="Stroke" Value="{DynamicResource AxTextDisabledBrush}"/>
    </Style>
  </ControlTheme>

  <!-- Ползунок: дорожка 4, заполнение акцентом, ручка-круг 14 с акцентной рамкой. -->
  <ControlTheme x:Key="{x:Type ax:AxSlider}" TargetType="ax:AxSlider">
    <!-- Не обрезаем себя: кольцо фокуса выходит за границы контрола. -->
    <Setter Property="ClipToBounds" Value="False"/>

    <Setter Property="Foreground" Value="{DynamicResource AxAccentBrush}"/>
    <Setter Property="Background" Value="{DynamicResource AxSurfaceRaisedBrush}"/>
    <Setter Property="MinHeight" Value="{DynamicResource AxControlHeightCompact}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <!-- Просвет в пиксель: заполненная часть дорожки акцентная. -->
          <t:AxFocusRing x:Name="PART_FocusRing" Placement="Row"/>
          <Track Name="PART_Track"
                 Minimum="{TemplateBinding Minimum}"
                 Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value, Mode=TwoWay}"
                 Orientation="Horizontal"
                 VerticalAlignment="Center">
            <Track.DecreaseButton>
              <RepeatButton Theme="{StaticResource AxSliderFill}"/>
            </Track.DecreaseButton>
            <Track.IncreaseButton>
              <RepeatButton Theme="{StaticResource AxSliderRail}"/>
            </Track.IncreaseButton>
            <Thumb Theme="{StaticResource AxSliderThumb}"/>
          </Track>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:focus-visible /template/ t|AxFocusRing#PART_FocusRing">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
  </ControlTheme>

</ResourceDictionary>
