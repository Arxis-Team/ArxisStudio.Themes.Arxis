<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ax="using:ArxisStudio.Controls">

  <!--
      Инструменты каркаса: главный тулбар, хлебные крошки, лоадер, блок кода
      и таблица-список. Все — плоские: фон им даёт место, где они стоят.
  -->

  <!-- Главный тулбар: три слота, живёт внутри AxTitleBar, фона не несёт. -->
  <ControlTheme x:Key="{x:Type ax:AxToolBar}" TargetType="ax:AxToolBar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="*,Auto,*" Background="{TemplateBinding Background}">
          <ContentPresenter Content="{TemplateBinding LeftContent}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"/>
          <ContentPresenter Grid.Column="1"
                            Content="{TemplateBinding CenterContent}"
                            VerticalAlignment="Center"/>
          <ContentPresenter Grid.Column="2"
                            Content="{TemplateBinding RightContent}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"/>
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- Хлебные крошки: строка звеньев, шеврон-разделитель рисует звено. -->
  <ControlTheme x:Key="{x:Type ax:AxBreadcrumbBar}" TargetType="ax:AxBreadcrumbBar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadius}"/>
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal"/>
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ItemsPresenter x:Name="PART_ItemsPresenter"
                          ItemsPanel="{TemplateBinding ItemsPanel}"/>
        </Border>
      </ControlTemplate>
    </Setter>

    <!--
        Дерево контролов в дизайнере: та же строка, но в рамке на своей
        подложке. Карточка даёт ей высоту 32 и радиус 6 — ни того, ни другого
        в шкале проекта нет (высоты 24 и 28, радиусы 3 / 4 / 8), поэтому взяты
        AxControlHeight и AxCornerRadius.

        Отбивка 4, а не 10 из карточки: там звенья внутри рамки идут без своей
        отбивки, у нас она остаётся — на ней держится плашка наведения. Четыре
        панели плюс шесть звена дают те же 10 до первой подписи.
    -->
    <Style Selector="^.framed">
      <Setter Property="Background" Value="{DynamicResource AxBgSunkenBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AxBrdBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Height" Value="{DynamicResource AxControlHeight}"/>
      <Setter Property="Padding" Value="4,0"/>
    </Style>
  </ControlTheme>

  <!--
      Звено крошек: вторичный текст, ведущий себя как ссылка; текущее (класс
      current) читается основным, звено с проблемой (класс error) — красным
      текстом. Шеврон-разделитель стоит слева и прячется у первого звена.
  -->
  <ControlTheme x:Key="{x:Type ax:AxBreadcrumbItem}" TargetType="ax:AxBreadcrumbItem">
    <Setter Property="Foreground" Value="{DynamicResource AxFg2Brush}"/>
    <Setter Property="FontSize" Value="{DynamicResource AxFontSize}"/>
    <!-- Звено: 6 по горизонтали и 2 по вертикали, радиус контрольный. -->
    <Setter Property="Padding" Value="6,2"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadius}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Orientation="Horizontal">
          <!--
              Разделитель идёт цветом иконки в покое: в карточке он того же
              серого, что и глиф папки в звене, а не бледнее его.
          -->
          <ax:AxIcon x:Name="PART_Separator"
                     Classes="small"
                     Margin="4,0"
                     Data="{x:Static ax:AxIcons.ChevronRight}"
                     Foreground="{DynamicResource AxFg2Brush}"
                     VerticalAlignment="Center"/>
          <Border x:Name="PART_LayoutRoot"
                  Background="Transparent"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <!-- Значок: глиф папки, плашка типа файла или своё. -->
              <ContentPresenter x:Name="PART_Icon"
                                Content="{TemplateBinding Icon}"
                                VerticalAlignment="Center"
                                IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}"/>
              <ContentPresenter Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:nth-child(1) /template/ ax|AxIcon#PART_Separator">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource AxFgBrush}"/>
    </Style>
    <Style Selector="^:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource AxBg3Brush}"/>
    </Style>
    <!--
        Текущее звено и звено с ошибкой набраны усиленным начертанием: в конце
        пути это единственное, что отличает цель от пройденных звеньев, когда
        цвет уже занят состоянием.
    -->
    <Style Selector="^.current">
      <Setter Property="Foreground" Value="{DynamicResource AxFgBrush}"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Cursor" Value="Arrow"/>
    </Style>
    <Style Selector="^.current:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="^.error">
      <Setter Property="Foreground" Value="{DynamicResource AxRedTextBrush}"/>
      <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="^.error /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource AxErrorBackgroundBrush}"/>
    </Style>
    <!--
        Выключенная строка (раздел 10 спецификации): текст на AxFgDisabled.
        Стиль стоит последним намеренно — выделение и наведение объявлены выше,
        и без этого выключенная выбранная строка выглядела бы обычной.
    -->
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource AxFgDisabledBrush}"/>
    </Style>
    <!--
        Разделитель гаснет вместе со звеном: свой цвет у него задан прямо в
        шаблоне и от Foreground звена не зависит, а в карточке выключенный
        путь погашен целиком — вместе с шевронами.
    -->
    <Style Selector="^:disabled /template/ ax|AxIcon#PART_Separator">
      <Setter Property="Foreground" Value="{DynamicResource AxFgDisabledBrush}"/>
    </Style>

  </ControlTheme>

  <!-- Лоадер: дуга на четверть круга, оборот за 0.8 с линейно. -->
  <ControlTheme x:Key="{x:Type ax:AxSpinner}" TargetType="ax:AxSpinner">
    <Setter Property="Width" Value="{DynamicResource AxIconSize}"/>
    <Setter Property="Height" Value="{DynamicResource AxIconSize}"/>
    <Setter Property="Foreground" Value="{DynamicResource AxAccBrush}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <ax:AxIcon x:Name="PART_Arc"
                   Width="{TemplateBinding Width}"
                   Height="{TemplateBinding Height}"
                   Data="M 8 2.5 A 5.5 5.5 0 1 1 2.5 8"
                   Foreground="{TemplateBinding Foreground}">
          <ax:AxIcon.RenderTransform>
            <RotateTransform/>
          </ax:AxIcon.RenderTransform>
        </ax:AxIcon>
      </ControlTemplate>
    </Setter>

    <Style Selector="^ /template/ ax|AxIcon#PART_Arc">
      <Style.Animations>
        <Animation Duration="0:0:0.8" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="RotateTransform.Angle" Value="0"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="RotateTransform.Angle" Value="360"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </ControlTheme>

  <!-- Блок кода: моноширинный текст с подсветкой кистями AxCode*. -->
  <ControlTheme x:Key="{x:Type ax:AxCodeBlock}" TargetType="ax:AxCodeBlock">
    <Setter Property="Background" Value="{DynamicResource AxInpBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AxBrdBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadiusLarge}"/>
    <Setter Property="Padding" Value="14,12"/>
    <Setter Property="FontFamily" Value="{DynamicResource AxFontFamilyMono}"/>
    <Setter Property="FontSize" Value="{DynamicResource AxFontSizeSmall}"/>
    <Setter Property="Foreground" Value="{DynamicResource AxCodeFgBrush}"/>
    <Setter Property="TagBrush" Value="{DynamicResource AxCodeTagBrush}"/>
    <Setter Property="AttributeBrush" Value="{DynamicResource AxCodeAttrBrush}"/>
    <Setter Property="StringBrush" Value="{DynamicResource AxCodeStringBrush}"/>
    <Setter Property="CommentBrush" Value="{DynamicResource AxCodeCommentBrush}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ScrollViewer HorizontalScrollBarVisibility="Auto">
            <SelectableTextBlock x:Name="PART_Text"
                                 FontFamily="{TemplateBinding FontFamily}"
                                 FontSize="{TemplateBinding FontSize}"
                                 Foreground="{TemplateBinding Foreground}"
                                 LineHeight="18"/>
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!--
      Таблица карточки «Table · формы проекта»: никакой рамки вокруг и никакой
      заливки под шапкой — таблицу держат линейки. Шапка отбита снизу, каждая
      строка отбита снизу, и только у последней и у выбранной отбивки нет:
      линия под выделением разрезала бы его полосу.

      Строка идёт на AxRowHeight, как записано в разделе 9 спецификации,
      поэтому вертикальные 6 из карточки в отбивку ячейки не попадают — их
      съедает высота строки. Горизонтальные 10 остаются и стоят на ячейке, а
      не на строке: иначе отступ был бы только у первой колонки, а остальные
      начинались бы вплотную к своей границе.
  -->
  <ControlTheme x:Key="{x:Type ax:AxDataGrid}" TargetType="ax:AxDataGrid">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="ItemContainerTheme">
      <ControlTheme TargetType="ax:AxListBoxItem"
                    BasedOn="{StaticResource {x:Type ax:AxListBoxItem}}">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>

        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="BorderBrush" Value="{DynamicResource AxBrdBrush}"/>
          <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <!--
            Ниже базовой отбивки: у последней строки линия висела бы над
            пустотой, у выбранной — резала бы её полосу пополам.
        -->
        <Style Selector="^:nth-last-child(1) /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="BorderThickness" Value="0"/>
        </Style>
      </ControlTheme>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}">
          <DockPanel>
            <Border DockPanel.Dock="Top"
                    BorderBrush="{DynamicResource AxBrdBrush}"
                    BorderThickness="0,0,0,1"
                    MinHeight="{DynamicResource AxRowHeight}"
                    IsVisible="{TemplateBinding Header, Converter={x:Static ObjectConverters.IsNotNull}}">
              <ContentPresenter Content="{TemplateBinding Header}"
                                VerticalAlignment="Center"
                                TextBlock.Foreground="{DynamicResource AxFg2Brush}"
                                TextBlock.FontSize="{DynamicResource AxFontSizeSmall}"/>
            </Border>
            <ScrollViewer x:Name="PART_ScrollViewer">
              <ItemsPresenter x:Name="PART_ItemsPresenter"
                              ItemsPanel="{TemplateBinding ItemsPanel}"
                              Margin="{TemplateBinding Padding}"/>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>
