<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ax="https://github.com/Arxis-Team/ArxisStudio">

  <!--
      Кнопка выбора: контурная кнопка с шевроном справа, щелчок открывает
      Flyout. Состояния — как у AxButton; вариантов заливки у неё нет: выбор
      не бывает основным действием.
  -->
  <ControlTheme x:Key="{x:Type ax:AxDropDownButton}" TargetType="ax:AxDropDownButton">
    <!-- Не обрезаем себя: кольцо фокуса выходит за границы контрола. -->
    <Setter Property="ClipToBounds" Value="False"/>

    <!-- Наименьшая высота и центр — по той же причине, что у кнопки. -->
    <Setter Property="MinHeight" Value="{DynamicResource AxControlHeight}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="MinWidth" Value="{DynamicResource AxButtonMinWidth}"/>
    <!--
        Отступы свои, не кнопочные: справа шеврон, и ему нужно меньше места,
        чем тексту слева. Проект так и объявляет — 10 слева, 8 справа.
    -->
    <Setter Property="Padding" Value="{DynamicResource AxDropDownButtonPadding}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadius}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AxStrokeControlBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource AxTextPrimaryBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource AxFontSize}"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <!-- Длинная подпись — как у кнопки: многоточие, а целиком в подсказке. -->
    <Setter Property="ToolTip.Tip" Value=""/>
    <Setter Property="ax:AxTrimmedTip.IsEnabled" Value="True"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border x:Name="PART_FocusRing"
                  Margin="{DynamicResource AxFocusOutlineOuterMargin}"
                  CornerRadius="{DynamicResource AxCornerRadiusFocusOuter}"
                  BorderThickness="{DynamicResource AxFocusOutlineOuter}"
                  BorderBrush="{DynamicResource AxFocusRingBrush}"
                  IsVisible="False"/>
          <Border x:Name="PART_Background"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <Grid ColumnDefinitions="*,Auto">
              <ContentPresenter Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                TextTrimming="CharacterEllipsis"
                                RecognizesAccessKey="True"/>
              <ax:AxIcon Grid.Column="1"
                         x:Name="PART_Chevron"
                         Size="Small"
                         Margin="{DynamicResource AxSpaceSnugLeadingThickness}"
                         Data="{x:Static ax:AxIcons.ChevronDown}"
                         Foreground="{DynamicResource AxTextSecondaryBrush}"
                         VerticalAlignment="Center"/>
            </Grid>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Border#PART_Background">
      <Setter Property="Background" Value="{DynamicResource AxHoverBrush}"/>
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_Background">
      <Setter Property="Background" Value="{DynamicResource AxPressedBrush}"/>
    </Style>
    <!--
        В фокусе рамка контрола сама становится акцентной: контур складывается
        из неё и кольца снаружи — 1 + 1, как объявляют компоненты проекта. Без
        этого у дропдауна контур выходил тоньше, чем у кнопки и поля рядом.
    -->
    <Style Selector="^:focus-visible /template/ Border#PART_Background">
      <Setter Property="BorderBrush" Value="{DynamicResource AxFocusRingBrush}"/>
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource AxTextDisabledBrush}"/>
      <Setter Property="Cursor" Value="Arrow"/>
    </Style>
    <Style Selector="^:disabled /template/ Border#PART_Background">
      <Setter Property="Background" Value="{DynamicResource AxSurfaceRaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AxSurfaceRaisedBrush}"/>
    </Style>
    <Style Selector="^:disabled /template/ ax|AxIcon#PART_Chevron">
      <Setter Property="Foreground" Value="{DynamicResource AxTextDisabledBrush}"/>
    </Style>
  </ControlTheme>

</ResourceDictionary>
