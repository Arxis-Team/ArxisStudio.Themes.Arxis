<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ax="https://github.com/Arxis-Team/ArxisStudio">

  <!--
      Кнопка Int UI: 28 высотой, скругление 4, отступы 12×6, минимальная ширина 72.
      Классы: без класса — контурная, accent — акцентная (основное действие),
      ghost — без рамки до наведения, icon — компактная под одну иконку,
      compact — пониже и потеснее для панелей, danger — красный акцент на
      наведении (закрыть, удалить).

      Контур фокуса рисуется отдельным слоем поверх фона и выходит за границы
      кнопки на 2px, как в Int UI: рамка контрола при этом остаётся на месте,
      поэтому кнопка не дёргается, получая фокус.
  -->
  <ControlTheme x:Key="{x:Type ax:AxButton}" TargetType="ax:AxButton">
    <!--
        Контрол не обрезает себя: кольцо фокуса выходит за его границы, а
        TemplatedControl в Avalonia обрезает содержимое по ним. Обрезка нужна
        не контролу целиком, а тем его частям, которым она нужна, — там она и
        стоит.
    -->
    <Setter Property="ClipToBounds" Value="False"/>

    <!--
        Высота — наименьшая, а не единственная. Двадцать восемь это высота
        кнопки при кегле темы; вырасти кегль — вместе с настройкой размера
        текста или у крупного шрифта плагина, — и прибитая высота срезала бы
        подпись снизу, ни словом об этом не сказав. Проверено прогоном с
        удвоенной шкалой кеглей: срезались все кнопки студии до одной.

        Выравнивание по центру держит прежнее поведение там, где кнопка стоит в
        ячейке выше себя: прибитая высота в растянутой ячейке и так вставала по
        центру, а наименьшая без этого растянулась бы на всю ячейку.
    -->
    <Setter Property="MinHeight" Value="{DynamicResource AxControlHeight}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="MinWidth" Value="{DynamicResource AxButtonMinWidth}"/>
    <Setter Property="Padding" Value="{DynamicResource AxButtonPadding}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadius}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AxBrd2Brush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource AxFgBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource AxFontSize}"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <!--
        Подпись, которой не хватает ширины, кончается многоточием, а целиком
        читается в подсказке. Срезанная краем, она обрывалась на полуслове и
        ничем не говорила, что срезана, — так стояла «Сосчитать файлы проекта»
        в узкой панели при двойном кегле.

        Пустая подсказка — не подсказка, а условие: без неё Avalonia не
        спрашивает, открывать ли. Решает AxTrimmedTip в миг открытия — только
        у сокращённой подписи, — а подсказка, данная кнопке явно, остаётся её
        собственной.
    -->
    <Setter Property="ToolTip.Tip" Value=""/>
    <Setter Property="ax:AxTrimmedTip.IsEnabled" Value="True"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border x:Name="PART_FocusRing"
                  Margin="{DynamicResource AxFocusOutlineOuterMargin}"
                  CornerRadius="{DynamicResource AxCornerRadiusFocusOuter}"
                  BorderThickness="{DynamicResource AxFocusOutlineOuter}"
                  BorderBrush="{DynamicResource AxOutlineFocusedBrush}"
                  IsVisible="False"/>
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            TextTrimming="CharacterEllipsis"
                            RecognizesAccessKey="True"/>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True"/>
    </Style>

    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AxBg3Brush}"/>
    </Style>
    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AxBg4Brush}"/>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource AxFgDisabledBrush}"/>
      <Setter Property="Cursor" Value="Arrow"/>
    </Style>
    <!-- Выключенная кнопка по компоненту: фон выключенного поля, рамка та же. -->
    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AxInpDisabledBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AxBrd2Brush}"/>
    </Style>

    <!-- В фокусе и рамка контрола красится акцентом — как в компоненте. -->
    <Style Selector="^:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource AxOutlineFocusedBrush}"/>
    </Style>

    <!-- Акцентная кнопка: основное действие диалога или экрана. -->
    <!--
        Акцентная кнопка — залитая поверхность, на которой стоит текст, поэтому
        AxAccStrong, а не AxAcc: белый на AxAcc даёт 4,28:1. Наведение темнеет
        в обоих вариантах темы.
    -->
    <Style Selector="^.accent">
      <Setter Property="Background" Value="{DynamicResource AxAccStrongBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AxOnAccBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AxAccStrongBrush}"/>
    </Style>
    <Style Selector="^.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AxAccStrongHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AxAccStrongHoverBrush}"/>
    </Style>
    <Style Selector="^.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AxAccPressedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AxAccPressedBrush}"/>
    </Style>
    <!-- Выключенный вид один на все классы — компонент не различает их. -->
    <Style Selector="^.accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AxInpDisabledBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AxBrd2Brush}"/>
    </Style>

    <Style Selector="^.ghost">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Padding" Value="{DynamicResource AxButtonPaddingGhost}"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Foreground" Value="{DynamicResource AxFg2Brush}"/>
    </Style>
    <Style Selector="^.ghost:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource AxFgBrush}"/>
    </Style>

    <!-- Кнопка под одну иконку: без рамки, без минимальной ширины. -->
    <Style Selector="^.icon">
      <Setter Property="Width" Value="{DynamicResource AxControlHeightCompact}"/>
      <Setter Property="Height" Value="{DynamicResource AxControlHeightCompact}"/>
      <!--
          Под одну иконку текста нет, и расти нечему: квадрат цели нажатия
          прибит сознательно. Наименьшая высота базы — двадцать восемь — иначе
          распёрла бы его до прямоугольника.
      -->
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadius}"/>
      <Setter Property="Foreground" Value="{DynamicResource AxFg2Brush}"/>
    </Style>
    <Style Selector="^.icon:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource AxFgBrush}"/>
    </Style>
    <!--
        Выключенная иконочная кнопка гаснет глифом, а не плашкой: своей заливки
        у неё нет и в покое, и в карточке тулбара выключенная стоит на голом
        фоне. Фон выключенного поля остаётся кнопке с рамкой.
    -->
    <Style Selector="^.icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <!--
        Включённый инструмент: заливка выделения, глиф акцентом. Состояние
        ставится псевдоклассом :selected — так его записывает раздел 10, и
        своего свойства у кнопки под это нет: включённость инструмента знает
        приложение, а не контрол.
    -->
    <Style Selector="^.icon:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AxSelBrush}"/>
    </Style>
    <Style Selector="^.icon:selected">
      <Setter Property="Foreground" Value="{DynamicResource AxAccBrush}"/>
    </Style>

    <!-- Кнопка в тесном месте: панель инструментов, подвал панели. -->
    <Style Selector="^.compact">
      <Setter Property="MinHeight" Value="{DynamicResource AxControlHeightCompact}"/>
      <Setter Property="MinWidth" Value="{DynamicResource AxButtonMinWidthCompact}"/>
      <Setter Property="Padding" Value="{DynamicResource AxButtonPadding}"/>
      <Setter Property="FontSize" Value="{DynamicResource AxFontSizeSmall}"/>
    </Style>
    <!-- Слим-кнопка под одну иконку или в подвале панели: без мин-ширины. -->
    <Style Selector="^.compact.ghost">
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Padding" Value="{DynamicResource AxButtonPaddingGhost}"/>
    </Style>

    <!--
        Деструктивная кнопка контурная: красный ТЕКСТ (AxRedText, 4,5:1), а не
        красная заливка — наведение подсвечивает фон и красит рамку.
    -->
    <Style Selector="^.danger">
      <Setter Property="Foreground" Value="{DynamicResource AxRedTextBrush}"/>
    </Style>
    <Style Selector="^.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AxBg3Brush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AxRedTextBrush}"/>
    </Style>
    <Style Selector="^.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AxBg4Brush}"/>
    </Style>
  </ControlTheme>

  <!--
      Иконочная кнопка внутри другого контрола: крестик очистки в поле поиска,
      крестик закрытия в баннере. Цель нажатия прежняя, 24, а плашки нет.
      Обычная иконочная кнопка кладёт под себя заливку во всю эту цель, и
      внутри поля высотой 28 или полосы баннера она встаёт почти во всю высоту,
      вплотную к краю, — рядом с текстом это читается как вторая кнопка, а не
      как «стереть» или «закрыть». Проект рисует там голый глиф, и на наведении
      меняется он сам, а не фон под ним.
  -->
  <ControlTheme x:Key="AxInlineIconButton" TargetType="ax:AxButton"
                BasedOn="{StaticResource {x:Type ax:AxButton}}">
    <Setter Property="Width" Value="{DynamicResource AxControlHeightCompact}"/>
    <Setter Property="Height" Value="{DynamicResource AxControlHeightCompact}"/>
    <!-- Квадрат без текста: наименьшая высота базы распёрла бы полосу поля и баннера. -->
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource AxFg2Brush}"/>

    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource AxFgBrush}"/>
    </Style>
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
  </ControlTheme>

</ResourceDictionary>
