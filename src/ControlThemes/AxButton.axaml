<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ax="using:ArxisStudio.Controls">

  <!--
      Кнопка Int UI: 28 высотой, скругление 4, отступы 12×6, минимальная ширина 72.
      Классы: без класса — контурная, accent — акцентная (основное действие),
      ghost — без рамки до наведения, icon — компактная под одну иконку,
      compact — пониже и потеснее для панелей, danger — красный акцент на
      наведении (закрыть, удалить).

      Контур фокуса рисуется отдельным слоем поверх фона и выходит за границы
      кнопки на 2px, как в Int UI: рамка контрола при этом остаётся на месте,
      поэтому кнопка не дёргается, получая фокус.
  -->
  <ControlTheme x:Key="{x:Type ax:AxButton}" TargetType="ax:AxButton">
    <Setter Property="Height" Value="{DynamicResource AxControlHeight}"/>
    <Setter Property="MinWidth" Value="{DynamicResource AxButtonMinWidth}"/>
    <Setter Property="Padding" Value="{DynamicResource AxButtonPadding}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadius}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AxBrd2Brush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource AxFgBrush}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border x:Name="PART_FocusRing"
                  Margin="-2"
                  CornerRadius="6"
                  BorderThickness="{DynamicResource AxFocusOutlineThickness}"
                  BorderBrush="{DynamicResource AxOutlineFocusedBrush}"
                  IsVisible="False"/>
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True"/>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True"/>
    </Style>

    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AxBg3Brush}"/>
    </Style>
    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AxBg4Brush}"/>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource AxFgDisabledBrush}"/>
      <Setter Property="Cursor" Value="Arrow"/>
    </Style>
    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AxBrdBrush}"/>
    </Style>

    <!-- Акцентная кнопка: основное действие диалога или экрана. -->
    <Style Selector="^.accent">
      <Setter Property="Background" Value="{DynamicResource AxAccBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AxOnAccBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AxAccBrush}"/>
      <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="^.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AxAccHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AxAccHoverBrush}"/>
    </Style>
    <Style Selector="^.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AxAccPressedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AxAccPressedBrush}"/>
    </Style>
    <Style Selector="^.accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AxBg3Brush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AxBg3Brush}"/>
    </Style>

    <Style Selector="^.ghost">
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Кнопка под одну иконку: без рамки, без минимальной ширины. -->
    <Style Selector="^.icon">
      <Setter Property="Width" Value="{DynamicResource AxControlHeightCompact}"/>
      <Setter Property="Height" Value="{DynamicResource AxControlHeightCompact}"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadiusSmall}"/>
      <Setter Property="Foreground" Value="{DynamicResource AxFg2Brush}"/>
    </Style>

    <!-- Кнопка в тесном месте: панель инструментов, подвал панели. -->
    <Style Selector="^.compact">
      <Setter Property="Height" Value="{DynamicResource AxControlHeightCompact}"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="FontSize" Value="11.5"/>
    </Style>

    <Style Selector="^.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AxRedBrush}"/>
    </Style>
    <Style Selector="^.danger:pointerover">
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
  </ControlTheme>

</ResourceDictionary>
