<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ax="https://github.com/Arxis-Team/ArxisStudio">

  <!--
      Кнопка: 28 высотой, скругление 4, отступы 12×6, минимальная ширина 72.
      Вид — свойство Appearance, размер — Size, и тема видит их псевдоклассами:
      без них — контурная; :primary — акцентная (основное действие); :subtle — без
      рамки до наведения; :toolbar — квадрат под одну иконку; :danger — красный
      текст (закрыть, удалить); :compact — пониже и потеснее для панелей.

      Контур фокуса рисуется отдельным слоем поверх фона и выходит за границы
      кнопки на 2px: рамка контрола при этом остаётся на месте,
      поэтому кнопка не дёргается, получая фокус.

      Шаблон и виды общие у кнопки и у кнопки-переключателя: у них разные базы
      Avalonia, и тема ключом AxButtonBase держит одно описание на обе, а
      переключатель добавляет к нему только включённость.
  -->
  <ControlTheme x:Key="AxButtonBase" TargetType="Button">
    <!--
        Контрол не обрезает себя: кольцо фокуса выходит за его границы, а
        TemplatedControl в Avalonia обрезает содержимое по ним. Обрезка нужна
        не контролу целиком, а тем его частям, которым она нужна, — там она и
        стоит.
    -->
    <Setter Property="ClipToBounds" Value="False"/>

    <!--
        Высота — наименьшая, а не единственная. Двадцать восемь это высота
        кнопки при кегле темы; вырасти кегль — вместе с настройкой размера
        текста или у крупного шрифта плагина, — и прибитая высота срезала бы
        подпись снизу, ни словом об этом не сказав. Проверено прогоном с
        удвоенной шкалой кеглей: срезались все кнопки студии до одной.

        Выравнивание по центру держит прежнее поведение там, где кнопка стоит в
        ячейке выше себя: прибитая высота в растянутой ячейке и так вставала по
        центру, а наименьшая без этого растянулась бы на всю ячейку.
    -->
    <Setter Property="MinHeight" Value="{DynamicResource AxControlHeight}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="MinWidth" Value="{DynamicResource AxButtonMinWidth}"/>
    <Setter Property="Padding" Value="{DynamicResource AxButtonPadding}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadius}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AxStrokeControlBrush}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource AxHairlineThickness}"/>
    <Setter Property="Foreground" Value="{DynamicResource AxTextPrimaryBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource AxFontSize}"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <!--
        Подпись, которой не хватает ширины, кончается многоточием, а целиком
        читается в подсказке. Срезанная краем, она обрывалась на полуслове и
        ничем не говорила, что срезана, — так стояла «Сосчитать файлы проекта»
        в узкой панели при двойном кегле.

        Пустая подсказка — не подсказка, а условие: без неё Avalonia не
        спрашивает, открывать ли. Решает AxTrimmedTip в миг открытия — только
        у сокращённой подписи, — а подсказка, данная кнопке явно, остаётся её
        собственной.
    -->
    <Setter Property="ToolTip.Tip" Value=""/>
    <Setter Property="ax:AxTrimmedTip.IsEnabled" Value="True"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border x:Name="PART_FocusRing"
                  Margin="{DynamicResource AxFocusOutlineOuterMargin}"
                  CornerRadius="{DynamicResource AxCornerRadiusFocusOuter}"
                  BorderThickness="{DynamicResource AxFocusOutlineOuter}"
                  BorderBrush="{DynamicResource AxFocusRingBrush}"
                  IsVisible="False"/>
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            TextTrimming="CharacterEllipsis"
                            RecognizesAccessKey="True"/>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True"/>
    </Style>

    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AxHoverBrush}"/>
    </Style>
    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AxPressedBrush}"/>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource AxTextDisabledBrush}"/>
      <Setter Property="Cursor" Value="Arrow"/>
    </Style>
    <!-- Выключенная кнопка: фон выключенного поля, рамка та же. -->
    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AxFillDisabledBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AxStrokeControlBrush}"/>
    </Style>

    <!-- В фокусе и рамка контрола красится акцентом. -->
    <Style Selector="^:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource AxFocusRingBrush}"/>
    </Style>

    <!-- Акцентная кнопка: основное действие диалога или экрана. -->
    <!--
        Акцентная кнопка — залитая поверхность, на которой стоит текст, поэтому
        AxAccentFill, а не AxAccent: белый на AxAccent в тёмной теме даёт 3,15:1. Наведение темнеет
        в обоих вариантах темы.
    -->
    <Style Selector="^:primary">
      <Setter Property="Background" Value="{DynamicResource AxAccentFillBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AxTextOnAccentBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AxAccentFillBrush}"/>
    </Style>
    <Style Selector="^:primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AxAccentFillHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AxAccentFillHoverBrush}"/>
    </Style>
    <Style Selector="^:primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AxAccentFillPressedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AxAccentFillPressedBrush}"/>
    </Style>
    <!-- Выключенный вид один на все виды. -->
    <Style Selector="^:primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AxFillDisabledBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AxStrokeControlBrush}"/>
    </Style>

    <Style Selector="^:subtle">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Padding" Value="{DynamicResource AxButtonPaddingGhost}"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Foreground" Value="{DynamicResource AxTextSecondaryBrush}"/>
    </Style>
    <Style Selector="^:subtle:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource AxTextPrimaryBrush}"/>
    </Style>

    <!-- Кнопка под одну иконку: без рамки, без минимальной ширины. -->
    <Style Selector="^:toolbar">
      <Setter Property="Width" Value="{DynamicResource AxToolbarButtonSize}"/>
      <Setter Property="Height" Value="{DynamicResource AxToolbarButtonSize}"/>
      <!--
          Под одну иконку текста нет, и расти нечему: квадрат цели нажатия
          прибит сознательно. Наименьшая высота базы — двадцать восемь — иначе
          распёрла бы его до прямоугольника.
      -->
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadius}"/>
      <Setter Property="Foreground" Value="{DynamicResource AxTextSecondaryBrush}"/>
    </Style>
    <Style Selector="^:toolbar:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource AxTextPrimaryBrush}"/>
    </Style>
    <!--
        Выключенная иконочная кнопка гаснет глифом, а не плашкой: своей заливки
        у неё нет и в покое, и в тулбаре выключенная стоит на голом
        фоне. Фон выключенного поля остаётся кнопке с рамкой.
    -->
    <Style Selector="^:toolbar:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <!-- Кнопка в тесном месте: панель инструментов, подвал панели. -->
    <Style Selector="^:compact">
      <Setter Property="MinHeight" Value="{DynamicResource AxControlHeightCompact}"/>
      <Setter Property="MinWidth" Value="{DynamicResource AxButtonMinWidthCompact}"/>
      <Setter Property="Padding" Value="{DynamicResource AxButtonPadding}"/>
      <Setter Property="FontSize" Value="{DynamicResource AxFontSizeSmall}"/>
    </Style>
    <!-- Тесная кнопка без рамки — в полосе или в подвале панели: без мин-ширины. -->
    <Style Selector="^:compact:subtle">
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Padding" Value="{DynamicResource AxButtonPaddingGhost}"/>
    </Style>

    <!--
        Деструктивная кнопка контурная: красный ТЕКСТ (AxErrorText, 4,5:1), а не
        красная заливка — наведение подсвечивает фон и красит рамку.
    -->
    <Style Selector="^:danger">
      <Setter Property="Foreground" Value="{DynamicResource AxErrorTextBrush}"/>
    </Style>
    <Style Selector="^:danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AxHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AxErrorTextBrush}"/>
    </Style>
    <Style Selector="^:danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AxPressedBrush}"/>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ax:AxButton}" TargetType="ax:AxButton"
                BasedOn="{StaticResource AxButtonBase}"/>

  <!--
      Кнопка-переключатель: тот же вид, и включённость поверх него. Включённая
      лежит на заливке выделения: у иконочной глиф идёт акцентом, у кнопки с
      подписью текст — основным цветом. Прежде это состояние ставили наследники
      кнопки псевдоклассом :selected, а текстовую включённую рисовали стили
      оболочки студии — теме оно было неизвестно.
  -->
  <ControlTheme x:Key="{x:Type ax:AxToggleButton}" TargetType="ax:AxToggleButton"
                BasedOn="{StaticResource AxButtonBase}">
    <Style Selector="^:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AxSelectionActiveBrush}"/>
    </Style>
    <Style Selector="^:checked">
      <Setter Property="Foreground" Value="{DynamicResource AxTextPrimaryBrush}"/>
    </Style>
    <Style Selector="^:toolbar:checked">
      <Setter Property="Foreground" Value="{DynamicResource AxAccentBrush}"/>
    </Style>
  </ControlTheme>

  <!--
      Иконочная кнопка внутри другого контрола: крестик очистки в поле поиска,
      крестик закрытия в баннере. Цель нажатия прежняя, 24, а плашки нет.
      Обычная иконочная кнопка кладёт под себя заливку во всю эту цель, и
      внутри поля высотой 28 или полосы баннера она встаёт почти во всю высоту,
      вплотную к краю, — рядом с текстом это читается как вторая кнопка, а не
      как «стереть» или «закрыть». Поэтому там голый глиф, и на наведении
      меняется он сам, а не фон под ним.
  -->
  <ControlTheme x:Key="AxInlineIconButton" TargetType="ax:AxButton"
                BasedOn="{StaticResource {x:Type ax:AxButton}}">
    <Setter Property="Width" Value="{DynamicResource AxControlHeightCompact}"/>
    <Setter Property="Height" Value="{DynamicResource AxControlHeightCompact}"/>
    <!-- Квадрат без текста: наименьшая высота базы распёрла бы полосу поля и баннера. -->
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource AxTextSecondaryBrush}"/>

    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource AxTextPrimaryBrush}"/>
    </Style>
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
  </ControlTheme>

</ResourceDictionary>
