<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ax="using:ArxisStudio.Controls">

  <!--
      Поле ввода Int UI: 28 высотой, скругление 4, горизонтальный отступ 9
      (8 + пиксель рамки). В фокусе появляется контур 2px, а рамка меняет цвет
      на акцентный; класс error окрашивает контур красным, warning — жёлтым.
  -->
  <ControlTheme x:Key="{x:Type ax:AxTextBox}" TargetType="ax:AxTextBox">
    <Setter Property="MinHeight" Value="{DynamicResource AxControlHeight}"/>
    <Setter Property="Padding" Value="{DynamicResource AxTextFieldPadding}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadius}"/>
    <Setter Property="Background" Value="{DynamicResource AxInpBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AxBrd2Brush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource AxFgBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource AxFontSize}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <!-- Карет акцентный — как в компоненте поля. -->
    <Setter Property="CaretBrush" Value="{DynamicResource AxAccBrush}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource AxSelBrush}"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden"/>
    <!--
        Поле без подписи экранный диктор объявляет словом «edit» и больше ничем.
        Подсказка внутри поля — то, что человек читает вместо подписи, поэтому
        она же и становится именем; заданное явно имя всё равно старше.
    -->
    <Setter Property="AutomationProperties.Name"
            Value="{Binding PlaceholderText, RelativeSource={RelativeSource Self}}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border x:Name="PART_FocusRing"
                  Margin="{DynamicResource AxFocusOutlineOuterMargin}"
                  CornerRadius="{DynamicResource AxCornerRadiusFocusOuter}"
                  BorderThickness="{DynamicResource AxFocusOutlineOuter}"
                  BorderBrush="{DynamicResource AxOutlineFocusedBrush}"
                  IsVisible="False"/>
          <Border x:Name="PART_BorderElement"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <DockPanel Margin="{TemplateBinding Padding}">
              <ContentPresenter DockPanel.Dock="Left"
                                Content="{TemplateBinding InnerLeftContent}"
                                VerticalAlignment="Center"/>
              <ContentPresenter DockPanel.Dock="Right"
                                Content="{TemplateBinding InnerRightContent}"
                                VerticalAlignment="Center"/>
              <ScrollViewer x:Name="PART_ScrollViewer"
                            HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                            VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}">
                <Panel>
                  <TextBlock x:Name="PART_Watermark"
                             Text="{TemplateBinding PlaceholderText}"
                             Foreground="{DynamicResource AxFg2Brush}"
                             VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                             TextWrapping="{TemplateBinding TextWrapping}"
                             IsVisible="{TemplateBinding Text, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                  <TextPresenter x:Name="PART_TextPresenter"
                                 Text="{TemplateBinding Text, Mode=TwoWay}"
                                 CaretIndex="{TemplateBinding CaretIndex}"
                                 SelectionStart="{TemplateBinding SelectionStart}"
                                 SelectionEnd="{TemplateBinding SelectionEnd}"
                                 TextAlignment="{TemplateBinding TextAlignment}"
                                 TextWrapping="{TemplateBinding TextWrapping}"
                                 PasswordChar="{TemplateBinding PasswordChar}"
                                 RevealPassword="{TemplateBinding RevealPassword}"
                                 SelectionBrush="{TemplateBinding SelectionBrush}"
                                 SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                 CaretBrush="{TemplateBinding CaretBrush}"
                                 VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                </Panel>
              </ScrollViewer>
            </DockPanel>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource AxFg3Brush}"/>
    </Style>
    <Style Selector="^:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource AxOutlineFocusedBrush}"/>
    </Style>
    <Style Selector="^:focus /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource AxFgDisabledBrush}"/>
    </Style>
    <Style Selector="^:disabled /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource AxInpDisabledBrush}"/>
    </Style>

    <!--
        Проверка ввода: контур горит и без фокуса — проблему видно сразу,
        а не когда в поле вернулись.
    -->
    <Style Selector="^.error /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource AxOutlineErrorBrush}"/>
    </Style>
    <Style Selector="^.error /template/ Border#PART_FocusRing">
      <Setter Property="BorderBrush" Value="{DynamicResource AxOutlineErrorBrush}"/>
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="^.warning /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource AxOutlineWarningBrush}"/>
    </Style>
    <Style Selector="^.warning /template/ Border#PART_FocusRing">
      <Setter Property="BorderBrush" Value="{DynamicResource AxOutlineWarningBrush}"/>
      <Setter Property="IsVisible" Value="True"/>
    </Style>

    <!-- Плотная зона: шапка инструментального окна и строки Инспектора. -->
    <Style Selector="^.compact">
      <Setter Property="MinHeight" Value="{DynamicResource AxControlHeightCompact}"/>
    </Style>
  </ControlTheme>

  <!--
      Поле, встроенное в другой контрол: строку поиска редактора, шапку с
      фильтром. Своей рамки, фона и кольца фокуса у него нет — всё это рисует
      то, во что оно встроено, и вторая рамка внутри первой читается как
      дефект. Кольцо особенно: оно ложится впритык к чужой рамке, и наружу
      проступают его скруглённые углы.

      Проект такого контрола не называет, но собирает из него строку поиска в
      зоне 20; это тема варианта, а не новый контрол и не новый токен.
  -->
  <ControlTheme x:Key="AxInlineTextBox" TargetType="ax:AxTextBox"
                BasedOn="{StaticResource {x:Type ax:AxTextBox}}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>

    <Style Selector="^:focus /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="^:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="^:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
  </ControlTheme>

  <!--
      Крестик очистки внутри поля: цель нажатия прежняя, 24, а плашки нет.
      Обычная иконочная кнопка кладёт под себя заливку во всю эту цель, и в
      поле высотой 28 она встаёт почти во всю высоту, вплотную к краю, — рядом
      с текстом это читается как вторая кнопка, а не как «стереть». Проект
      рисует там голый глиф, и на наведении меняется он сам, а не фон под ним.
  -->
  <ControlTheme x:Key="AxSearchClearButton" TargetType="ax:AxButton"
                BasedOn="{StaticResource {x:Type ax:AxButton}}">
    <Setter Property="Width" Value="{DynamicResource AxControlHeightCompact}"/>
    <Setter Property="Height" Value="{DynamicResource AxControlHeightCompact}"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource AxFg3Brush}"/>

    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource AxFgBrush}"/>
    </Style>
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
  </ControlTheme>

  <!-- Поле поиска: то же поле ввода со значком-лупой слева. -->
  <ControlTheme x:Key="{x:Type ax:AxSearchField}" TargetType="ax:AxSearchField"
                BasedOn="{StaticResource {x:Type ax:AxTextBox}}">
    <Setter Property="InnerLeftContent">
      <Template>
        <ax:AxIcon Margin="0,0,7,0"
                   Data="{x:Static ax:AxIcons.Search}"
                   Foreground="{DynamicResource AxFg2Brush}"/>
      </Template>
    </Setter>
    <!--
        Крестик очистки появляется от текста и вместе с текстом исчезает:
        пустое поле с крестиком предлагает стереть то, чего нет. Стирает его
        сам контрол — тема только показывает.
    -->
    <Setter Property="InnerRightContent">
      <Template>
        <ax:AxButton x:Name="PART_Clear"
                     Theme="{StaticResource AxSearchClearButton}"
                     Margin="7,0,0,0"
                     AutomationProperties.Name="Очистить поиск"
                     IsVisible="{Binding Text, RelativeSource={RelativeSource AncestorType=ax:AxSearchField},
                                         Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <ax:AxIcon Classes="small"
                     Data="{x:Static ax:AxIcons.Close}"
                     Foreground="{Binding $parent[ax:AxButton].Foreground}"/>
        </ax:AxButton>
      </Template>
    </Setter>
  </ControlTheme>

  <!-- Многострочное поле: тот же вид, но растёт по высоте. -->
  <ControlTheme x:Key="{x:Type ax:AxTextArea}" TargetType="ax:AxTextArea"
                BasedOn="{StaticResource {x:Type ax:AxTextBox}}">
    <Setter Property="MinHeight" Value="72"/>
    <!--
        Многострочное поле — единственное, где вертикальный отступ нужен:
        у однострочного текст стоит по центру и отступ ему только мешает, а
        здесь первая строка иначе прижимается к рамке. Компонента на этот
        случай в проекте нет, значение выбрано по горизонтальному.
    -->
    <Setter Property="Padding" Value="9,6"/>
    <Setter Property="AcceptsReturn" Value="True"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="VerticalContentAlignment" Value="Top"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
  </ControlTheme>

</ResourceDictionary>
