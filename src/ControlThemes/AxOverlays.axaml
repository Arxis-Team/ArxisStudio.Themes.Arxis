<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ax="https://github.com/Arxis-Team/ArxisStudio">

  <!--
      Всплывающие поверхности: тултип, подсказка «Понятно», уведомление и
      попап поиска. Все — карточки: тултип на bg2 с тенью попапа, остальные
      на bg1; тень диалога — только у модальных окон.

      Волосяная рамка у всех — AxStrokeControl: у всех всплывающих она одна и та же в
      обоих вариантах. AxStrokeSubtle остаётся разделителям внутри.
  -->

  <!--
      Тултип: тема родного ToolTip, ключом типа — как ScrollBar. Подсказка живёт
      всегда в окне попапа, и поле под тень у неё то же, что у меню.
  -->
  <ControlTheme x:Key="{x:Type ToolTip}" TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource AxToolTipFillBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AxToolTipStrokeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadius}"/>
    <Setter Property="Foreground" Value="{DynamicResource AxTextPrimaryBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource AxFontSize}"/>
    <Setter Property="Padding" Value="{DynamicResource AxTooltipPadding}"/>
    <Setter Property="MaxWidth" Value="400"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                BoxShadow="{DynamicResource AxShadowPopup}"
                Padding="{TemplateBinding Padding}"
                Margin="{DynamicResource AxPopupShadowRoom}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"/>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- Подсказка «Понятно»: заголовок, объяснение, счётчик шагов и действие. -->
  <ControlTheme x:Key="{x:Type ax:AxTeachingTip}" TargetType="ax:AxTeachingTip">
    <!--
        Не обрезаем себя: контрол с шаблоном обрезает всё по своим границам, и
        тень, которой поля вокруг карточки не хватает, кончалась бы прямоугольником.
        Поверхность эту ставит приложение — в слой окна или прямо в разметку, — и
        тени есть куда лечь; в попапе поле под неё даёт хозяин.
    -->
    <Setter Property="ClipToBounds" Value="False"/>
    <Setter Property="Background" Value="{DynamicResource AxSurfaceOverlayBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AxStrokeControlBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadiusLarge}"/>
    <!-- Ширина у подсказки своя, 250. -->
    <Setter Property="Width" Value="250"/>
    <Setter Property="Foreground" Value="{DynamicResource AxTextPrimaryBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource AxFontSize}"/>
    <Setter Property="Padding" Value="{DynamicResource AxSurfacePadding}"/>
    <Setter Property="MaxWidth" Value="250"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                BoxShadow="{DynamicResource AxShadowPopup}"
                Padding="{TemplateBinding Padding}"
                Margin="6">
          <StackPanel Spacing="{DynamicResource AxSpaceSnug}">
            <TextBlock Text="{TemplateBinding Title}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       IsVisible="{TemplateBinding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              TextBlock.Foreground="{DynamicResource AxTextSecondaryBrush}"
                              TextBlock.TextWrapping="Wrap"/>
            <DockPanel Margin="{DynamicResource AxSpaceTightAboveThickness}">
              <TextBlock Text="{TemplateBinding StepText}"
                         Foreground="{DynamicResource AxTextSecondaryBrush}"
                         FontSize="{DynamicResource AxFontSizeSmall}"
                         VerticalAlignment="Center"/>
              <ContentPresenter Content="{TemplateBinding Actions}"
                                HorizontalAlignment="Right"
                                IsVisible="{TemplateBinding Actions, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            </DockPanel>
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- Уведомление: событие с действиями-ссылками, исчезает — в отличие от баннера. -->
  <ControlTheme x:Key="{x:Type ax:AxNotificationCard}" TargetType="ax:AxNotificationCard">
    <!-- Не обрезаем себя — по той же причине, что подсказка выше. -->
    <Setter Property="ClipToBounds" Value="False"/>
    <Setter Property="Background" Value="{DynamicResource AxSurfaceOverlayBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AxStrokeControlBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadiusCard}"/>
    <Setter Property="Foreground" Value="{DynamicResource AxTextPrimaryBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource AxFontSize}"/>
    <Setter Property="Padding" Value="{DynamicResource AxSurfacePadding}"/>
    <Setter Property="Width" Value="340"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                BoxShadow="{DynamicResource AxShadowPopup}"
                Padding="{TemplateBinding Padding}"
                Margin="6">
          <DockPanel>
            <ax:AxIcon x:Name="PART_Icon"
                       DockPanel.Dock="Left"
                       Margin="0,1,6,0"
                       VerticalAlignment="Top"
                       Data="{x:Static ax:AxIcons.Info}"
                       Foreground="{DynamicResource AxAccentBrush}"/>
            <ax:AxButton DockPanel.Dock="Right"
                         x:Name="PART_Close"
                         Classes="icon"
                         VerticalAlignment="Top"
                         Margin="{DynamicResource AxSpaceLeadingThickness}">
              <ax:AxIcon Classes="small" Data="{x:Static ax:AxIcons.Close}"
                         Foreground="{Binding $parent[ax:AxButton].Foreground}"/>
            </ax:AxButton>
            <StackPanel Spacing="{DynamicResource AxSpaceTight}">
              <TextBlock Text="{TemplateBinding Title}"
                         FontWeight="SemiBold"
                         TextWrapping="Wrap"
                         IsVisible="{TemplateBinding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              <ContentPresenter Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                TextBlock.Foreground="{DynamicResource AxTextSecondaryBrush}"
                                TextBlock.TextWrapping="Wrap"/>
              <ContentPresenter Content="{TemplateBinding Actions}"
                                Margin="{DynamicResource AxSpaceTightAboveThickness}"
                                IsVisible="{TemplateBinding Actions, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            </StackPanel>
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^[Severity=Success] /template/ ax|AxIcon#PART_Icon">
      <Setter Property="Data" Value="{x:Static ax:AxIcons.Success}"/>
      <Setter Property="Foreground" Value="{DynamicResource AxSuccessBrush}"/>
    </Style>
    <Style Selector="^[Severity=Warning] /template/ ax|AxIcon#PART_Icon">
      <Setter Property="Data" Value="{x:Static ax:AxIcons.WarningTriangle}"/>
      <Setter Property="Foreground" Value="{DynamicResource AxWarningOutlineBrush}"/>
    </Style>
    <Style Selector="^[Severity=Error] /template/ ax|AxIcon#PART_Icon">
      <Setter Property="Data" Value="{x:Static ax:AxIcons.Error}"/>
      <Setter Property="Foreground" Value="{DynamicResource AxErrorBrush}"/>
    </Style>
  </ControlTheme>

  <!--
      Попап поиска: строка запроса, результаты и подвал с подсказками клавиш.

      Обрезка по скруглению стоит на внутренней рамке, а не на той, что несёт
      тень: ClipToBounds на рамке обрезает и её собственную тень, и палитра
      команд студии стояла без тени вовсе.
  -->
  <ControlTheme x:Key="{x:Type ax:AxQuickSearch}" TargetType="ax:AxQuickSearch">
    <!-- Не обрезаем себя — по той же причине, что подсказка выше. -->
    <Setter Property="ClipToBounds" Value="False"/>
    <Setter Property="Background" Value="{DynamicResource AxSurfaceOverlayBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AxStrokeControlBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadiusFloating}"/>
    <Setter Property="Foreground" Value="{DynamicResource AxTextPrimaryBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource AxFontSize}"/>
    <Setter Property="Width" Value="300"/>
    <Setter Property="MaxHeight" Value="400"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                BoxShadow="{DynamicResource AxShadowModal}"
                Margin="10">
          <Border CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
          <DockPanel>
            <Border DockPanel.Dock="Top"
                    BorderBrush="{DynamicResource AxStrokeSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="{DynamicResource AxQuickSearchFieldPadding}">
              <DockPanel>
                <ax:AxIcon DockPanel.Dock="Left"
                           Margin="{DynamicResource AxGapIconTextThickness}"
                           Data="{x:Static ax:AxIcons.Search}"
                           Foreground="{DynamicResource AxTextSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <ax:AxTextBox x:Name="PART_Search"
                              Text="{TemplateBinding Text, Mode=TwoWay}"
                              PlaceholderText="{TemplateBinding PlaceholderText}"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="0"
                              MinHeight="0"
                              VerticalContentAlignment="Center"/>
              </DockPanel>
            </Border>
            <Border DockPanel.Dock="Bottom"
                    BorderBrush="{DynamicResource AxStrokeSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="{DynamicResource AxQuickSearchHintsPadding}">
              <TextBlock Text="{TemplateBinding Hints}"
                         Foreground="{DynamicResource AxTextSecondaryBrush}"
                         FontSize="{DynamicResource AxFontSizeSmall}"/>
            </Border>
            <ax:AxListBox x:Name="PART_List"
                          Margin="{DynamicResource AxSpaceTightThickness}"
                          ItemsSource="{TemplateBinding ItemsSource}"
                          ItemTemplate="{TemplateBinding ItemTemplate}"
                          SelectedItem="{TemplateBinding SelectedItem, Mode=TwoWay}"/>
          </DockPanel>
          </Border>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>
