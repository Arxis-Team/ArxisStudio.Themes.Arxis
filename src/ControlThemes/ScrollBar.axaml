<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
      Тонкие скроллбары студии (8px, бегунок bg4, прозрачная дорожка). Тема ключом
      {x:Type ScrollBar} перекрывает базовую и применяется ко всем спискам и
      скролл-областям, включая внутренности Ax*-контролов.
  -->

  <ControlTheme x:Key="AxScrollThumb" TargetType="Thumb">
    <Setter Property="Background" Value="{DynamicResource AxBg4Brush}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent"/>

    <Style Selector="^:vertical">
      <Setter Property="Width" Value="8"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}">
            <Track Orientation="Vertical"
                   IsDirectionReversed="True"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value, Mode=TwoWay}"
                   ViewportSize="{TemplateBinding ViewportSize}">
              <Track.Thumb>
                <Thumb Theme="{StaticResource AxScrollThumb}" Width="8"/>
              </Track.Thumb>
            </Track>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="^:horizontal">
      <Setter Property="Height" Value="8"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}">
            <Track Orientation="Horizontal"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value, Mode=TwoWay}"
                   ViewportSize="{TemplateBinding ViewportSize}">
              <Track.Thumb>
                <Thumb Theme="{StaticResource AxScrollThumb}" Height="8"/>
              </Track.Thumb>
            </Track>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
  </ControlTheme>

</ResourceDictionary>
