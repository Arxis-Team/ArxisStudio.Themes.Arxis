<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
      Скроллбар студии: дорожки нет вовсе, есть один ползунок — полупрозрачная
      накладка поверх содержимого. Тема ключом {x:Type ScrollBar} перекрывает
      базовую и применяется ко всем спискам и скролл-областям, включая
      внутренности Ax*-контролов.

      Полоса всегда 12 поперёк, а меняется в ней ползунок: в покое 6 с отбивкой
      3, под курсором 8 с отбивкой 2. Так размечена карточка «Скроллбар», и так
      содержимое не дёргается: ширина полосы от состояния не зависит.
  -->

  <ControlTheme x:Key="AxScrollThumb" TargetType="Thumb">
    <Setter Property="Background" Value="{DynamicResource AxScrollThumbBrush}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadiusSmall}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"/>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent"/>

    <Style Selector="^:vertical">
      <Setter Property="Width" Value="12"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}">
            <Track Orientation="Vertical"
                   IsDirectionReversed="True"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value, Mode=TwoWay}"
                   ViewportSize="{TemplateBinding ViewportSize}">
              <Track.Thumb>
                <Thumb x:Name="PART_Thumb"
                       Theme="{StaticResource AxScrollThumb}"
                       Width="6"
                       Margin="0,0,3,0"
                       HorizontalAlignment="Right"/>
              </Track.Thumb>
            </Track>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="^:horizontal">
      <Setter Property="Height" Value="12"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}">
            <Track Orientation="Horizontal"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value, Mode=TwoWay}"
                   ViewportSize="{TemplateBinding ViewportSize}">
              <Track.Thumb>
                <Thumb x:Name="PART_Thumb"
                       Theme="{StaticResource AxScrollThumb}"
                       Height="6"
                       Margin="0,0,0,3"
                       VerticalAlignment="Bottom"/>
              </Track.Thumb>
            </Track>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <!--
        Разворот. Avalonia поднимает :expanded, когда указатель над областью
        прокрутки, — именно это показывает вторая половина карточки: ползунок
        толстеет и темнеет, пока курсор в панели, а не только на самой полосе.
        Наведение прямо на полосу учитываем тем же правилом: без автоскрытия
        :expanded не поднимается, а ползунок под курсором обязан отзываться.
    -->
    <Style Selector="^:vertical:expanded /template/ Thumb#PART_Thumb">
      <Setter Property="Width" Value="8"/>
      <Setter Property="Margin" Value="0,0,2,0"/>
    </Style>
    <Style Selector="^:vertical:pointerover /template/ Thumb#PART_Thumb">
      <Setter Property="Width" Value="8"/>
      <Setter Property="Margin" Value="0,0,2,0"/>
    </Style>
    <Style Selector="^:horizontal:expanded /template/ Thumb#PART_Thumb">
      <Setter Property="Height" Value="8"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>
    <Style Selector="^:horizontal:pointerover /template/ Thumb#PART_Thumb">
      <Setter Property="Height" Value="8"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>

    <Style Selector="^:expanded /template/ Thumb#PART_Thumb">
      <Setter Property="Background" Value="{DynamicResource AxScrollThumbHoverBrush}"/>
      <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadius}"/>
    </Style>
    <Style Selector="^:pointerover /template/ Thumb#PART_Thumb">
      <Setter Property="Background" Value="{DynamicResource AxScrollThumbHoverBrush}"/>
      <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadius}"/>
    </Style>
  </ControlTheme>

  <!--
      Область прокрутки. Своей темы у неё не было: её давал базовый слой, и без
      него ScrollViewer оставался без шаблона — содержимое рисовалось дефолтом
      ContentControl, а полос и прокрутки не было вовсе.

      Полосы лежат поверх содержимого, а не отнимают у него ширину: ползунок
      здесь — полупрозрачная накладка, и место под него не резервируется.
  -->
  <ControlTheme x:Key="{x:Type ScrollViewer}" TargetType="ScrollViewer">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
          <ScrollContentPresenter x:Name="PART_ContentPresenter"
                                  Grid.Row="0" Grid.Column="0"
                                  Grid.RowSpan="2" Grid.ColumnSpan="2"
                                  Background="{TemplateBinding Background}"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Padding="{TemplateBinding Padding}"
                                  HorizontalSnapPointsType="{TemplateBinding HorizontalSnapPointsType}"
                                  VerticalSnapPointsType="{TemplateBinding VerticalSnapPointsType}"
                                  HorizontalSnapPointsAlignment="{TemplateBinding HorizontalSnapPointsAlignment}"
                                  VerticalSnapPointsAlignment="{TemplateBinding VerticalSnapPointsAlignment}"/>
          <ScrollBar x:Name="PART_VerticalScrollBar"
                     Grid.Row="0" Grid.Column="1"
                     Orientation="Vertical"/>
          <ScrollBar x:Name="PART_HorizontalScrollBar"
                     Grid.Row="1" Grid.Column="0"
                     Orientation="Horizontal"/>
          <!-- Уголок между полосами: пустой, но части с этим именем ждёт сам ScrollViewer. -->
          <Panel x:Name="PART_ScrollBarsSeparator"
                 Grid.Row="1" Grid.Column="1"
                 Background="Transparent"/>
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>
