<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ax="https://github.com/Arxis-Team/ArxisStudio">

  <!-- Сегментный переключатель: контейнер bg1 с рамкой, активный сегмент — акцент. -->
  <ControlTheme x:Key="{x:Type ax:AxSegmentedControl}" TargetType="ax:AxSegmentedControl">
    <Setter Property="Background" Value="{DynamicResource AxInpBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AxBrd2Brush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadius}"/>
    <Setter Property="Padding" Value="2"/>
    <!--
        Высота задана, а не набрана содержимым: раздел 5 «Основ» перечисляет
        сегменты среди того, что стоит на AxControlHeight, рядом с кнопкой,
        полем и комбобоксом. Набранная высота давала 26, и сегменты стояли
        ниже соседей в одной строке.
    -->
    <Setter Property="Height" Value="{DynamicResource AxControlHeight}"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal"/>
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ItemsPresenter x:Name="PART_ItemsPresenter"
                          ItemsPanel="{TemplateBinding ItemsPanel}"/>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- Сегмент: неактивный — fg2, активный — акцентная пилюля. -->
  <ControlTheme x:Key="{x:Type ax:AxSegmentItem}" TargetType="ax:AxSegmentItem">
    <!--
        Отступ горизонтальный: по вертикали сегмент стоит по центру своей
        половины, как и всё остальное на фиксированной высоте. Радиус —
        контрольный 4, а не бейджевый 3: сегмент это контрол.
    -->
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadius}"/>
    <Setter Property="FontSize" Value="{DynamicResource AxFontSizeSmall}"/>
    <Setter Property="Foreground" Value="{DynamicResource AxFg2Brush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter x:Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          Padding="{TemplateBinding Padding}"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"/>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource AxFgBrush}"/>
    </Style>
    <!-- Активный сегмент несёт текст на заливке — AxAccStrong, не AxAcc. -->
    <Style Selector="^:selected">
      <Setter Property="Background" Value="{DynamicResource AxAccStrongBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AxOnAccBrush}"/>
      <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <!--
        Выключенная строка (раздел 10 спецификации): текст на AxFgDisabled.
        Стиль стоит последним намеренно — выделение и наведение объявлены выше,
        и без этого выключенная выбранная строка выглядела бы обычной.
    -->
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource AxFgDisabledBrush}"/>
    </Style>

  </ControlTheme>

</ResourceDictionary>
