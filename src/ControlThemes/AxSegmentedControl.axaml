<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ax="https://github.com/Arxis-Team/ArxisStudio">

  <!-- Сегментный переключатель: контейнер bg1 с рамкой, активный сегмент — акцент. -->
  <ControlTheme x:Key="{x:Type ax:AxSegmentedControl}" TargetType="ax:AxSegmentedControl">
    <Setter Property="Background" Value="{DynamicResource AxSurfaceBaseBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AxStrokeControlBrush}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource AxHairlineThickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadius}"/>
    <Setter Property="Padding" Value="{DynamicResource AxSpaceHairThickness}"/>
    <!--
        Высота задана, а не набрана содержимым: сегменты стоят на
        AxControlHeight рядом с кнопкой, полем и комбобоксом. Набранная высота давала 26, и сегменты стояли
        ниже соседей в одной строке.

        Задана наименьшей: подпись сегмента растёт вместе с кеглем темы, и
        прибитая высота её срезала бы.
    -->
    <Setter Property="MinHeight" Value="{DynamicResource AxControlHeight}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal"/>
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ItemsPresenter x:Name="PART_ItemsPresenter"
                          ItemsPanel="{TemplateBinding ItemsPanel}"/>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- Сегмент: неактивный — fg2, активный — акцентная пилюля. -->
  <ControlTheme x:Key="{x:Type ax:AxSegmentItem}" TargetType="ax:AxSegmentItem">
    <!--
        Отступ горизонтальный: по вертикали сегмент стоит по центру своей
        половины, как и всё остальное на фиксированной высоте. Радиус —
        контрольный 4, а не бейджевый 3: сегмент это контрол.
    -->
    <Setter Property="Padding" Value="{DynamicResource AxButtonPadding}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AxCornerRadius}"/>
    <Setter Property="FontSize" Value="{DynamicResource AxFontSizeSmall}"/>
    <Setter Property="Foreground" Value="{DynamicResource AxTextSecondaryBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
            <!--
                Кольцо строки лежит внутри, а не снаружи, и это не мелочь. У
                кнопки оно вынесено наружу отрицательным полем — там вокруг
                есть место. Строка занимает всю ширину списка, и вынесенное
                кольцо срезал бы сам список: остались бы две вертикальные
                чёрточки по бокам. Толщина поэтому своя.

                Стоит последним, значит поверх заливки выделения: иначе
                выбранная строка в фокусе прятала бы кольцо под собой.
            -->
            <Border x:Name="PART_FocusRing"
                    BorderThickness="{DynamicResource AxFocusOutlineInset}"
                    BorderBrush="{DynamicResource AxFocusRingBrush}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    IsVisible="False"/>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource AxTextPrimaryBrush}"/>
    </Style>
    <!-- Активный сегмент несёт текст на заливке — AxAccentFill, не AxAccent. -->
    <Style Selector="^:selected">
      <Setter Property="Background" Value="{DynamicResource AxAccentFillBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AxTextOnAccentBrush}"/>
      <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <!--
        Выключенная строка: текст на AxTextDisabled.
        Стиль стоит последним намеренно — выделение и наведение объявлены выше,
        и без этого выключенная выбранная строка выглядела бы обычной.
    -->
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource AxTextDisabledBrush}"/>
    </Style>

  </ControlTheme>

</ResourceDictionary>
