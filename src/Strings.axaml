<!--
    Тексты, которые шаблоны темы отдают средствам доступности: имя крестика в поле
    поиска, в баннере, в диалоге. Экранный диктор читает иконочную кнопку без имени
    словом «кнопка», и только.

    Значения здесь — запасные, на языке, на котором написана студия. Тема не знает,
    какой язык выбрал человек, поэтому прямо в шаблоне текста нет: шаблон берёт его
    ресурсом, а приложение кладёт перевод тем же ключом в свои ресурсы — они сильнее
    ресурсов темы.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <x:String x:Key="AxTextSearchClear">Clear search</x:String>
  <x:String x:Key="AxTextMessageClose">Close message</x:String>
  <x:String x:Key="AxTextDialogClose">Close</x:String>
  <x:String x:Key="AxTextTabOverflow">More tabs</x:String>
  <x:String x:Key="AxTextBreadcrumbOverflow">Earlier path segments</x:String>
  <x:String x:Key="AxTextChipRemove">Remove</x:String>
  <x:String x:Key="AxTextVectorLink">Same value for all</x:String>
  <x:String x:Key="AxTextMixedValues">Different values</x:String>
  <x:String x:Key="AxTextColorChoose">Choose color</x:String>
  <x:String x:Key="AxTextColorSpectrum">Saturation and brightness</x:String>
  <x:String x:Key="AxTextColorHue">Hue</x:String>
  <x:String x:Key="AxTextColorAlpha">Opacity</x:String>
  <x:String x:Key="AxTextColorCode">Hexadecimal</x:String>
  <x:String x:Key="AxTextColorNone">No color</x:String>
  <x:String x:Key="AxTextColorEyedropper">Pick a color from the screen</x:String>
  <x:String x:Key="AxTextEyedropperHint">Click a pixel to take its color. Esc cancels.</x:String>
  <x:String x:Key="AxTextColorWindow">Color</x:String>
  <x:String x:Key="AxTextColorOriginal">Original color: click to bring it back</x:String>
  <x:String x:Key="AxTextColorMode">Color mode</x:String>
  <x:String x:Key="AxTextColorModeRgb255">RGB 0–255</x:String>
  <x:String x:Key="AxTextColorModeRgb1">RGB 0–1.0</x:String>
  <x:String x:Key="AxTextColorModeHsv">HSV</x:String>

</ResourceDictionary>
