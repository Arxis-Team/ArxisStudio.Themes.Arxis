<Project>

    <!--
        Общие настройки всех проектов решения. TFM здесь намеренно нет: у библиотеки
        net8.0 (минимальный, поддерживаемый Avalonia 12), у тестов и демо net10.0.
    -->
    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <!--
        Сборка проходит с 0 предупреждений, и это проверяет компилятор, а не
        внимание автора. Аудит NuGet выведен из-под правила: NU19xx появляются от
        публикации новой CVE, а не от правки кода.
    -->
    <PropertyGroup>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    </PropertyGroup>

    <!--
        Упаковывается только библиотека, и она включает это у себя сама.
    -->
    <PropertyGroup>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

</Project>
