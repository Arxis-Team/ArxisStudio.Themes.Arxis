<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Headless.XUnit"/>
        <PackageReference Include="Avalonia.Themes.Fluent"/>
        <PackageReference Include="Avalonia.Fonts.Inter"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="xunit.runner.visualstudio"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/ArxisStudio.Themes.Arxis.csproj"/>
    </ItemGroup>


    <!--
        Значения дизайн-проекта едут в сборке тестов: сверка должна работать
        и там, где самого дизайн-проекта рядом нет. Листа иконок здесь нет —
        форму путей сверяет их собственный репозиторий, ArxisStudio.Icons.
    -->
    <ItemGroup>
        <EmbeddedResource Include="design-tokens.json"/>
    </ItemGroup>

    <!--
        Разметка темы едет в сборке тестов текстом: храповик LiteralSpacingTests
        считает отступы, написанные числом, а скомпилированная разметка чисел
        уже не показывает. Шаблон берётся звёздочкой, чтобы новый файл темы
        попадал под счёт сам, а не тогда, когда о нём вспомнят.
    -->
    <ItemGroup>
        <EmbeddedResource Include="../../src/**/*.axaml" LogicalName="axaml/%(RecursiveDir)%(Filename)%(Extension)"/>
    </ItemGroup>

</Project>
